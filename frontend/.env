# Variables de entorno para el frontend
# IMPORTANTE: Este archivo es una plantilla. Los valores reales están en:
#   - .env.development (para desarrollo local - npm run dev)
#   - .env.production (para producción - Vercel)
# 
# Astro cargará automáticamente el archivo correcto según el modo

# URL del backend API
# Para desarrollo local: http://localhost:3000/api
# Para producción: https://egresados-ies.vercel.app/api
PUBLIC_API_URL=http://localhost:3000/api

# Configuración del sitio
PUBLIC_SITE_NAME="Sistema de Gestión de Egresados IES"
PUBLIC_SITE_DESCRIPTION="Plataforma para gestión y seguimiento de egresados del Instituto de Educación Superior"

# Configuración de ImgBB
PUBLIC_IMGBB_API_KEY=a0d050547832d68853fc714d2b5b41ba

# URLs externas (opcional)
PUBLIC_INSTITUTION_WEBSITE=https://ies.edu.ar
PUBLIC_SUPPORT_EMAIL=soporte@ies.edu.ar

# Configuración de desarrollo
PUBLIC_DEBUG_MODE=false
PUBLIC_SHOW_API_ERRORS=true

# Configuración de archivos
PUBLIC_MAX_FILE_SIZE=10485760
PUBLIC_ALLOWED_FILE_EXTENSIONS=pdf,doc,docx
