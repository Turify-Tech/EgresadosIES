---
import { useState } from 'react';
import { apiLogin } from '../utils/api.js';
---

<form id="acceso-form" style="max-width:320px;margin:auto;padding:2rem;display:flex;flex-direction:column;gap:1rem" on:submit={handleSubmit}>
  <label>
    DNI
    <input type="text" name="dni" required pattern="\d{7,8}" placeholder="Ej: 12345678" />
  </label>
    <input type="password" name="password" required />
  </label>
  <button type="submit" disabled={loading}>Ingresar</button>
  {loading && <span>Validando...</span>}
  {error && <span style="color:red">{error}</span>}
</form>

<script>
const [loading, setLoading] = useState(false);
const [error, setError] = useState("");

async function handleSubmit(e) {
  e.preventDefault();
  setError("");
  setLoading(true);
  const dni = e.target.dni.value.trim();
  const password = e.target.password.value;
  try {
    const res = await apiLogin(dni, password);
    if (res.token) {
      localStorage.setItem('token', res.token);
      if (res.tipoUsuario === 'administrador') {
        window.location.href = '/admin';
      } else if (res.isNewUser) {
        window.location.href = '/completar-perfil';
      } else {
        window.location.href = '/dashboard';
      }
    } else {
      setError(res.message || 'Error desconocido');
    }
  } catch (err) {
    setError(err.message || 'Error de conexión');
  }
  setLoading(false);
}
</script>
