---
// Componente modal para comentarios
import "../styles/comentarios-modal.css";
import "../styles/mentions.css";
---

<div id="comentarios-modal" class="modal-overlay" style="display: none;">
    <div class="modal-container">
        <div class="modal-header">
            <div class="modal-header-background">
                <img src="/images/Fondo Azul card.jpg" alt="Fondo" />
            </div>
            <button class="close-modal" id="close-modal-btn">&times;</button>
        </div>
        
        <div class="modal-body">
            <!-- Lista de comentarios -->
            <div id="comentarios-list" class="comentarios-list">
                <p class="no-comentarios">No hay comentarios en esta publicación</p>
            </div>

            <!-- Formulario para agregar comentario -->
            <form id="comentario-form" class="comentario-form">
                <textarea 
                    id="comentario-input" 
                    placeholder="Agregar comentario... (usa @ para mencionar)" 
                    rows="2"
                ></textarea>
                <button type="submit" class="btn-publicar">Publicar</button>
            </form>
        </div>
    </div>
</div>

<!-- Template para formulario de respuesta (se clonará dinámicamente) -->
<template id="respuesta-form-template">
    <div class="respuesta-form-container">
        <form class="respuesta-form">
            <textarea 
                class="respuesta-input"
                placeholder="Escribe tu respuesta... (usa @ para mencionar)" 
                rows="2"
            ></textarea>
            <div class="respuesta-form-actions">
                <button type="submit" class="btn-responder-enviar">Responder</button>
                <button type="button" class="btn-responder-cancelar">Cancelar</button>
            </div>
        </form>
    </div>
</template>
