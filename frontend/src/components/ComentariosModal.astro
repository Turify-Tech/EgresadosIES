---
// Componente modal para comentarios
import "../styles/comentarios-modal.css";
---

<div id="comentarios-modal" class="modal-overlay" style="display: none;">
    <div class="modal-container">
        <div class="modal-header">
            <div class="modal-header-background">
                <img src="/images/Fondo Azul card.jpg" alt="Fondo" />
            </div>
            <button class="close-modal" id="close-modal-btn">&times;</button>
        </div>
        
        <div class="modal-body">
            <!-- Lista de comentarios -->
            <div id="comentarios-list" class="comentarios-list">
                <p class="no-comentarios">No hay comentarios en esta publicación</p>
            </div>

            <!-- Paginación -->
            <div id="comentarios-pagination" class="comentarios-pagination" style="display: none;">
                <button id="load-more-comments-btn" class="btn-load-more">Cargar más comentarios</button>
            </div>

            <!-- Formulario para agregar comentario -->
            <form id="comentario-form" class="comentario-form">
                <input 
                    id="comentario-input" 
                    type="text"
                    placeholder="Agregar comentario..." 
                />
                <button type="submit" class="btn-publicar">Publicar</button>
            </form>
        </div>
    </div>
</div>
