---
/**
 * Componente TablaDnis - Lista paginada y filtrable de DNIs válidos
 */
---

<div class="tabla-dnis-card">
    <div class="card-header">
        <h3>
            <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                ></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            DNIs Válidos Registrados
        </h3>
    </div>

    <div class="tabla-content">
        <!-- Filtros -->
        <div class="filtros-section">
            <div class="filtro-grupo">
                <input
                    type="text"
                    id="buscar-dni"
                    placeholder="Buscar por DNI..."
                    class="input-buscar"
                />
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="icon-buscar"
                >
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
            </div>

            <select id="filtro-carrera" class="select-filtro">
                <option value="">Todas las carreras</option>
            </select>
        </div>

        <!-- Tabla -->
        <div class="tabla-wrapper">
            <table class="tabla-dnis">
                <thead>
                    <tr>
                        <th>DNI</th>
                        <th>Carrera</th>
                        <th class="th-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tabla-body">
                    <tr>
                        <td colspan="3" class="loading-row">
                            <div class="loading-spinner"></div>
                            Cargando datos...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <div id="paginacion-container" class="paginacion" style="display: none;">
            <div class="paginacion-info">
                <span id="paginacion-info-texto"></span>
            </div>
            <div class="paginacion-controles">
                <button
                    id="btn-primera"
                    class="btn-paginacion"
                    aria-label="Primera página"
                >
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <polyline points="11 17 6 12 11 7"></polyline>
                        <polyline points="18 17 13 12 18 7"></polyline>
                    </svg>
                </button>
                <button
                    id="btn-anterior"
                    class="btn-paginacion"
                    aria-label="Página anterior"
                >
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
                <span id="pagina-actual" class="pagina-actual">1</span>
                <button
                    id="btn-siguiente"
                    class="btn-paginacion"
                    aria-label="Página siguiente"
                >
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>
                <button
                    id="btn-ultima"
                    class="btn-paginacion"
                    aria-label="Última página"
                >
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <polyline points="13 17 18 12 13 7"></polyline>
                        <polyline points="6 17 11 12 6 7"></polyline>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de edición -->
<div id="modal-editar" class="modal" style="display: none;">
    <div class="modal-overlay"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h3>Editar DNI</h3>
            <button id="btn-cerrar-modal" class="btn-close-modal">
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <form id="form-editar-dni">
            <input type="hidden" id="edit-dni-original" />
            <div class="form-group">
                <label for="edit-dni">DNI</label>
                <input
                    type="text"
                    id="edit-dni"
                    disabled
                    class="input-disabled"
                />
            </div>
            <div class="form-group">
                <label for="edit-carrera">Carrera *</label>
                <select id="edit-carrera" required>
                    <option value="">Seleccionar carrera...</option>
                </select>
            </div>
            <div class="modal-actions">
                <button type="button" id="btn-cancelar" class="btn-secondary">
                    Cancelar
                </button>
                <button type="submit" class="btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Contenedor de notificaciones toast -->
<div id="toast-container" class="toast-container"></div>

<!-- Modal de confirmación personalizado -->
<div id="confirm-modal" class="confirm-modal-overlay" style="display: none;">
    <div class="confirm-modal">
        <div class="confirm-modal-header">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
        </div>
        <div class="confirm-modal-body">
            <h3 id="confirm-title">Confirmar acción</h3>
            <p id="confirm-message">¿Estás seguro de realizar esta acción?</p>
        </div>
        <div class="confirm-modal-actions">
            <button id="confirm-cancel" class="btn-secondary">Cancelar</button>
            <button id="confirm-ok" class="btn-danger">Confirmar</button>
        </div>
    </div>
</div>

<script>
    const API_URL = "http://localhost:3000/api";

    interface PaginationData {
        page: number;
        limit: number;
        total: number;
        totalPages: number;
        hasNext: boolean;
        hasPrev: boolean;
    }

    // Sistema de notificaciones toast
    function mostrarToast(mensaje: string, tipo: 'success' | 'error' | 'warning' | 'info' = 'info') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `toast toast-${tipo}`;
        
        const iconos = {
            success: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>',
            error: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>',
            warning: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>',
            info: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>'
        };

        toast.innerHTML = `
            <div class="toast-icon">${iconos[tipo]}</div>
            <div class="toast-message">${mensaje}</div>
            <button class="toast-close" onclick="this.parentElement.remove()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        `;

        container.appendChild(toast);

        // Animación de entrada
        setTimeout(() => toast.classList.add('show'), 10);

        // Auto-remover después de 5 segundos
        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => toast.remove(), 300);
        }, 5000);
    }

    // Sistema de confirmación personalizado
    function mostrarConfirmacion(titulo: string, mensaje: string): Promise<boolean> {
        return new Promise((resolve) => {
            const modal = document.getElementById('confirm-modal');
            const titleEl = document.getElementById('confirm-title');
            const messageEl = document.getElementById('confirm-message');
            const cancelBtn = document.getElementById('confirm-cancel');
            const okBtn = document.getElementById('confirm-ok');

            if (!modal || !titleEl || !messageEl || !cancelBtn || !okBtn) {
                resolve(false);
                return;
            }

            titleEl.textContent = titulo;
            messageEl.textContent = mensaje;
            modal.style.display = 'flex';

            const handleCancel = () => {
                modal.style.display = 'none';
                cleanup();
                resolve(false);
            };

            const handleOk = () => {
                modal.style.display = 'none';
                cleanup();
                resolve(true);
            };

            const cleanup = () => {
                cancelBtn.removeEventListener('click', handleCancel);
                okBtn.removeEventListener('click', handleOk);
            };

            cancelBtn.addEventListener('click', handleCancel);
            okBtn.addEventListener('click', handleOk);

            // Cerrar con ESC
            const handleEsc = (e: KeyboardEvent) => {
                if (e.key === 'Escape') {
                    handleCancel();
                    document.removeEventListener('keydown', handleEsc);
                }
            };
            document.addEventListener('keydown', handleEsc);
        });
    }

    // Exponer funciones globalmente para uso en otros componentes
    (window as any).mostrarToast = mostrarToast;
    (window as any).mostrarConfirmacion = mostrarConfirmacion;

    let currentPage = 1;
    let currentSearch = "";
    let currentCarrera = "";
    let carreras: string[] = [];

    async function cargarCarreras() {
        try {
            const token = localStorage.getItem("auth_token");
            const response = await fetch(`${API_URL}/carreras`, {
                headers: { Authorization: `Bearer ${token}` },
            });

            if (response.ok) {
                const data = await response.json();
                if (data.success && Array.isArray(data.data)) {
                    carreras = data.data.map((c: any) => c.nombre);

                    // Poblar select de filtro
                    const filtroCarrera = document.getElementById(
                        "filtro-carrera"
                    ) as HTMLSelectElement;
                    const editCarrera = document.getElementById(
                        "edit-carrera"
                    ) as HTMLSelectElement;

                    carreras.forEach((carrera) => {
                        if (filtroCarrera) {
                            const option = document.createElement("option");
                            option.value = carrera;
                            option.textContent = carrera;
                            filtroCarrera.appendChild(option);
                        }

                        if (editCarrera) {
                            const option = document.createElement("option");
                            option.value = carrera;
                            option.textContent = carrera;
                            editCarrera.appendChild(option);
                        }
                    });
                }
            }
        } catch (error) {
            console.error("Error cargando carreras:", error);
        }
    }

    async function cargarDnis(page = 1) {
        const tbody = document.getElementById("tabla-body");
        if (!tbody) return;

        // Mostrar loading
        tbody.innerHTML = `
            <tr>
                <td colspan="3" class="loading-row">
                    <div class="loading-spinner"></div>
                    Cargando datos...
                </td>
            </tr>
        `;

        try {
            const token = localStorage.getItem("auth_token");
            const params = new URLSearchParams({
                page: page.toString(),
                limit: "10",
            });

            if (currentSearch) params.append("search", currentSearch);
            if (currentCarrera) params.append("carrera", currentCarrera);

            const response = await fetch(
                `${API_URL}/admin/dnis?${params}`,
                {
                    headers: { Authorization: `Bearer ${token}` },
                }
            );

            if (response.ok) {
                const result = await response.json();

                if (result.success && result.data) {
                    const { dnis, pagination } = result.data;

                    if (dnis.length === 0) {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="3" class="empty-row">
                                    No se encontraron DNIs
                                </td>
                            </tr>
                        `;
                    } else {
                        tbody.innerHTML = dnis
                            .map(
                                (dni: any) => `
                            <tr>
                                <td><strong>${dni.dni}</strong></td>
                                <td>${dni.carrera}</td>
                                <td>
                                    <div class="acciones-cell">
                                        <button class="btn-accion btn-editar" onclick="editarDni('${dni.dni}', '${dni.carrera}')" title="Editar">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        </button>
                                        <button class="btn-accion btn-eliminar" onclick="eliminarDni('${dni.dni}')" title="Eliminar">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `
                            )
                            .join("");
                    }

                    actualizarPaginacion(pagination);
                }
            } else {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="3" class="empty-row">
                            Error cargando datos
                        </td>
                    </tr>
                `;
            }
        } catch (error) {
            console.error("Error:", error);
            tbody.innerHTML = `
                <tr>
                    <td colspan="3" class="empty-row">
                        Error de conexión
                    </td>
                </tr>
            `;
        }
    }

    function actualizarPaginacion(pagination: PaginationData) {
        const container = document.getElementById("paginacion-container");
        const infoTexto = document.getElementById("paginacion-info-texto");
        const paginaActual = document.getElementById("pagina-actual");
        const btnPrimera = document.getElementById(
            "btn-primera"
        ) as HTMLButtonElement;
        const btnAnterior = document.getElementById(
            "btn-anterior"
        ) as HTMLButtonElement;
        const btnSiguiente = document.getElementById(
            "btn-siguiente"
        ) as HTMLButtonElement;
        const btnUltima = document.getElementById(
            "btn-ultima"
        ) as HTMLButtonElement;

        if (!container) return;

        container.style.display = "flex";
        currentPage = pagination.page;

        if (infoTexto) {
            const inicio = (pagination.page - 1) * pagination.limit + 1;
            const fin = Math.min(
                pagination.page * pagination.limit,
                pagination.total
            );
            infoTexto.textContent = `Mostrando ${inicio}-${fin} de ${pagination.total}`;
        }

        if (paginaActual) {
            paginaActual.textContent = `${pagination.page} / ${pagination.totalPages}`;
        }

        if (btnPrimera) btnPrimera.disabled = !pagination.hasPrev;
        if (btnAnterior) btnAnterior.disabled = !pagination.hasPrev;
        if (btnSiguiente) btnSiguiente.disabled = !pagination.hasNext;
        if (btnUltima) btnUltima.disabled = !pagination.hasNext;
    }

    // Funciones globales para botones
    (window as any).editarDni = function (dni: string, carrera: string) {
        const modal = document.getElementById("modal-editar");
        const editDni = document.getElementById("edit-dni") as HTMLInputElement;
        const editDniOriginal = document.getElementById(
            "edit-dni-original"
        ) as HTMLInputElement;
        const editCarrera = document.getElementById(
            "edit-carrera"
        ) as HTMLSelectElement;

        if (editDni) editDni.value = dni;
        if (editDniOriginal) editDniOriginal.value = dni;
        if (editCarrera) editCarrera.value = carrera;
        if (modal) modal.style.display = "flex";
    };

    (window as any).eliminarDni = async function (dni: string) {
        const confirmado = await mostrarConfirmacion(
            'Eliminar DNI',
            `¿Estás seguro de eliminar el DNI ${dni}? Si existe un usuario registrado con este DNI, su cuenta también será eliminada. Esta acción no se puede deshacer.`
        );
        
        if (!confirmado) return;

        try {
            const token = localStorage.getItem("auth_token");
            const response = await fetch(`${API_URL}/admin/dnis/${dni}`, {
                method: "DELETE",
                headers: { Authorization: `Bearer ${token}` },
            });

            const data = await response.json();

            if (response.ok && data.success) {
                mostrarToast(data.message || "DNI eliminado exitosamente", "success");
                cargarDnis(currentPage);
                window.dispatchEvent(new Event("dni-agregado"));
            } else {
                mostrarToast(data.message || "Error eliminando DNI", "error");
            }
        } catch (error) {
            console.error("Error:", error);
            mostrarToast("Error de conexión", "error");
        }
    };

    async function guardarEdicion(e: Event) {
        e.preventDefault();

        const form = e.target as HTMLFormElement;
        const dni = (
            document.getElementById("edit-dni-original") as HTMLInputElement
        ).value;
        const carrera = (
            document.getElementById("edit-carrera") as HTMLSelectElement
        ).value;

        if (!carrera) {
            mostrarToast("Por favor selecciona una carrera", "warning");
            return;
        }

        try {
            const token = localStorage.getItem("auth_token");
            const response = await fetch(`${API_URL}/admin/dnis/${dni}`, {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({ carrera }),
            });

            const data = await response.json();

            if (response.ok && data.success) {
                mostrarToast("DNI actualizado exitosamente", "success");
                cerrarModal();
                cargarDnis(currentPage);
            } else {
                mostrarToast(data.message || "Error actualizando DNI", "error");
            }
        } catch (error) {
            console.error("Error:", error);
            mostrarToast("Error de conexión", "error");
        }
    }

    function cerrarModal() {
        const modal = document.getElementById("modal-editar");
        if (modal) modal.style.display = "none";
    }

    // Event listeners
    document.addEventListener("DOMContentLoaded", () => {
        cargarCarreras();
        cargarDnis();

        // Búsqueda
        const buscarInput = document.getElementById("buscar-dni");
        buscarInput?.addEventListener("input", (e) => {
            const target = e.target as HTMLInputElement;
            currentSearch = target.value;
            currentPage = 1;
            setTimeout(() => cargarDnis(1), 300);
        });

        // Filtro carrera
        const filtroCarrera = document.getElementById("filtro-carrera");
        filtroCarrera?.addEventListener("change", (e) => {
            const target = e.target as HTMLSelectElement;
            currentCarrera = target.value;
            currentPage = 1;
            cargarDnis(1);
        });

        // Paginación
        document
            .getElementById("btn-primera")
            ?.addEventListener("click", () => cargarDnis(1));
        document
            .getElementById("btn-anterior")
            ?.addEventListener("click", () =>
                cargarDnis(Math.max(1, currentPage - 1))
            );
        document
            .getElementById("btn-siguiente")
            ?.addEventListener("click", () => cargarDnis(currentPage + 1));
        document
            .getElementById("btn-ultima")
            ?.addEventListener("click", () => {
                // Calculamos última página desde la paginación actual
                const paginaActualText = document.getElementById("pagina-actual")?.textContent || "";
                const totalPages = parseInt(paginaActualText.split("/")[1]?.trim() || "1");
                cargarDnis(totalPages);
            });

        // Modal
        document
            .getElementById("btn-cerrar-modal")
            ?.addEventListener("click", cerrarModal);
        document
            .getElementById("btn-cancelar")
            ?.addEventListener("click", cerrarModal);
        document
            .getElementById("form-editar-dni")
            ?.addEventListener("submit", guardarEdicion);

        // Cerrar modal al hacer click en overlay
        document
            .querySelector(".modal-overlay")
            ?.addEventListener("click", cerrarModal);

        // Escuchar evento de DNI agregado
        window.addEventListener("dni-agregado", () => {
            cargarDnis(currentPage);
        });
    });
</script>
