---
/**
 * Componente BarraBusqueda - Barra de búsqueda con autocompletado
 * Props:
 * - placeholder: string - Texto placeholder
 * - value: string - Valor inicial
 * - onSearch: función - Callback para ejecutar búsqueda
 * - enableAutocomplete: boolean - Habilitar autocompletado
 */

export interface Props {
    placeholder?: string;
    value?: string;
    id?: string;
    enableAutocomplete?: boolean;
}

const { 
    placeholder = "Buscar por nombre, profesión, empresa...", 
    value = "",
    id = "search-input",
    enableAutocomplete = true
} = Astro.props;
---

<div class="search-container">
    <div class="search-box">
        <div class="search-input-wrapper">
            <input
                type="text"
                id={id}
                placeholder={placeholder}
                value={value}
                class="search-input"
                autocomplete="off"
                spellcheck="false"
            />
            <button
                type="button"
                id={`${id}-button`}
                class="search-button"
                title="Buscar">
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
            </button>
            <button
                type="button"
                id={`${id}-clear`}
                class="clear-button"
                title="Limpiar"
                style="display: none;">
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Lista de autocompletado -->
        {enableAutocomplete && (
            <div id={`${id}-autocomplete`} class="autocomplete-list" style="display: none;">
                <!-- Las sugerencias se cargan dinámicamente -->
            </div>
        )}
    </div>
</div>

<style>
    .search-container {
        position: relative;
        width: 100%;
        max-width: 400px;
    }

    .search-box {
        position: relative;
        width: 100%;
    }

    .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-input {
        width: 100%;
        padding: 0.875rem 4rem 0.875rem 1rem;
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.1);
        color: white;
        font-size: 1rem;
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .search-input::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }

    .search-input:focus {
        outline: none;
        border-color: rgba(255, 255, 255, 0.5);
        background: rgba(255, 255, 255, 0.15);
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
    }

    .search-button,
    .clear-button {
        position: absolute;
        right: 0.75rem;
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.7);
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 6px;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .clear-button {
        right: 2.75rem;
    }

    .search-button:hover,
    .clear-button:hover {
        color: white;
        background: rgba(255, 255, 255, 0.1);
    }

    .search-button:active,
    .clear-button:active {
        transform: scale(0.95);
    }

    /* Autocompletado */
    .autocomplete-list {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        z-index: 1000;
        max-height: 300px;
        overflow-y: auto;
        margin-top: 0.25rem;
        border: 1px solid rgba(0, 0, 0, 0.1);
    }

    .autocomplete-item {
        padding: 0.75rem 1rem;
        cursor: pointer;
        transition: background-color 0.2s ease;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .autocomplete-item:last-child {
        border-bottom: none;
    }

    .autocomplete-item:hover,
    .autocomplete-item.highlighted {
        background-color: rgba(103, 126, 234, 0.1);
    }

    .autocomplete-item-text {
        color: #374151;
        font-weight: 500;
    }

    .autocomplete-item-type {
        color: #6B7280;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .autocomplete-no-results {
        padding: 1rem;
        text-align: center;
        color: #6B7280;
        font-style: italic;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .search-container {
            max-width: 100%;
        }

        .search-input {
            padding: 0.75rem 3.5rem 0.75rem 0.875rem;
            font-size: 0.9rem;
        }

        .search-button,
        .clear-button {
            padding: 0.375rem;
        }

        .clear-button {
            right: 2.5rem;
        }
    }
</style>