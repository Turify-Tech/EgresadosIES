---
export interface Props { comments?: any[] }
const { comments = [] } = Astro.props;
---

<div class="comentarios-list">
  {comments.length === 0 ? (
    <p class="no-comments">Sé el primero en comentar.</p>
  ) : (
    comments.map(c => (
      <div class="comentario">
        <img class="avatar" src={c.autor?.avatar || '/default-avatar.svg'} alt="avatar" />
        <div class="body">
          <strong>{c.autor?.nombre || 'Usuario'}</strong>
          <p class="contenido">{c.contenido}</p>
          <time class="fecha">{c.fechaCreacion ? new Date(c.fechaCreacion).toLocaleString() : ''}</time>
        </div>
      </div>
    ))
  )}

  <style>
    .comentarios-list{display:flex;flex-direction:column;gap:0.75rem}
    .comentario{display:flex;gap:0.75rem;align-items:flex-start}
    .comentario .avatar{width:36px;height:36px;min-width:36px;border-radius:50%;object-fit:cover;background:#e5e7eb}
    .comentario .body{background:#f9fafb;padding:0.75rem;border-radius:8px;flex:1;border:1px solid #f0f0f0}
    .comentario strong{color:#000;font-size:0.9rem;font-weight:600}
    .contenido{margin:0.5rem 0 0 0;color:#333;font-size:0.9rem}
    .fecha{font-size:0.75rem;color:#999;margin-top:0.25rem}
    .no-comments{color:#666;font-size:0.9rem}
  </style>
</div>
