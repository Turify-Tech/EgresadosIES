---
export interface Props { comments?: any[] }
const { comments = [] } = Astro.props;
---

<div class="comentarios-list">
  {comments.length === 0 ? (
    <p class="no-comments">Sé el primero en comentar.</p>
  ) : (
    comments.map(c => (
      <div class="comentario">
        <img class="avatar" src={c.autor?.avatar || '/default-avatar.svg'} alt="avatar" />
        <div class="body">
          <strong>{c.autor?.nombre || 'Usuario'}</strong>
          <p class="contenido">{c.contenido}</p>
          <time class="fecha">{c.fechaCreacion ? new Date(c.fechaCreacion).toLocaleString() : ''}</time>
        </div>
      </div>
    ))
  )}

  <style>
    .comentarios-list{display:flex;flex-direction:column;gap:0.5rem}
    .comentario{display:flex;gap:0.5rem;align-items:flex-start}
    .comentario .avatar{width:32px;height:32px;border-radius:50%;object-fit:cover}
    .comentario .body{background:#f8fafc;padding:0.5rem;border-radius:8px;flex:1}
    .contenido{margin:0.25rem 0}
    .fecha{font-size:0.8rem;color:#9ca3af}
    .no-comments{color:#6b7280}
  </style>
</div>
