---
export interface Props {
  disabled?: boolean;
}

// Default to disabled on server-render. Client-side script will enable when appropriate.
const { disabled = true } = Astro.props;
---

<form class="crear-publicacion" id="crear-publicacion-form" onsubmit="return false" style="display:none;">
  <textarea 
    id="crear-contenido" 
    name="contenido" 
    placeholder="¿Qué estás pensando?" 
    rows="3" 
    disabled={disabled}
  ></textarea>
  
  <!-- Preview de imágenes -->
  <div id="imagenes-preview" class="imagenes-preview"></div>
  
  <div class="actions">
    <div class="left-actions">
      <label for="crear-imagenes" class="btn-imagen" title="Agregar imágenes">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        <span>Agregar imágenes</span>
      </label>
      <input 
        id="crear-imagenes" 
        type="file" 
        name="imagenes" 
        accept="image/*" 
        multiple 
        disabled={disabled} 
        style="display: none;"
      />
    </div>
    <button id="crear-submit" class="btn-submit" type="submit" disabled={disabled}>
      Publicar
    </button>
  </div>

  <script>
    // Cliente: mostrar y habilitar el formulario SOLO si el usuario está autenticado y es Egresado
    (function(){
      try {
        const token = localStorage.getItem('auth_token');
        const userData = localStorage.getItem('user_data');
        if (!token || !userData) return; // Si no hay token, el form permanece oculto
        const user = JSON.parse(userData);
        if (user && user.tipo_usuario === 'Egresado') {
          const form = document.getElementById('crear-publicacion-form');
          const textarea = document.getElementById('crear-contenido');
          const fileInput = document.getElementById('crear-imagenes');
          const submit = document.getElementById('crear-submit');
          if (form) form.style.display = 'block'; // Mostrar el formulario
          if (textarea) textarea.removeAttribute('disabled');
          if (fileInput) fileInput.removeAttribute('disabled');
          if (submit) submit.removeAttribute('disabled');

          // Manejar selección de imágenes
          let imagenesSeleccionadas = [];
          
          fileInput.addEventListener('change', function(e) {
            const files = Array.from(e.target.files);
            const maxFiles = 5;
            const maxSize = 5 * 1024 * 1024; // 5MB

            // Validar cantidad de archivos
            if (imagenesSeleccionadas.length + files.length > maxFiles) {
              alert(`Máximo ${maxFiles} imágenes permitidas`);
              return;
            }

            // Validar y procesar archivos
            files.forEach(file => {
              if (file.size > maxSize) {
                alert(`${file.name} es demasiado grande. Máximo 5MB por imagen.`);
                return;
              }

              if (!file.type.startsWith('image/')) {
                alert(`${file.name} no es una imagen válida.`);
                return;
              }

              imagenesSeleccionadas.push(file);
            });

            mostrarPreview();
            // Limpiar el input para permitir seleccionar más imágenes
            e.target.value = '';
          });

          function mostrarPreview() {
            const preview = document.getElementById('imagenes-preview');
            preview.innerHTML = '';

            imagenesSeleccionadas.forEach((file, index) => {
              const reader = new FileReader();
              reader.onload = function(e) {
                const container = document.createElement('div');
                container.className = 'preview-item';
                container.innerHTML = `
                  <img src="${e.target.result}" alt="Preview ${index + 1}">
                  <button type="button" class="btn-eliminar-preview" data-index="${index}" title="Eliminar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                  </button>
                `;
                preview.appendChild(container);

                // Agregar evento para eliminar
                const btnEliminar = container.querySelector('.btn-eliminar-preview');
                btnEliminar.addEventListener('click', function() {
                  const idx = parseInt(this.getAttribute('data-index'));
                  imagenesSeleccionadas.splice(idx, 1);
                  mostrarPreview();
                });
              };
              reader.readAsDataURL(file);
            });
          }

          // Manejar envío del formulario
          form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const contenido = textarea.value.trim();
            if (!contenido) {
              alert('El contenido es obligatorio');
              return;
            }

            try {
              submit.disabled = true;
              submit.textContent = 'Publicando...';

              const formData = new FormData();
              formData.append('contenido', contenido);
              
              // Agregar imágenes al FormData
              imagenesSeleccionadas.forEach(file => {
                formData.append('imagenes', file);
              });

              const response = await fetch('http://localhost:3000/api/publicaciones', {
                method: 'POST',
                headers: {
                  'Authorization': `Bearer ${token}`
                },
                body: formData
              });

              const data = await response.json();

              if (data.success) {
                // Limpiar formulario
                textarea.value = '';
                imagenesSeleccionadas = [];
                mostrarPreview();
                
                // Recargar publicaciones
                if (typeof window.cargarPublicaciones === 'function') {
                  window.cargarPublicaciones(true);
                } else {
                  window.location.reload();
                }
              } else {
                alert(data.message || 'Error al crear publicación');
              }
            } catch (error) {
              console.error('Error:', error);
              alert('Error al crear la publicación');
            } finally {
              submit.disabled = false;
              submit.textContent = 'Publicar';
            }
          });
        }
      } catch(e) { console.warn('enable crear form failed', e); }
    })();
  </script>

  <style>
    .crear-publicacion{background:#fff;border-radius:12px;padding:1.25rem;margin-bottom:1rem;box-shadow:0 2px 8px rgba(0,0,0,0.1);border:1px solid #f0f0f0}
    textarea{width:100%;border:1px solid #e5e7eb;padding:0.75rem;border-radius:8px;font-size:0.95rem;font-family:inherit;resize:vertical}
    textarea:focus{outline:none;border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,0.1)}
    .actions{display:flex;align-items:center;justify-content:space-between;margin-top:0.75rem;gap:0.5rem}
    .btn-submit{background:#3b82f6;color:#fff;border:none;padding:0.5rem 1.25rem;border-radius:8px;cursor:pointer;font-weight:500;font-size:0.9rem}
    .btn-submit:hover{background:#2563eb}
    .btn-submit:disabled{background:#d1d5db;cursor:not-allowed}
    input[type="file"]{font-size:0.9rem}
  </style>
</form>

<link rel="stylesheet" href="/src/styles/publicaciones-imagenes.css" />
