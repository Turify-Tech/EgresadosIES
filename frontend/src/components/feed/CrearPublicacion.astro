---
export interface Props {
  disabled?: boolean;
}

// Default to disabled on server-render. Client-side script will enable when appropriate.
const { disabled = true } = Astro.props;
---

<form class="crear-publicacion" id="crear-publicacion-form" onsubmit="return false" style="display:none;">
  <textarea 
    id="crear-contenido" 
    name="contenido" 
    placeholder="¿Qué estás pensando?" 
    rows="3" 
    disabled={disabled}
  ></textarea>
  
  <!-- Preview de imágenes -->
  <div id="imagenes-preview" class="imagenes-preview"></div>
  
  <!-- Modal de recorte de imagen -->
  <div class="crop-modal" id="crop-modal-publicacion" style="display: none;">
    <div class="crop-modal-content">
      <div class="crop-modal-header">
        <h3>Ajustar imagen</h3>
        <button class="btn-close-modal" id="btn-close-crop-publicacion" type="button">×</button>
      </div>
      <div class="crop-container">
        <img id="image-to-crop-publicacion" src="" alt="Imagen para recortar" />
      </div>
      <div class="crop-modal-actions">
        <button class="btn-cancelar" id="btn-cancelar-crop-publicacion" type="button">Cancelar</button>
        <button class="btn-guardar" id="btn-aplicar-crop-publicacion" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Aplicar recorte
        </button>
      </div>
    </div>
  </div>
  
  <div class="actions">
    <div class="left-actions">
      <label for="crear-imagenes" class="btn-imagen" title="Agregar imágenes">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        <span>Agregar imágenes</span>
      </label>
      <input 
        id="crear-imagenes" 
        type="file" 
        name="imagenes" 
        accept="image/*" 
        multiple 
        disabled={disabled} 
        style="display: none;"
      />
    </div>
    <button id="crear-submit" class="btn-submit" type="submit" disabled={disabled}>
      Publicar
    </button>
  </div>

  <script>
    // Cliente: mostrar y habilitar el formulario SOLO si el usuario está autenticado y es Egresado
    (function(){
      try {
        const token = localStorage.getItem('auth_token');
        const userData = localStorage.getItem('user_data');
        if (!token || !userData) return; // Si no hay token, el form permanece oculto
        const user = JSON.parse(userData);
        if (user && user.tipo_usuario === 'Egresado') {
          const form = document.getElementById('crear-publicacion-form');
          const textarea = document.getElementById('crear-contenido');
          const fileInput = document.getElementById('crear-imagenes');
          const submit = document.getElementById('crear-submit');
          if (form) form.style.display = 'block'; // Mostrar el formulario
          if (textarea) textarea.removeAttribute('disabled');
          if (fileInput) fileInput.removeAttribute('disabled');
          if (submit) submit.removeAttribute('disabled');

          // Manejar selección de imágenes
          let imagenesSeleccionadas = [];
          let imagenActualIndex = 0; // Índice de la imagen que se está procesando
          let imagenesEnCola = []; // Cola de imágenes pendientes de recortar
          
          fileInput.addEventListener('change', function(e) {
            const files = Array.from(e.target.files);
            const maxFiles = 5;
            const maxSize = 5 * 1024 * 1024; // 5MB

            // Validar cantidad de archivos
            if (imagenesSeleccionadas.length + files.length > maxFiles) {
              alert(`Máximo ${maxFiles} imágenes permitidas`);
              return;
            }

            // Agregar archivos a la cola para procesar uno por uno
            imagenesEnCola = [];
            files.forEach(file => {
              if (file.size > maxSize) {
                alert(`${file.name} es demasiado grande. Máximo 5MB por imagen.`);
                return;
              }

              if (!file.type.startsWith('image/')) {
                alert(`${file.name} no es una imagen válida.`);
                return;
              }

              imagenesEnCola.push(file);
            });

            // Procesar la primera imagen de la cola
            if (imagenesEnCola.length > 0) {
              procesarSiguienteImagen();
            }

            // Limpiar el input para permitir seleccionar más imágenes
            e.target.value = '';
          });

          function procesarSiguienteImagen() {
            if (imagenesEnCola.length === 0) {
              return;
            }

            const file = imagenesEnCola.shift();
            const reader = new FileReader();
            reader.onload = function(e) {
              if (e.target?.result) {
                window.abrirModalRecortePublicacion(e.target.result, file.name);
              }
            };
            reader.readAsDataURL(file);
          }

          window.abrirModalRecortePublicacion = function(imageSrc, fileName) {
            const modal = document.getElementById('crop-modal-publicacion');
            const image = document.getElementById('image-to-crop-publicacion');
            
            if (modal && image) {
              image.src = imageSrc;
              modal.style.display = 'flex';
              
              // Guardar el nombre del archivo original
              window.currentImageName = fileName;
              
              // Inicializar Cropper.js
              setTimeout(() => {
                if (window.cropperPublicacion) {
                  window.cropperPublicacion.destroy();
                }
                
                window.cropperPublicacion = new Cropper(image, {
                  aspectRatio: NaN, // Permite cualquier proporción
                  viewMode: 2,
                  dragMode: 'move',
                  autoCropArea: 0.9,
                  restore: false,
                  guides: true,
                  center: true,
                  highlight: false,
                  cropBoxMovable: true,
                  cropBoxResizable: true,
                  toggleDragModeOnDblclick: false,
                });
              }, 100);
            }
          };

          window.cerrarModalRecortePublicacion = function() {
            const modal = document.getElementById('crop-modal-publicacion');
            if (modal) {
              modal.style.display = 'none';
            }
            
            if (window.cropperPublicacion) {
              window.cropperPublicacion.destroy();
              window.cropperPublicacion = null;
            }
            
            // Limpiar la cola si se cancela
            imagenesEnCola = [];
          };

          window.aplicarRecortePublicacion = function() {
            if (!window.cropperPublicacion) return;
            
            // Obtener imagen recortada como blob
            window.cropperPublicacion.getCroppedCanvas({
              maxWidth: 1200,
              maxHeight: 1200,
              imageSmoothingQuality: 'high'
            }).toBlob((blob) => {
              if (blob) {
                // Crear archivo desde blob con el nombre original
                const file = new File([blob], window.currentImageName || 'imagen-recortada.jpg', {
                  type: 'image/jpeg',
                  lastModified: Date.now()
                });
                
                imagenesSeleccionadas.push(file);
                mostrarPreview();
                window.cerrarModalRecortePublicacion();
                
                // Procesar la siguiente imagen si hay más en cola
                if (imagenesEnCola.length > 0) {
                  setTimeout(() => {
                    procesarSiguienteImagen();
                  }, 300);
                }
              }
            }, 'image/jpeg', 0.9);
          };

          // Agregar event listeners a los botones del modal
          const btnCloseCrop = document.getElementById('btn-close-crop-publicacion');
          const btnCancelarCrop = document.getElementById('btn-cancelar-crop-publicacion');
          const btnAplicarCrop = document.getElementById('btn-aplicar-crop-publicacion');
          
          if (btnCloseCrop) {
            btnCloseCrop.addEventListener('click', window.cerrarModalRecortePublicacion);
          }
          if (btnCancelarCrop) {
            btnCancelarCrop.addEventListener('click', window.cerrarModalRecortePublicacion);
          }
          if (btnAplicarCrop) {
            btnAplicarCrop.addEventListener('click', window.aplicarRecortePublicacion);
          }

          function mostrarPreview() {
            const preview = document.getElementById('imagenes-preview');
            preview.innerHTML = '';

            imagenesSeleccionadas.forEach((file, index) => {
              const reader = new FileReader();
              reader.onload = function(e) {
                const container = document.createElement('div');
                container.className = 'preview-item';
                container.innerHTML = `
                  <img src="${e.target.result}" alt="Preview ${index + 1}">
                  <button type="button" class="btn-eliminar-preview" data-index="${index}" title="Eliminar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                  </button>
                `;
                preview.appendChild(container);

                // Agregar evento para eliminar
                const btnEliminar = container.querySelector('.btn-eliminar-preview');
                btnEliminar.addEventListener('click', function() {
                  const idx = parseInt(this.getAttribute('data-index'));
                  imagenesSeleccionadas.splice(idx, 1);
                  mostrarPreview();
                });
              };
              reader.readAsDataURL(file);
            });
          }

          // Manejar envío del formulario
          form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const contenido = textarea.value.trim();
            if (!contenido) {
              alert('El contenido es obligatorio');
              return;
            }

            try {
              submit.disabled = true;
              submit.textContent = 'Publicando...';

              const formData = new FormData();
              formData.append('contenido', contenido);
              
              // Agregar imágenes al FormData
              imagenesSeleccionadas.forEach(file => {
                formData.append('imagenes', file);
              });

              // Determinar URL del API según el entorno
              const getApiUrl = () => {
                const hostname = window.location.hostname;
                if (hostname === 'localhost' || hostname === '127.0.0.1') {
                  return 'http://localhost:3000';
                }
                return 'https://egresados-ies-api.vercel.app';
              };

              const response = await fetch(`${getApiUrl()}/api/publicaciones`, {
                method: 'POST',
                headers: {
                  'Authorization': `Bearer ${token}`
                },
                body: formData
              });

              const data = await response.json();

              if (data.success) {
                // Limpiar formulario
                textarea.value = '';
                imagenesSeleccionadas = [];
                mostrarPreview();
                
                // Recargar publicaciones
                if (typeof window.cargarPublicaciones === 'function') {
                  window.cargarPublicaciones(true);
                } else {
                  window.location.reload();
                }
              } else {
                alert(data.message || 'Error al crear publicación');
              }
            } catch (error) {
              console.error('Error:', error);
              alert('Error al crear la publicación');
            } finally {
              submit.disabled = false;
              submit.textContent = 'Publicar';
            }
          });
        }
      } catch(e) { console.warn('enable crear form failed', e); }
    })();
  </script>

  <style>
    .crear-publicacion{background:#fff;border-radius:12px;padding:1.25rem;margin-bottom:1rem;box-shadow:0 2px 8px rgba(0,0,0,0.1);border:1px solid #f0f0f0}
    textarea{width:100%;border:1px solid #e5e7eb;padding:0.75rem;border-radius:8px;font-size:0.95rem;font-family:inherit;resize:vertical}
    textarea:focus{outline:none;border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,0.1)}
    .actions{display:flex;align-items:center;justify-content:space-between;margin-top:0.75rem;gap:0.5rem}
    .btn-submit{background:#3b82f6;color:#fff;border:none;padding:0.5rem 1.25rem;border-radius:8px;cursor:pointer;font-weight:500;font-size:0.9rem}
    .btn-submit:hover{background:#2563eb}
    .btn-submit:disabled{background:#d1d5db;cursor:not-allowed}
    input[type="file"]{font-size:0.9rem}
    
    /* Estilos del modal de recorte */
    .crop-modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10000;
    }

    .crop-modal-content {
      background: white;
      border-radius: 12px;
      max-width: 600px;
      width: 90%;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .crop-modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem;
      border-bottom: 1px solid #f0f0f0;
    }

    .crop-modal-header h3 {
      margin: 0;
      font-size: 1.25rem;
      font-weight: 600;
      color: #1f2937;
    }

    .btn-close-modal {
      background: none;
      border: none;
      font-size: 2rem;
      line-height: 1;
      color: #6b7280;
      cursor: pointer;
      padding: 0;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .btn-close-modal:hover {
      background: #f3f4f6;
      color: #1f2937;
    }

    .crop-container {
      flex: 1;
      overflow: hidden;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f9fafb;
      max-height: 500px;
    }

    .crop-container img {
      max-width: 100%;
      display: block;
    }

    .crop-modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 1rem;
      padding: 1.5rem;
      border-top: 1px solid #f0f0f0;
    }

    .btn-cancelar {
      background: #f3f4f6;
      color: #374151;
      border: none;
      padding: 0.625rem 1.25rem;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 500;
      font-size: 0.9rem;
      transition: all 0.2s;
    }

    .btn-cancelar:hover {
      background: #e5e7eb;
    }

    .btn-guardar {
      background: #3b82f6;
      color: white;
      border: none;
      padding: 0.625rem 1.25rem;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 500;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s;
    }

    .btn-guardar:hover {
      background: #2563eb;
    }

    .btn-guardar svg {
      width: 18px;
      height: 18px;
    }
  </style>
</form>

<link rel="stylesheet" href="/src/styles/publicaciones-imagenes.css" />
<!-- Cropper.js para recorte de imágenes -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
