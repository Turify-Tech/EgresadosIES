---
export interface Props { liked?: boolean; count?: number }
const { liked = false, count = 0 } = Astro.props;
---

<button class="like-button" aria-pressed={String(liked)}>
  <span class="heart">{liked ? '❤️' : '🤍'}</span>
  <span class="count">{count}</span>
  <style>
    .like-button{background:transparent;border:none;display:inline-flex;align-items:center;gap:0.4rem;cursor:pointer}
    .count{font-size:0.95rem;color:#374151}
  </style>
</button>
