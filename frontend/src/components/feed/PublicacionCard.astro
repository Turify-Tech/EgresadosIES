---
export interface Props {
  post: any;
}

const { post } = Astro.props;
---

<article class="post-card" data-id={post?.id}>
  <header class="post-header">
    <img class="avatar" src={post?.autor?.avatar || '/default-avatar.svg'} alt="avatar" />
    <div class="meta">
      <strong class="author">{post?.autor?.nombre || 'Usuario'}</strong>
      <time class="time">{post?.fechaCreacion ? new Date(post.fechaCreacion).toLocaleString() : ''}</time>
    </div>
  </header>

  <div class="post-body">
    <p class="content">{post?.contenido}</p>

    {post?.imagenes && post.imagenes.length > 0 ? (
      <div class="images">
        {post.imagenes.map((url) => (
          <img src={url} alt="imagen" loading="lazy" />
        ))}
      </div>
    ) : null}
  </div>

  <footer class="post-actions">
    <button class="like-btn" data-liked="false">❤ <span class="like-count">{post?.totalLikes || 0}</span></button>
    <button class="comment-toggle">💬 <span class="comment-count">{post?.totalComentarios || 0}</span></button>
    <div class="spacer"></div>
    <button class="more">⋯</button>
  </footer>

  <section class="comments" hidden id={`comments-section-${post?.id}`}>
    <div class="comments-list" id={`comments-list-${post?.id}`}>
      <!-- comentarios serán renderizados por script si existen -->
    </div>
    <div class="comment-form-placeholder" id={`comment-form-${post?.id}`}>
      <small class="login-hint">Inicia sesión para comentar.</small>
    </div>
  </section>

  <style>
    .post-card{background:#fff;border-radius:10px;padding:1rem;margin-bottom:1rem;box-shadow:0 6px 18px rgba(0,0,0,0.06)}
    .post-header{display:flex;gap:0.75rem;align-items:center}
    .avatar{width:44px;height:44px;border-radius:50%;object-fit:cover}
    .meta{display:flex;flex-direction:column}
    .author{font-weight:600}
    .time{font-size:0.85rem;color:#6b7280}
    .post-body{margin-top:0.75rem}
    .content{white-space:pre-wrap}
    .images{display:flex;gap:0.5rem;margin-top:0.5rem}
    .images img{width:120px;height:80px;object-fit:cover;border-radius:6px}
    .post-actions{display:flex;align-items:center;gap:0.5rem;margin-top:0.75rem}
    .like-btn,.comment-toggle,.more{background:transparent;border:none;cursor:pointer;font-size:0.95rem}
    .spacer{flex:1}
    .comments{margin-top:0.75rem;border-top:1px solid #eef2f7;padding-top:0.75rem}
    .comments-list{display:flex;flex-direction:column;gap:0.5rem}
    .comment-form-placeholder{margin-top:0.5rem}
  </style>
</article>
