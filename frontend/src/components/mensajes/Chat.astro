---
/**
 * Componente Chat
 * Muestra la ventana de conversación con un usuario específico
 */
---

<script is:inline>
    // Manejo del emoji picker
    (function() {
        var retryCount = 0;
        var MAX_RETRIES = 3;
        
        function initEmojiPicker() {
            var btnEmoji = document.getElementById('btn-emoji');
            var emojiPicker = document.getElementById('emoji-picker');
            var btnCerrarPicker = document.querySelector('.btn-cerrar-picker');
            var emojiButtons = document.querySelectorAll('.emoji-btn');
            var mensajeInput = document.getElementById('mensaje-input');

            if (!btnEmoji || !emojiPicker || !btnCerrarPicker || !mensajeInput) {
                retryCount++;
                if (retryCount < MAX_RETRIES) {
                    setTimeout(initEmojiPicker, 200);
                }
                return;
            }

            if (btnEmoji._emojiInitialized) {
                return;
            }
            btnEmoji._emojiInitialized = true;

            btnEmoji.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                var isVisible = emojiPicker.style.display === 'flex';
                emojiPicker.style.display = isVisible ? 'none' : 'flex';
            });

            btnCerrarPicker.addEventListener('click', function() {
                emojiPicker.style.display = 'none';
            });

            emojiButtons.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var emoji = btn.textContent || '';
                    var cursorPos = mensajeInput.selectionStart;
                    var textBefore = mensajeInput.value.substring(0, cursorPos);
                    var textAfter = mensajeInput.value.substring(mensajeInput.selectionEnd);
                    
                    mensajeInput.value = textBefore + emoji + textAfter;
                    mensajeInput.focus();
                    
                    var newCursorPos = cursorPos + emoji.length;
                    mensajeInput.setSelectionRange(newCursorPos, newCursorPos);
                    
                    emojiPicker.style.display = 'none';
                });
            });

            document.addEventListener('click', function(e) {
                var target = e.target;
                if (!btnEmoji.contains(target) && !emojiPicker.contains(target)) {
                    if (emojiPicker.style.display === 'flex') {
                        emojiPicker.style.display = 'none';
                    }
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initEmojiPicker);
        } else {
            initEmojiPicker();
        }
    })();
</script>

