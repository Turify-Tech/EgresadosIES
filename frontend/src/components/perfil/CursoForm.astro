---
// Componente para gestionar habilidades
---

<div class="habilidades-form">
    <div class="form-header">
        <h2>HABILIDADES</h2>
    </div>

    <form class="habilidades-content" id="habilidades-form">
        <!-- Sección: Técnicas -->
        <div class="habilidades-section">
            <div class="section-header">
                <h3>Técnicas:</h3>
            </div>

            <div class="field-row">
                <div class="form-group">
                    <label for="lenguajes">Lenguajes:</label>
                    <select id="lenguajes" name="lenguajes" class="form-select">
                        <option value="">Python, Java...</option>
                        <option value="Python">Python</option>
                        <option value="Java">Java</option>
                        <option value="JavaScript">JavaScript</option>
                        <option value="TypeScript">TypeScript</option>
                        <option value="C++">C++</option>
                        <option value="C#">C#</option>
                        <option value="PHP">PHP</option>
                        <option value="Go">Go</option>
                        <option value="Rust">Rust</option>
                        <option value="Swift">Swift</option>
                    </select>
                </div>
                <div class="form-group icon-field">
                    <button type="button" class="add-item-btn">
                        <span>⚙</span>
                    </button>
                </div>
            </div>

            <div class="field-row">
                <div class="form-group">
                    <label for="herramientas">Herramientas:</label>
                    <select
                        id="herramientas"
                        name="herramientas"
                        class="form-select">
                        <option value="">Figma, AutoCad...</option>
                        <option value="Figma">Figma</option>
                        <option value="AutoCAD">AutoCAD</option>
                        <option value="Photoshop">Photoshop</option>
                        <option value="Illustrator">Illustrator</option>
                        <option value="InDesign">InDesign</option>
                        <option value="Sketch">Sketch</option>
                        <option value="XD">Adobe XD</option>
                        <option value="Blender">Blender</option>
                        <option value="Unity">Unity</option>
                        <option value="Git">Git</option>
                        <option value="Docker">Docker</option>
                        <option value="Kubernetes">Kubernetes</option>
                    </select>
                </div>
                <div class="form-group icon-field">
                    <button type="button" class="add-item-btn">
                        <span>⚙</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Sección: Blandas -->
        <div class="blandas-section">
            <div class="section-header">
                <h3>Blandas:</h3>
            </div>

            <div class="field-row">
                <div class="form-group full-width">
                    <textarea
                        id="habilidades-blandas"
                        name="habilidadesBlandas"
                        class="form-textarea"
                        placeholder="Buen desempeño en equipo..."
                        rows="4"></textarea>
                </div>
                <div class="form-group icon-field">
                    <button type="button" class="add-item-btn">
                        <span>⚙</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Botón Siguiente -->
        <div class="form-actions">
            <button type="button" class="btn-siguiente" id="save-habilidades">
                Siguiente
            </button>
        </div>
    </form>
</div>

<style>
    .habilidades-form {
        background: white;
        border-radius: 8px;
        padding: 2rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .form-header {
        text-align: center;
        margin-bottom: 2rem;
        border-bottom: 2px solid #3b82f6;
        padding-bottom: 1rem;
    }

    .form-header h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #3b82f6;
        letter-spacing: 0.05em;
    }

    .habilidades-content {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    /* Secciones */
    .habilidades-section,
    .blandas-section {
        background: #f9fafb;
        border-radius: 8px;
        padding: 1.5rem;
    }

    .section-header {
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .section-header h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: #374151;
    }

    /* Campos de formulario */
    .field-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: end;
        margin-bottom: 1rem;
    }

    .field-row:last-child {
        margin-bottom: 0;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.full-width {
        width: 100%;
    }

    .form-group.icon-field {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
    }

    .form-group label {
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #374151;
        font-size: 0.875rem;
    }

    .form-select,
    .form-textarea {
        padding: 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 0.875rem;
        transition:
            border-color 0.2s,
            box-shadow 0.2s;
        background: white;
        font-family: inherit;
        width: 100%;
    }

    .form-select:focus,
    .form-textarea:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .form-textarea {
        resize: vertical;
        min-height: 100px;
    }

    /* Botones */
    .add-item-btn {
        width: 32px;
        height: 32px;
        background: #6b7280;
        color: white;
        border: none;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
        transition: background 0.2s;
    }

    .add-item-btn:hover {
        background: #4b5563;
    }

    /* Botón Siguiente */
    .form-actions {
        display: flex;
        justify-content: center;
        padding-top: 2rem;
        border-top: 1px solid #e5e7eb;
    }

    .btn-siguiente {
        padding: 0.75rem 2rem;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.875rem;
        transition: all 0.2s;
        box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2);
    }

    .btn-siguiente:hover {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 4px 8px rgba(59, 130, 246, 0.3);
        transform: translateY(-1px);
    }

    .btn-siguiente:disabled {
        background: #9ca3af;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .habilidades-form {
            padding: 1rem;
        }

        .field-row {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        .form-group.icon-field {
            justify-content: flex-start;
            margin-top: 0.5rem;
        }

        .btn-siguiente {
            width: 100%;
        }
    }
</style>

<script>
    // @ts-nocheck
    class HabilidadesManager {
        constructor() {
            this.form = document.getElementById("habilidades-form");
            this.isInitialized = false;
            this.init();
        }

        init() {
            this.bindEvents();

            // Escuchar cuando se cargan los datos del perfil
            window.addEventListener("profile-data-loaded", (e) => {
                this.populateForm(e.detail);
            });
        }

        bindEvents() {
            // Botón siguiente
            document
                .getElementById("save-habilidades")
                ?.addEventListener("click", () => {
                    this.saveSection();
                });

            // Auto-guardado después de cambios
            this.form?.addEventListener("change", () => {
                setTimeout(() => {
                    this.autoSave();
                }, 1000);
            });
        }

        populateForm(profileData) {
            if (!profileData || this.isInitialized) return;

            console.log("Poblando cursos con:", profileData);

            // Extraer cursos de la estructura de la API
            const cursos = profileData.data?.cursos || profileData.cursos || [];

            console.log("Cursos extraídos:", cursos);

            // Limpiar cursos existentes en el DOM
            this.clearExistingCursos();

            // Poblar cada curso
            cursos.forEach((curso, index) => {
                this.addCursoToDOM(curso, index);
            });

            this.isInitialized = true;
            console.log("✅ Cursos inicializados correctamente");
        }

        clearExistingCursos() {
            const container = document.getElementById("cursos-container");
            if (container) {
                // Mantener solo el template y el botón de agregar
                const items = container.querySelectorAll(
                    ".curso-item:not(.template)"
                );
                items.forEach((item) => item.remove());
            }
        }

        addCursoToDOM(curso, index) {
            const container = document.getElementById("cursos-container");
            const template = document.getElementById("curso-template");

            if (!container || !template) return;

            const clone = template.cloneNode(true);
            clone.classList.remove("template");
            clone.style.display = "block";
            clone.setAttribute("data-index", index);

            // Poblar campos
            const nombreField = clone.querySelector('[name="nombre"]');
            const institucionField = clone.querySelector(
                '[name="institucion"]'
            );
            const horasField = clone.querySelector('[name="horasDuracion"]');

            if (nombreField) nombreField.value = curso.nombre || "";
            if (institucionField)
                institucionField.value = curso.institucion || "";
            if (horasField) horasField.value = curso.horasDuracion || "";

            // Insertar antes del botón de agregar
            const addButton = container.querySelector(".add-curso-btn");
            if (addButton) {
                container.insertBefore(clone, addButton);
            } else {
                container.appendChild(clone);
            }
        }

        getFormData() {
            const formData = new FormData(this.form);
            const data = {};

            // Convertir FormData a objeto
            for (let [key, value] of formData.entries()) {
                data[key] = value;
            }

            return data;
        }

        async saveSection() {
            try {
                const btn = document.getElementById("save-habilidades");
                if (btn) {
                    btn.disabled = true;
                    btn.textContent = "Guardando...";
                }

                const data = this.getFormData();

                // Emitir evento para que el controlador principal maneje el guardado
                window.dispatchEvent(
                    new CustomEvent("save-section-data", {
                        detail: { section: "habilidades", data },
                    })
                );

                this.showNotification("Habilidades guardadas", "success");

                // Navegar a la siguiente sección después de guardar
                setTimeout(() => {
                    const profileEditor = (window as any).profileEditor;
                    if (profileEditor) {
                        profileEditor.switchSection("proyectos");
                    }
                }, 500);
            } catch (error) {
                console.error("Error guardando habilidades:", error);
                this.showNotification(
                    "Error al guardar las habilidades",
                    "error"
                );
            } finally {
                const btn = document.getElementById("save-habilidades");
                if (btn) {
                    (btn as HTMLButtonElement).disabled = false;
                    btn.textContent = "Siguiente";
                }
            }
        }

        async autoSave() {
            const data = this.getFormData();

            // Emitir evento para auto-guardado
            window.dispatchEvent(
                new CustomEvent("auto-save-data", {
                    detail: { section: "habilidades", data },
                })
            );

            console.log("Auto-guardando habilidades...");
        }

        showNotification(message: string, type: string) {
            // Reutilizar el sistema de notificaciones del componente principal
            window.dispatchEvent(
                new CustomEvent("show-notification", {
                    detail: { message, type },
                })
            );
        }
    }

    // Inicializar cuando el DOM esté listo
    document.addEventListener("DOMContentLoaded", () => {
        (window as any).cursosManager = new HabilidadesManager();
    });
</script>
