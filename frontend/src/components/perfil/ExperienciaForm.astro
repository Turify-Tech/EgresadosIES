---
// Componente para gestionar experiencias laborales
---

<div class="experiencias-form">
    <div class="form-header">
        <h2>EXPERIENCIAS</h2>
    </div>

    <form class="experiencias-content" id="experiencias-form">
        <!-- Sección: Laborales -->
        <div class="experiencias-section">
            <div class="section-header">
                <h3>Laborales:</h3>
            </div>

            <div class="experiencia-item">
                <div class="field-row">
                    <div class="form-group">
                        <label for="empresa">Empresa:</label>
                        <input
                            type="text"
                            id="empresa"
                            name="empresa"
                            class="form-input"
                            placeholder=""
                        />
                    </div>
                    <div class="form-group icon-field">
                        <button
                            type="button"
                            class="add-item-btn"
                            id="add-experiencia-btn">
                            <span>⚙</span>
                        </button>
                    </div>
                </div>

                <div class="field-row">
                    <div class="form-group">
                        <label for="descripcion">Descripción:</label>
                        <input
                            type="text"
                            id="descripcion"
                            name="descripcion"
                            class="form-input"
                            placeholder=""
                        />
                    </div>
                    <div class="form-group icon-field">
                        <button type="button" class="add-item-btn">
                            <span>⚙</span>
                        </button>
                    </div>
                </div>

                <div class="field-row">
                    <div class="form-group">
                        <label for="duracion-laboral">Duración laboral:</label>
                        <input
                            type="text"
                            id="duracion-laboral"
                            name="duracionLaboral"
                            class="form-input"
                            placeholder=""
                        />
                    </div>
                    <div class="form-group icon-field">
                        <button type="button" class="add-item-btn">
                            <span>⚙</span>
                        </button>
                    </div>
                </div>

                <div class="field-row">
                    <div class="form-group">
                        <label for="agregar-mas">Agregar más:</label>
                        <button
                            type="button"
                            class="info-btn"
                            title="Agregar más experiencias">
                            <span>i</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botón Siguiente -->
        <div class="form-actions">
            <button type="button" class="btn-siguiente" id="save-experiencias">
                Siguiente
            </button>
        </div>
    </form>
</div>

<style>
    .experiencias-form {
        background: white;
        border-radius: 8px;
        padding: 2rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .form-header {
        text-align: center;
        margin-bottom: 2rem;
        border-bottom: 2px solid #3b82f6;
        padding-bottom: 1rem;
    }

    .form-header h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #3b82f6;
        letter-spacing: 0.05em;
    }

    .experiencias-content {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    /* Secciones */
    .experiencias-section {
        background: #f9fafb;
        border-radius: 8px;
        padding: 1.5rem;
    }

    .section-header {
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .section-header h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: #374151;
    }

    /* Campos de formulario */
    .field-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: end;
        margin-bottom: 1rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.icon-field {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
    }

    .form-group label {
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #374151;
        font-size: 0.875rem;
    }

    .form-input {
        padding: 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 0.875rem;
        transition:
            border-color 0.2s,
            box-shadow 0.2s;
        background: white;
        font-family: inherit;
        width: 100%;
    }

    .form-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    /* Botones */
    .add-item-btn {
        width: 32px;
        height: 32px;
        background: #6b7280;
        color: white;
        border: none;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
        transition: background 0.2s;
    }

    .add-item-btn:hover {
        background: #4b5563;
    }

    .info-btn {
        width: 24px;
        height: 24px;
        background: #6b7280;
        color: white;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: bold;
        transition: background 0.2s;
    }

    .info-btn:hover {
        background: #4b5563;
    }

    /* Botón Siguiente */
    .form-actions {
        display: flex;
        justify-content: center;
        padding-top: 2rem;
        border-top: 1px solid #e5e7eb;
    }

    .btn-siguiente {
        padding: 0.75rem 2rem;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.875rem;
        transition: all 0.2s;
        box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2);
    }

    .btn-siguiente:hover {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 4px 8px rgba(59, 130, 246, 0.3);
        transform: translateY(-1px);
    }

    .btn-siguiente:disabled {
        background: #9ca3af;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .experiencias-form {
            padding: 1rem;
        }

        .field-row {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        .form-group.icon-field {
            justify-content: flex-start;
            margin-top: 0.5rem;
        }

        .btn-siguiente {
            width: 100%;
        }
    }
</style>

<script>
    // @ts-nocheck
    class ExperienciasManager {
        constructor() {
            this.form = document.getElementById("experiencias-form");
            this.isInitialized = false;
            this.init();
        }

        init() {
            this.bindEvents();

            // Escuchar cuando se cargan los datos del perfil
            window.addEventListener("profile-data-loaded", (e) => {
                const customEvent = e;
                if (customEvent.detail) {
                    this.populateForm(customEvent.detail);
                }
            });
        }

        bindEvents() {
            // Botones agregar
            document
                .getElementById("add-experiencia-btn")
                ?.addEventListener("click", () => {
                    this.addExperienciaItem();
                });

            // Botón siguiente
            document
                .getElementById("save-experiencias")
                ?.addEventListener("click", () => {
                    this.saveSection();
                });

            // Auto-guardado después de cambios
            this.form?.addEventListener("change", () => {
                setTimeout(() => {
                    this.autoSave();
                }, 1000);
            });
        }

        addExperienciaItem() {
            // TODO: Agregar nueva experiencia
            console.log("Agregando nueva experiencia");
        }

        populateForm(profileData) {
            if (!profileData || this.isInitialized) return;

            console.log("Poblando experiencias con:", profileData);

            // Extraer experiencias laborales de la estructura de la API
            const experiencias =
                profileData.data?.experienciasLaborales ||
                profileData.experienciasLaborales ||
                [];

            console.log("Experiencias extraídas:", experiencias);

            // Limpiar experiencias existentes en el DOM
            this.clearExistingExperiencias();

            // Poblar cada experiencia
            experiencias.forEach((exp, index) => {
                this.addExperienciaToDOM(exp, index);
            });

            this.isInitialized = true;
            console.log("✅ Experiencias inicializadas correctamente");
        }

        clearExistingExperiencias() {
            const container = document.getElementById("experiencias-container");
            if (container) {
                // Mantener solo el template y el botón de agregar
                const items = container.querySelectorAll(
                    ".experiencia-item:not(.template)"
                );
                items.forEach((item) => item.remove());
            }
        }

        addExperienciaToDOM(experiencia, index) {
            const container = document.getElementById("experiencias-container");
            const template = document.getElementById("experiencia-template");

            if (!container || !template) return;

            const clone = template.cloneNode(true);
            clone.classList.remove("template");
            clone.style.display = "block";
            clone.setAttribute("data-index", index);

            // Poblar campos
            const puestoField = clone.querySelector('[name="puesto"]');
            const empresaField = clone.querySelector('[name="empresa"]');
            const fechaInicioField = clone.querySelector(
                '[name="fechaInicio"]'
            );
            const fechaFinField = clone.querySelector('[name="fechaFin"]');
            const descripcionField = clone.querySelector(
                '[name="descripcion"]'
            );

            if (puestoField) puestoField.value = experiencia.puesto || "";
            if (empresaField) empresaField.value = experiencia.empresa || "";
            if (fechaInicioField)
                fechaInicioField.value = experiencia.fechaInicio || "";
            if (fechaFinField) fechaFinField.value = experiencia.fechaFin || "";
            if (descripcionField)
                descripcionField.value = experiencia.descripcion || "";

            // Insertar antes del botón de agregar
            const addButton = container.querySelector(".add-experiencia-btn");
            if (addButton) {
                container.insertBefore(clone, addButton);
            } else {
                container.appendChild(clone);
            }
        }

        getFormData() {
            const formData = new FormData(this.form);
            const data = {};

            // Convertir FormData a objeto
            for (let [key, value] of formData.entries()) {
                data[key] = value;
            }

            return data;
        }

        async saveSection() {
            try {
                const btn = document.getElementById("save-experiencias");
                if (btn && "disabled" in btn) {
                    btn.disabled = true;
                    btn.textContent = "Guardando...";
                }

                const data = this.getFormData();

                // Emitir evento para que el controlador principal maneje el guardado
                window.dispatchEvent(
                    new CustomEvent("save-section-data", {
                        detail: { section: "experiencias", data },
                    })
                );

                this.showNotification("Experiencias guardadas", "success");

                // Navegar a la siguiente sección después de guardar
                setTimeout(() => {
                    const profileEditor = (window as any).profileEditor;
                    if (profileEditor) {
                        profileEditor.switchSection("habilidades");
                    }
                }, 500);
            } catch (error) {
                console.error("Error guardando experiencias:", error);
                this.showNotification(
                    "Error al guardar las experiencias",
                    "error"
                );
            } finally {
                const btn = document.getElementById("save-experiencias");
                if (btn) {
                    (btn as HTMLButtonElement).disabled = false;
                    btn.textContent = "Siguiente";
                }
            }
        }

        async autoSave() {
            const data = this.getFormData();

            // Emitir evento para auto-guardado
            window.dispatchEvent(
                new CustomEvent("auto-save-data", {
                    detail: { section: "experiencias", data },
                })
            );

            console.log("Auto-guardando experiencias...");
        }

        showNotification(message: string, type: string) {
            // Reutilizar el sistema de notificaciones del componente principal
            window.dispatchEvent(
                new CustomEvent("show-notification", {
                    detail: { message, type },
                })
            );
        }
    }

    // Inicializar cuando el DOM esté listo
    document.addEventListener("DOMContentLoaded", () => {
        (window as any).experienciasManager = new ExperienciasManager();
    });
</script>
