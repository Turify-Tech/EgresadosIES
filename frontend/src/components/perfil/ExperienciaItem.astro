---
/**
 * Componente ExperienciaItem - Item individual de experiencia laboral
 */

export interface Props {
    experiencia: {
        id?: number;
        puesto: string;
        empresa: string;
        fechaInicio: string;
        fechaFin?: string | null;
        descripcion?: string;
    };
}

const { experiencia } = Astro.props;

// Formatear fechas
function formatDate(dateStr: string): string {
    if (!dateStr) return "";

    // Si es solo un año
    if (dateStr.length === 4) {
        return dateStr;
    }

    // Si es una fecha completa
    const date = new Date(dateStr);
    if (isNaN(date.getTime())) return dateStr;

    return date.toLocaleDateString("es-ES", {
        year: "numeric",
        month: "short",
    });
}

const fechaInicio = formatDate(experiencia.fechaInicio);
const fechaFin = experiencia.fechaFin
    ? formatDate(experiencia.fechaFin)
    : "Presente";
---

<div class="experiencia-item">
    <div class="timeline-marker"></div>
    <div class="timeline-content">
        <h4 class="timeline-title">{experiencia.puesto}</h4>
        <p class="timeline-subtitle">{experiencia.empresa}</p>
        <p class="timeline-dates">{fechaInicio} - {fechaFin}</p>
        {
            experiencia.descripcion && (
                <p class="timeline-description">{experiencia.descripcion}</p>
            )
        }
    </div>
</div>

<style>
    .experiencia-item {
        display: flex;
        gap: 1rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid #e5e7eb;
        transition: all 0.2s ease;
    }

    .experiencia-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .experiencia-item:first-child {
        padding-top: 0;
    }

    .experiencia-item:hover {
        background: rgba(59, 130, 246, 0.02);
        margin: 0 -1rem;
        padding-left: 1rem;
        padding-right: 1rem;
        border-radius: 8px;
    }

    .timeline-marker {
        flex-shrink: 0;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #3b82f6;
        margin-top: 0.25rem;
        position: relative;
    }

    .timeline-marker::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: white;
    }

    .timeline-content {
        flex: 1;
        min-width: 0;
    }

    .timeline-title {
        font-weight: 600;
        color: #1f2937;
        margin: 0 0 0.25rem 0;
        font-size: 1.1rem;
        line-height: 1.3;
    }

    .timeline-subtitle {
        color: #6b7280;
        margin: 0 0 0.5rem 0;
        font-weight: 500;
        font-size: 0.95rem;
    }

    .timeline-dates {
        color: #9ca3af;
        font-size: 0.875rem;
        margin: 0 0 0.75rem 0;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .timeline-dates::before {
        content: "📅";
        font-size: 0.75rem;
    }

    .timeline-description {
        color: #4b5563;
        line-height: 1.6;
        margin: 0;
        font-size: 0.95rem;
        text-align: justify;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .experiencia-item {
            flex-direction: column;
            gap: 0.5rem;
            padding: 1rem 0;
        }

        .timeline-marker {
            width: 8px;
            height: 8px;
            margin-top: 0;
        }

        .timeline-marker::before {
            width: 4px;
            height: 4px;
        }

        .timeline-title {
            font-size: 1rem;
        }

        .timeline-subtitle {
            font-size: 0.9rem;
        }

        .timeline-dates {
            font-size: 0.8rem;
        }

        .timeline-description {
            font-size: 0.9rem;
        }
    }
</style>
