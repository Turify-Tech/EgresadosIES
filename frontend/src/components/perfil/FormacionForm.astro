---
// Componente para gestionar formación académica
---

<div class="formaciones-form">
    <div class="form-header">
        <h2>FORMACIONES</h2>
    </div>

    <form class="formaciones-content" id="formaciones-form">
        <!-- Sección: Formaciones Académicas -->
        <div class="formacion-section">
            <div class="section-header">
                <h3>Formaciones Académicas</h3>
                <button
                    type="button"
                    class="add-item-btn"
                    id="add-formacion-btn">
                    <span>+</span>
                </button>
            </div>

            <div class="formacion-item" id="formacion-template">
                <div class="field-row">
                    <div class="form-group">
                        <label for="carrera">Carrera/Título de Software</label>
                        <input
                            type="text"
                            id="carrera"
                            name="carrera"
                            class="form-input"
                            placeholder="Ingeniería en Software"
                        />
                    </div>
                    <div class="form-group time-fields">
                        <label for="ano-egreso">Año de egreso:</label>
                        <input
                            type="number"
                            id="ano-egreso"
                            name="anoEgreso"
                            class="form-input year-input"
                            min="1950"
                            max="2050"
                        />
                    </div>
                </div>

                <div class="field-row">
                    <div class="form-group">
                        <label for="institucion">Institución</label>
                        <input
                            type="text"
                            id="institucion"
                            name="institucion"
                            class="form-input"
                            placeholder="Universidad/Instituto"
                        />
                    </div>
                    <div class="form-group time-fields">
                        <label for="horas-cursadas">Horas cursadas:</label>
                        <input
                            type="number"
                            id="horas-cursadas"
                            name="horasCursadas"
                            class="form-input hours-input"
                        />
                    </div>
                </div>

                <div class="field-row">
                    <div class="form-group">
                        <label for="enlace-titulo">Enlace al título</label>
                        <input
                            type="url"
                            id="enlace-titulo"
                            name="enlaceTitulo"
                            class="form-input"
                            placeholder="https://..."
                        />
                    </div>
                    <div class="form-group time-fields">
                        <label for="agregar-otra">Agregar otra:</label>
                        <button
                            type="button"
                            class="info-btn"
                            title="Información">
                            <span>i</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sección: Cursos -->
        <div class="cursos-section">
            <div class="section-header">
                <h3>Cursos</h3>
                <button type="button" class="add-item-btn" id="add-curso-btn">
                    <span>+</span>
                </button>
            </div>

            <div class="curso-item">
                <div class="field-row">
                    <div class="form-group">
                        <input
                            type="text"
                            name="nombreCurso"
                            class="form-input curso-input"
                            placeholder="Curso de Python en Udemy"
                        />
                    </div>
                    <div class="form-group time-fields">
                        <label for="finalizar">Finalizar:</label>
                        <input
                            type="text"
                            id="finalizar"
                            name="finalizar"
                            class="form-input finalizar-input"
                            placeholder="En proceso"
                        />
                        <button type="button" class="enlace-btn">Enlace</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Certificados -->
        <div class="certificados-section">
            <div class="field-row">
                <div class="form-group">
                    <label>Certificados:</label>
                    <input
                        type="text"
                        name="certificados"
                        class="form-input certificados-input"
                        placeholder="Seleccionar"
                    />
                </div>
                <div class="form-group">
                    <label>Enlace</label>
                    <input
                        type="url"
                        name="enlaceCertificado"
                        class="form-input"
                        placeholder="URL del certificado"
                    />
                </div>
            </div>

            <div class="field-row">
                <div class="form-group">
                    <label>Horas cursadas:</label>
                    <input
                        type="number"
                        name="horasCertificado"
                        class="form-input hours-input"
                    />
                </div>
                <div class="form-group">
                    <label>Nivel:</label>
                    <input
                        type="text"
                        name="nivelCertificado"
                        class="form-input"
                        placeholder="Básico/Intermedio/Avanzado"
                    />
                </div>
            </div>

            <div class="field-row">
                <div class="form-group full-width">
                    <label>Agregar más:</label>
                    <button
                        type="button"
                        class="info-btn"
                        title="Agregar más certificados">
                        <span>i</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Botón Siguiente -->
        <div class="form-actions">
            <button type="button" class="btn-siguiente" id="save-formaciones">
                Siguiente
            </button>
        </div>
    </form>
</div>

<style>
    .formaciones-form {
        background: white;
        border-radius: 8px;
        padding: 2rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .form-header {
        text-align: center;
        margin-bottom: 2rem;
        border-bottom: 2px solid #3b82f6;
        padding-bottom: 1rem;
    }

    .form-header h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #3b82f6;
        letter-spacing: 0.05em;
    }

    .formaciones-content {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    /* Secciones */
    .formacion-section,
    .cursos-section,
    .certificados-section {
        background: #f9fafb;
        border-radius: 8px;
        padding: 1.5rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .section-header h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: #374151;
    }

    .add-item-btn {
        width: 32px;
        height: 32px;
        background: #3b82f6;
        color: white;
        border: none;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1.2rem;
        transition: background 0.2s;
    }

    .add-item-btn:hover {
        background: #2563eb;
    }

    /* Campos de formulario */
    .field-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: end;
        margin-bottom: 1rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group.time-fields {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
        min-width: 200px;
    }

    .form-group label {
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #374151;
        font-size: 0.875rem;
    }

    .time-fields label {
        margin-bottom: 0;
        white-space: nowrap;
        font-size: 0.8rem;
    }

    .form-input {
        padding: 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 0.875rem;
        transition:
            border-color 0.2s,
            box-shadow 0.2s;
        background: white;
        font-family: inherit;
    }

    .form-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .year-input,
    .hours-input {
        width: 80px;
    }

    .curso-input {
        width: 100%;
    }

    .finalizar-input {
        width: 120px;
    }

    .certificados-input {
        width: 100%;
    }

    /* Botones especiales */
    .enlace-btn {
        padding: 0.5rem 1rem;
        background: #10b981;
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 0.75rem;
        cursor: pointer;
        transition: background 0.2s;
    }

    .enlace-btn:hover {
        background: #059669;
    }

    .info-btn {
        width: 24px;
        height: 24px;
        background: #6b7280;
        color: white;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: bold;
        transition: background 0.2s;
    }

    .info-btn:hover {
        background: #4b5563;
    }

    /* Botón Siguiente */
    .form-actions {
        display: flex;
        justify-content: center;
        padding-top: 2rem;
        border-top: 1px solid #e5e7eb;
    }

    .btn-siguiente {
        padding: 0.75rem 2rem;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.875rem;
        transition: all 0.2s;
        box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2);
    }

    .btn-siguiente:hover {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 4px 8px rgba(59, 130, 246, 0.3);
        transform: translateY(-1px);
    }

    .btn-siguiente:disabled {
        background: #9ca3af;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .formaciones-form {
            padding: 1rem;
        }

        .field-row {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        .form-group.time-fields {
            flex-direction: column;
            align-items: stretch;
            min-width: auto;
        }

        .time-fields label {
            margin-bottom: 0.5rem;
        }

        .year-input,
        .hours-input,
        .finalizar-input {
            width: 100%;
        }

        .btn-siguiente {
            width: 100%;
        }
    }
</style>

<script>
    // @ts-nocheck
    class FormacionesManager {
        constructor() {
            this.form = document.getElementById("formaciones-form");
            this.isInitialized = false;
            this.init();
        }

        init() {
            this.bindEvents();

            // Escuchar cuando se cargan los datos del perfil
            window.addEventListener("profile-data-loaded", (e) => {
                const customEvent = e;
                if (customEvent.detail) {
                    this.populateForm(customEvent.detail);
                }
            });
        }

        bindEvents() {
            // Botones agregar
            document
                .getElementById("add-formacion-btn")
                ?.addEventListener("click", () => {
                    this.addFormacionItem();
                });

            document
                .getElementById("add-curso-btn")
                ?.addEventListener("click", () => {
                    this.addCursoItem();
                });

            // Botón siguiente
            document
                .getElementById("save-formaciones")
                ?.addEventListener("click", () => {
                    this.saveSection();
                });

            // Auto-guardado después de cambios
            this.form?.addEventListener("change", () => {
                setTimeout(() => {
                    this.autoSave();
                }, 1000);
            });
        }

        addFormacionItem() {
            // TODO: Agregar nueva formación
            console.log("Agregando nueva formación");
        }

        addCursoItem() {
            // TODO: Agregar nuevo curso
            console.log("Agregando nuevo curso");
        }

        populateForm(profileData) {
            if (!profileData || this.isInitialized) return;

            // TODO: Poblar campos con datos del perfil
            console.log("Poblando formaciones", profileData);
            this.isInitialized = true;
        }

        getFormData() {
            const formData = new FormData(this.form);
            const data = {};

            // Convertir FormData a objeto
            for (let [key, value] of formData.entries()) {
                data[key] = value;
            }

            return data;
        }

        async saveSection() {
            try {
                const btn = document.getElementById("save-formaciones");
                if (btn && "disabled" in btn) {
                    btn.disabled = true;
                    btn.textContent = "Guardando...";
                }

                const data = this.getFormData();

                // Emitir evento para que el controlador principal maneje el guardado
                window.dispatchEvent(
                    new CustomEvent("save-section-data", {
                        detail: { section: "formaciones", data },
                    })
                );

                this.showNotification("Formaciones guardadas", "success");

                // Navegar a la siguiente sección después de guardar
                setTimeout(() => {
                    const profileEditor = (window as any).profileEditor;
                    if (profileEditor) {
                        profileEditor.switchSection("experiencias");
                    }
                }, 500);
            } catch (error) {
                console.error("Error guardando formaciones:", error);
                this.showNotification(
                    "Error al guardar las formaciones",
                    "error"
                );
            } finally {
                const btn = document.getElementById("save-formaciones");
                if (btn) {
                    (btn as HTMLButtonElement).disabled = false;
                    btn.textContent = "Siguiente";
                }
            }
        }

        async autoSave() {
            const data = this.getFormData();

            // Emitir evento para auto-guardado
            window.dispatchEvent(
                new CustomEvent("auto-save-data", {
                    detail: { section: "formaciones", data },
                })
            );

            console.log("Auto-guardando formaciones...");
        }

        showNotification(message: string, type: string) {
            // Reutilizar el sistema de notificaciones del componente principal
            window.dispatchEvent(
                new CustomEvent("show-notification", {
                    detail: { message, type },
                })
            );
        }
    }

    // Inicializar cuando el DOM esté listo
    document.addEventListener("DOMContentLoaded", () => {
        (window as any).formacionesManager = new FormacionesManager();
    });
</script>
