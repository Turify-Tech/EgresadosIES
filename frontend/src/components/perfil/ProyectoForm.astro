---
// Componente para gestionar proyectos
---

<div class="proyectos-form">
    <div class="form-header">
        <h2>PROYECTOS</h2>
    </div>

    <form class="proyectos-content" id="proyectos-form">
        <!-- Header con navegación -->
        <div class="proyectos-header">
            <div class="nav-controls">
                <button
                    type="button"
                    class="nav-btn"
                    id="prev-proyecto"
                    disabled>
                    ← Anterior
                </button>
                <span class="nav-info" id="proyecto-counter">1 / 1</span>
                <button type="button" class="nav-btn" id="next-proyecto">
                    Siguiente →
                </button>
            </div>
            <button
                type="button"
                class="add-proyecto-btn"
                id="add-new-proyecto">
                + Agregar Proyecto
            </button>
        </div>

        <div class="proyecto-section">
            <!-- Header de sección con botón eliminar -->
            <div class="section-header">
                <h3>Proyecto</h3>
                <div class="header-actions">
                    <button
                        type="button"
                        class="delete-btn"
                        id="delete-proyecto"
                        title="Eliminar proyecto actual">
                        🗑️
                    </button>
                </div>
            </div>

            <!-- Sección de Imagen -->
            <div class="image-section">
                <div class="image-header">
                    <h4>Imagen del Proyecto</h4>
                </div>

                <div class="image-upload-area">
                    <div class="image-preview" id="project-image-preview">
                        <div class="placeholder-image">
                            <!-- Círculo negro como en la imagen -->
                            <div class="circle-placeholder"></div>
                        </div>
                    </div>
                    <input
                        type="file"
                        id="project-image-input"
                        accept="image/*"
                        style="display: none;"
                    />
                    <button
                        type="button"
                        class="upload-btn"
                        id="upload-project-image">
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor">
                            <path
                                d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                            ></path>
                            <circle cx="12" cy="13" r="4"></circle>
                        </svg>
                        Subir imagen
                    </button>
                </div>
            </div>

            <!-- Sección de Información -->
            <div class="info-section">
                <!-- Nombre del Proyecto -->
                <div class="field-row">
                    <div class="form-group">
                        <label for="nombre-proyecto">Nombre del Proyecto:</label
                        >
                        <input
                            type="text"
                            id="nombre-proyecto"
                            name="nombreProyecto"
                            class="form-input"
                            placeholder="Ej: E-commerce Platform"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="enlace">Enlace del Proyecto:</label>
                        <input
                            type="url"
                            id="enlace"
                            name="enlace"
                            class="form-input"
                            placeholder="https://mi-proyecto.com"
                        />
                    </div>
                </div>

                <!-- Tecnologías -->
                <div class="field-row">
                    <div class="form-group">
                        <label for="tecnologias">Tecnologías Utilizadas:</label>
                        <input
                            type="text"
                            id="tecnologias"
                            name="tecnologias"
                            class="form-input"
                            placeholder="React, Node.js, MongoDB, etc."
                        />
                    </div>
                    <div class="form-group">
                        <label for="fecha-proyecto">Fecha:</label>
                        <input
                            type="date"
                            id="fecha-proyecto"
                            name="fechaProyecto"
                            class="form-input"
                        />
                    </div>
                </div>

                <!-- Descripción -->
                <div class="field-row">
                    <div class="form-group full-width">
                        <label for="descripcion">Descripción:</label>
                        <textarea
                            id="descripcion"
                            name="descripcion"
                            class="form-textarea"
                            placeholder="Describe el proyecto, sus objetivos, funcionalidades principales..."
                            rows="4"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botón Guardar -->
        <div class="form-actions">
            <button type="button" class="btn-guardar" id="save-proyectos">
                Guardar
            </button>
        </div>
    </form>
</div>

<style>
    .proyectos-form {
        background: white;
        border-radius: 8px;
        padding: 2rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .form-header {
        text-align: center;
        margin-bottom: 2rem;
        border-bottom: 2px solid #3b82f6;
        padding-bottom: 1rem;
    }

    .form-header h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #3b82f6;
        letter-spacing: 0.05em;
    }

    .proyectos-content {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    /* Header con navegación */
    .proyectos-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        background: #f1f5f9;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        margin-bottom: 1rem;
    }

    .nav-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .nav-btn {
        padding: 0.5rem 1rem;
        background: #6366f1;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .nav-btn:hover:not(:disabled) {
        background: #4f46e5;
        transform: translateY(-1px);
    }

    .nav-btn:disabled {
        background: #9ca3af;
        cursor: not-allowed;
        transform: none;
    }

    .nav-info {
        font-weight: 600;
        color: #374151;
        min-width: 60px;
        text-align: center;
    }

    .add-proyecto-btn {
        padding: 0.75rem 1.5rem;
        background: #10b981;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.875rem;
    }

    .add-proyecto-btn:hover {
        background: #059669;
        transform: translateY(-1px);
    }

    /* Header de sección */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e5e7eb;
    }

    .section-header h3 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: #374151;
    }

    .header-actions {
        display: flex;
        gap: 0.5rem;
    }

    .delete-btn {
        padding: 0.5rem;
        background: #ef4444;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.875rem;
    }

    .delete-btn:hover {
        background: #dc2626;
        transform: scale(1.05);
    }

    .delete-btn:disabled {
        background: #9ca3af;
        cursor: not-allowed;
        transform: none;
    }

    .proyecto-section {
        background: #f9fafb;
        border-radius: 8px;
        padding: 1.5rem;
        display: grid;
        grid-template-columns: 250px 1fr;
        gap: 2rem;
        align-items: start;
    }

    /* Sección de Imagen */
    .image-section {
        display: flex;
        flex-direction: column;
    }

    .image-header {
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .image-header h4 {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 600;
        color: #374151;
    }

    .image-upload-area {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .image-preview {
        width: 150px;
        height: 100px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        overflow: hidden;
        position: relative;
        margin-bottom: 1rem;
    }

    .placeholder-image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f3f4f6;
    }

    .circle-placeholder {
        width: 40px;
        height: 40px;
        background: #000;
        border-radius: 50%;
    }

    .upload-btn {
        padding: 0.5rem 1rem;
        background: #6b7280;
        color: white;
        border: none;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        font-size: 0.875rem;
        transition: all 0.2s;
        min-height: 38px;
    }

    .upload-btn:hover:not(:disabled) {
        background: #4b5563;
        transform: translateY(-1px);
    }

    .upload-btn:disabled {
        background: #9ca3af;
        cursor: not-allowed;
        transform: none;
    }

    .loading-spinner {
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    .image-preview img {
        transition: opacity 0.3s ease;
    }

    .image-upload-area {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .image-upload-area:hover .upload-btn {
        background: #4b5563;
    }

    /* Sección de Información */
    .info-section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* Campos de formulario */
    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .field-row:has(.full-width) {
        grid-template-columns: 1fr;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #374151;
        font-size: 0.875rem;
    }

    .form-input,
    .form-textarea {
        padding: 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 0.875rem;
        transition:
            border-color 0.2s,
            box-shadow 0.2s;
        background: white;
        font-family: inherit;
        width: 100%;
    }

    .form-input:focus,
    .form-textarea:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .form-textarea {
        resize: vertical;
        min-height: 100px;
    }

    /* Botón Guardar */
    .form-actions {
        display: flex;
        justify-content: center;
        padding-top: 2rem;
        border-top: 1px solid #e5e7eb;
    }

    .btn-guardar {
        padding: 0.75rem 2rem;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.875rem;
        transition: all 0.2s;
        box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2);
    }

    .btn-guardar:hover {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 4px 8px rgba(59, 130, 246, 0.3);
        transform: translateY(-1px);
    }

    .btn-guardar:disabled {
        background: #9ca3af;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .proyectos-form {
            padding: 1rem;
        }

        .proyectos-header {
            flex-direction: column;
            gap: 1rem;
            align-items: stretch;
        }

        .nav-controls {
            justify-content: center;
        }

        .proyecto-section {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .image-preview {
            width: 120px;
            height: 80px;
        }

        .field-row {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        .nav-btn {
            flex: 1;
            max-width: 120px;
        }

        .btn-guardar {
            width: 100%;
        }
    }
</style>

<script>
    // @ts-nocheck
    import { imageService, ImageUtils } from "../../utils/imgbb.js";
    import { apiClient } from "../../utils/api.js";

    class ProyectosManager {
        constructor() {
            console.log("🏗️ ProyectosManager - Constructor iniciado");
            this.form = document.getElementById("proyectos-form");
            this.isInitialized = false;
            this.proyectos = []; // Array de proyectos
            this.currentProjectIndex = 0; // Índice del proyecto actual
            this.isModified = false; // Flag para cambios sin guardar
            console.log("🔍 ProyectosManager - Form encontrado:", !!this.form);
            this.init();
        }

        init() {
            this.bindEvents();

            // Escuchar cuando se cargan los datos del perfil
            window.addEventListener("profile-data-loaded", (e) => {
                this.populateForm(e.detail);
            });

            // Inicializar con un proyecto vacío si no hay datos
            if (this.proyectos.length === 0) {
                this.proyectos = [this.createEmptyProyecto()];
                this.updateNavigationUI();
                this.loadCurrentProject();
            }
        }

        bindEvents() {
            // Navegación
            document
                .getElementById("prev-proyecto")
                ?.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    this.navigateTo(this.currentProjectIndex - 1);
                });

            document
                .getElementById("next-proyecto")
                ?.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    this.navigateTo(this.currentProjectIndex + 1);
                });

            // Agregar nuevo proyecto
            document
                .getElementById("add-new-proyecto")
                ?.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    this.addNewProject();
                });

            // Eliminar proyecto actual
            document
                .getElementById("delete-proyecto")
                ?.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    this.deleteCurrentProject();
                });

            // Upload de imagen
            const uploadBtn = document.getElementById("upload-project-image");
            const imageInput = document.getElementById("project-image-input");

            console.log("🔍 ProyectoForm - Elementos encontrados:", {
                uploadBtn: !!uploadBtn,
                imageInput: !!imageInput,
            });

            uploadBtn?.addEventListener("click", () => {
                console.log("🖱️ Click en botón de subir imagen de proyecto");
                imageInput?.click();
            });

            imageInput?.addEventListener("change", (e) => {
                console.log(
                    "📁 Archivo seleccionado para proyecto:",
                    e.target.files[0]
                );
                this.handleImageUpload(e);
            });

            // Botón guardar
            document
                .getElementById("save-proyectos")
                ?.addEventListener("click", () => {
                    this.saveSection();
                });

            // Auto-guardado después de cambios
            this.form?.addEventListener("input", () => {
                this.isModified = true;
                clearTimeout(this.autoSaveTimer);
                this.autoSaveTimer = setTimeout(() => {
                    this.autoSave();
                }, 2000);
            });
        }

        createEmptyProyecto() {
            return {
                id: null,
                nombre: "",
                descripcion: "",
                enlace: "",
                tecnologias: "",
                fechaProyecto: "",
                imagen: null,
            };
        }

        addNewProject() {
            // Guardar el proyecto actual antes de cambiar
            this.saveCurrentProject();

            // Agregar nuevo proyecto vacío
            const nuevoProyecto = this.createEmptyProyecto();
            this.proyectos.push(nuevoProyecto);

            // Navegar al nuevo proyecto
            this.navigateTo(this.proyectos.length - 1);

            this.showNotification("Nuevo proyecto agregado", "success");
        }

        async deleteCurrentProject() {
            if (this.proyectos.length <= 1) {
                this.showNotification(
                    "Debe mantener al menos un proyecto",
                    "warning"
                );
                return;
            }

            const proyectoActual = this.proyectos[this.currentProjectIndex];

            if (
                !confirm(
                    `¿Está seguro de eliminar el proyecto "${proyectoActual.nombre || "Sin nombre"}"?`
                )
            ) {
                return;
            }

            try {
                // Si tiene ID, eliminar del servidor
                if (proyectoActual.id) {
                    const response = await apiClient.delete(
                        `/perfil/proyecto/${proyectoActual.id}`
                    );

                    if (!response.success) {
                        throw new Error(
                            response.error || "Error al eliminar proyecto"
                        );
                    }
                }

                // Eliminar del array local
                this.proyectos.splice(this.currentProjectIndex, 1);

                // Ajustar índice actual
                if (this.currentProjectIndex >= this.proyectos.length) {
                    this.currentProjectIndex = this.proyectos.length - 1;
                }

                this.updateNavigationUI();
                this.loadCurrentProject();

                this.showNotification("Proyecto eliminado", "success");
            } catch (error) {
                console.error("Error eliminando proyecto:", error);
                this.showNotification("Error al eliminar el proyecto", "error");
            }
        }

        navigateTo(newIndex) {
            if (newIndex < 0 || newIndex >= this.proyectos.length) return;

            // Guardar el proyecto actual antes de cambiar
            this.saveCurrentProject();

            this.currentProjectIndex = newIndex;
            this.loadCurrentProject();
            this.updateNavigationUI();
        }

        saveCurrentProject() {
            if (!this.isModified) return;

            const formData = this.getCurrentProjectData();
            this.proyectos[this.currentProjectIndex] = {
                ...this.proyectos[this.currentProjectIndex],
                ...formData,
            };

            this.isModified = false;
        }

        loadCurrentProject() {
            if (this.proyectos.length === 0) {
                console.warn("No hay proyectos para cargar");
                return;
            }

            const proyecto = this.proyectos[this.currentProjectIndex] || {};
            console.log("Cargando proyecto:", proyecto);

            // Poblar campos del formulario
            const nombreInput = document.getElementById("nombre-proyecto");
            const descripcionInput = document.getElementById("descripcion");
            const enlaceInput = document.getElementById("enlace");
            const tecnologiasInput = document.getElementById("tecnologias");
            const fechaInput = document.getElementById("fecha-proyecto");

            if (nombreInput) nombreInput.value = proyecto.nombre || "";
            if (descripcionInput)
                descripcionInput.value = proyecto.descripcion || "";
            if (enlaceInput) enlaceInput.value = proyecto.enlace || "";
            if (tecnologiasInput)
                tecnologiasInput.value = proyecto.tecnologias || "";
            if (fechaInput) fechaInput.value = proyecto.fechaProyecto || "";

            // Cargar imagen del proyecto
            this.loadProjectImage();
            this.isModified = false;
        }

        updateNavigationUI() {
            const prevBtn = document.getElementById("prev-proyecto");
            const nextBtn = document.getElementById("next-proyecto");
            const counter = document.getElementById("proyecto-counter");
            const deleteBtn = document.getElementById("delete-proyecto");

            if (prevBtn) prevBtn.disabled = this.currentProjectIndex === 0;
            if (nextBtn)
                nextBtn.disabled =
                    this.currentProjectIndex === this.proyectos.length - 1;

            if (counter) {
                counter.textContent = `${this.currentProjectIndex + 1} / ${this.proyectos.length}`;
            }

            if (deleteBtn) {
                deleteBtn.disabled = this.proyectos.length <= 1;
            }
        }

        async handleImageUpload(e) {
            const file = e.target.files[0];
            console.log("🚀 ProyectoForm - handleImageUpload iniciado:", {
                file,
            });

            if (!file) {
                console.log("❌ No se seleccionó archivo");
                return;
            }

            try {
                // Mostrar loading en el botón
                const uploadBtn = document.getElementById(
                    "upload-project-image"
                );
                if (uploadBtn) {
                    uploadBtn.disabled = true;
                    uploadBtn.innerHTML = `
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="loading-spinner">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M16 12a4 4 0 0 1-8 0"></path>
                        </svg>
                        Subiendo...
                    `;
                }

                // Validar imagen antes de subir
                await imageService.validateImage(file);

                // Crear preview inmediato
                const previewUrl = await imageService.createPreview(file);
                this.updateImagePreview(previewUrl);

                // Comprimir imagen si es muy grande
                let processedFile = file;
                if (file.size > 1024 * 1024) {
                    // Si es mayor a 1MB
                    processedFile = await ImageUtils.compressImage(file, {
                        maxWidth: 1200,
                        maxHeight: 800,
                        quality: 0.8,
                    });
                    console.log(
                        `Imagen del proyecto comprimida: ${Math.round(file.size / 1024)}KB → ${Math.round(processedFile.size / 1024)}KB`
                    );
                }

                // Subir a ImgBB
                const uploadResult = await imageService.uploadImage(
                    processedFile,
                    {
                        name: `proyecto_${Date.now()}`,
                    }
                );

                if (uploadResult.success) {
                    // Actualizar imagen con la URL de ImgBB
                    const imageUrl = uploadResult.url;

                    this.updateImagePreview(imageUrl);

                    // Guardar URL en el proyecto actual
                    this.proyectos[this.currentProjectIndex].imagen =
                        uploadResult.url;
                    this.isModified = true;

                    this.showNotification(
                        "Imagen del proyecto subida correctamente",
                        "success"
                    );

                    console.log("Imagen del proyecto subida a ImgBB:", {
                        id: uploadResult.id,
                        url: uploadResult.url,
                        thumbnailUrl: uploadResult.thumbnailUrl,
                    });
                } else {
                    throw new Error("Error en la subida a ImgBB");
                }
            } catch (error) {
                console.error("Error subiendo imagen del proyecto:", error);

                let errorMessage = "Error al subir la imagen del proyecto";
                if (error.message.includes("Tipo de archivo")) {
                    errorMessage = "Solo se permiten imágenes JPEG, PNG o WebP";
                } else if (error.message.includes("demasiado grande")) {
                    errorMessage = "La imagen es demasiado grande (máximo 5MB)";
                } else if (error.message.includes("píxeles")) {
                    errorMessage =
                        "La imagen debe ser de al menos 100x100 píxeles";
                }

                this.showNotification(errorMessage, "error");

                // Revertir preview si falló la subida
                this.loadProjectImage();
            } finally {
                // Restaurar botón
                const uploadBtn = document.getElementById(
                    "upload-project-image"
                );
                if (uploadBtn) {
                    uploadBtn.disabled = false;
                    uploadBtn.innerHTML = `
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                            <circle cx="12" cy="13" r="4"></circle>
                        </svg>
                        Subir imagen
                    `;
                }
            }
        }

        updateImagePreview(imageUrl) {
            const preview = document.getElementById("project-image-preview");
            if (preview && imageUrl) {
                preview.innerHTML = `
                    <img 
                        src="${imageUrl}" 
                        alt="Proyecto" 
                        style="width: 100%; height: 100%; object-fit: cover; border-radius: 6px; opacity: 0; transition: opacity 0.3s;"
                        onload="this.style.opacity = '1'"
                    />
                `;
            } else if (preview) {
                // Mostrar placeholder si no hay imagen
                preview.innerHTML = `
                    <div class="placeholder-image">
                        <div class="circle-placeholder"></div>
                    </div>
                `;
            }
        }

        loadProjectImage() {
            let imageUrl = null;

            // Si hay imagen actual del proyecto, usarla
            const proyectoActual = this.proyectos[this.currentProjectIndex];
            if (proyectoActual && proyectoActual.imagen) {
                // ImgBB devuelve URLs directas
                imageUrl = proyectoActual.imagen;
            }

            this.updateImagePreview(imageUrl);
        }

        populateForm(profileData) {
            if (!profileData || this.isInitialized) return;

            console.log("Poblando proyectos", profileData);

            // Buscar proyectos en los datos del perfil
            const data = profileData.data || profileData;

            console.log("🔍 [ProyectoForm] Buscando proyectos en:", data);
            console.log(
                "🔍 [ProyectoForm] Proyectos encontrados:",
                data.proyectos
            );

            // Los proyectos están directamente en data.proyectos
            if (data.proyectos && Array.isArray(data.proyectos)) {
                this.proyectos = data.proyectos.map((p) => ({
                    id: p.id || null,
                    nombre: p.nombre || "",
                    descripcion: p.descripcion || "",
                    enlace: p.enlace || "",
                    tecnologias: p.tecnologias || "",
                    fechaProyecto: p.fechaProyecto || "",
                    imagen: p.imagen || null,
                }));

                console.log(
                    "✅ [ProyectoForm] Proyectos cargados:",
                    this.proyectos.length
                );
            } else {
                // Fallback: buscar en la estructura antigua por compatibilidad
                const perfil = data.perfil || {};
                if (perfil.proyectos && Array.isArray(perfil.proyectos)) {
                    this.proyectos = perfil.proyectos.map((p) => ({
                        id: p.id || null,
                        nombre: p.nombre || "",
                        descripcion: p.descripcion || "",
                        enlace: p.enlace || "",
                        tecnologias: p.tecnologias || "",
                        fechaProyecto: p.fechaProyecto || "",
                        imagen: p.imagen || null,
                    }));
                } else if (
                    perfil.urlImagenProyecto ||
                    perfil.nombreProyecto ||
                    perfil.descripcionProyecto
                ) {
                    // Proyecto único en campos individuales
                    this.proyectos = [
                        {
                            id: null,
                            nombre: perfil.nombreProyecto || "",
                            descripcion: perfil.descripcionProyecto || "",
                            enlace: perfil.enlaceProyecto || "",
                            tecnologias: perfil.tecnologiasProyecto || "",
                            fechaProyecto: perfil.fechaProyecto || "",
                            imagen: perfil.urlImagenProyecto || null,
                        },
                    ];
                }
            }

            // Si no hay proyectos, mantener uno vacío
            if (this.proyectos.length === 0) {
                this.proyectos = [this.createEmptyProyecto()];
            }

            this.currentProjectIndex = 0;
            this.updateNavigationUI();
            this.loadCurrentProject();

            this.isInitialized = true;
        }

        getCurrentProjectData() {
            const nombreInput = document.getElementById("nombre-proyecto");
            const descripcionInput = document.getElementById("descripcion");
            const enlaceInput = document.getElementById("enlace");
            const tecnologiasInput = document.getElementById("tecnologias");
            const fechaInput = document.getElementById("fecha-proyecto");

            return {
                nombre: nombreInput?.value || "",
                descripcion: descripcionInput?.value || "",
                enlace: enlaceInput?.value || "",
                tecnologias: tecnologiasInput?.value || "",
                fechaProyecto: fechaInput?.value || "",
                // La imagen se maneja por separado
            };
        }

        getFormData() {
            // Guardar datos del proyecto actual
            this.saveCurrentProject();

            // Devolver datos para la API
            return {
                proyectos: this.proyectos,
                // Compatibilidad con campos individuales por si la API los espera
                nombreProyecto: this.proyectos[0]?.nombre || "",
                descripcionProyecto: this.proyectos[0]?.descripcion || "",
                enlaceProyecto: this.proyectos[0]?.enlace || "",
                tecnologiasProyecto: this.proyectos[0]?.tecnologias || "",
                fechaProyecto: this.proyectos[0]?.fechaProyecto || "",
                urlImagenProyecto: this.proyectos[0]?.imagen || null,
            };
        }

        async saveSection() {
            try {
                const btn = document.getElementById("save-proyectos");
                if (btn) {
                    btn.disabled = true;
                    btn.textContent = "Guardando...";
                }

                const data = this.getFormData();

                // Emitir evento para que el controlador principal maneje el guardado
                window.dispatchEvent(
                    new CustomEvent("save-section-data", {
                        detail: { section: "proyectos", data },
                    })
                );

                this.showNotification("Proyectos guardados", "success");

                // Completado el perfil - mostrar mensaje final
                setTimeout(() => {
                    this.showNotification(
                        "¡Perfil completado exitosamente!",
                        "success"
                    );
                }, 500);
            } catch (error) {
                console.error("Error guardando proyectos:", error);
                this.showNotification(
                    "Error al guardar los proyectos",
                    "error"
                );
            } finally {
                const btn = document.getElementById("save-proyectos");
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = "Guardar";
                }
            }
        }

        async autoSave() {
            try {
                this.saveCurrentProject();

                // Solo auto-guardar proyectos que ya tienen ID
                const proyectosConId = this.proyectos.filter(
                    (proyecto) => proyecto.id && proyecto.nombre
                );

                for (const proyecto of proyectosConId) {
                    await apiClient.put(`/perfil/proyecto/${proyecto.id}`, {
                        nombre: proyecto.nombre,
                        descripcion: proyecto.descripcion || null,
                        enlace: proyecto.enlace || null,
                        tecnologias: proyecto.tecnologias || null,
                        fechaProyecto: proyecto.fechaProyecto || null,
                        imagen: proyecto.imagen || null,
                    });
                }

                console.log("Auto-guardado de proyectos completado");
            } catch (error) {
                console.error("Error en auto-guardado de proyectos:", error);
            }
        }

        showNotification(message, type) {
            // Reutilizar el sistema de notificaciones del componente principal
            window.dispatchEvent(
                new CustomEvent("show-notification", {
                    detail: { message, type },
                })
            );
        }
    }

    // Inicializar cuando el DOM esté listo
    document.addEventListener("DOMContentLoaded", () => {
        console.log("🎬 ProyectoForm - Inicializando ProyectosManager");
        window.proyectosManager = new ProyectosManager();
        console.log("✅ ProyectoForm - ProyectosManager inicializado");
    });
</script>
