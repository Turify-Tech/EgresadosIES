---
export interface Props {
    title: string;
    description?: string;
}

const { title, description = "Sistema de Gestión de Egresados del IES" } =
    Astro.props;

// Importar estilos CSS
import "../styles/global.css";
import "../styles/components.css";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title} | IES Egresados</title>

        <!-- Fuentes y estilos -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <!-- Header -->
        <header class="header">
            <nav class="container nav flex justify-between items-center">
                <!-- Logo -->
                <div>
                    <a href="/" class="flex items-center gap-sm">
                        <div class="logo flex items-center justify-center">
                            <span>IES</span>
                        </div>
                        <span class="text-xl font-semibold text-gray-900"
                            >Egresados</span
                        >
                    </a>
                </div>

                <!-- Navegación Desktop -->
                <div class="md-flex items-center gap-lg md-hidden">
                    <a href="/" class="nav-link">Inicio</a>
                    <a href="/acceso" class="btn btn-primary">Ingresar</a>
                </div>

                <!-- Menú móvil -->
                <div class="mobile-menu">
                    <button id="mobile-menu-button" class="nav-link">
                        <svg
                            width="24"
                            height="24"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <!-- Menú móvil desplegable -->
            <div id="mobile-menu" class="hidden container">
                <div class="flex flex-col gap-sm p-md">
                    <a href="/" class="nav-link">Inicio</a>
                    <a href="/acceso" class="btn btn-primary">Ingresar</a>
                </div>
            </div>
        </header>
    </body>

    <!-- Contenido principal -->
    <main class="flex-1">
        <slot />
    </main>

    <!-- Footer -->
    <footer
        style="background-color: var(--color-gray-900); color: var(--color-white); margin-top: auto;">
        <div class="container p-xl">
            <div class="text-center">
                <h3 class="text-lg font-semibold mb-md">
                    Instituto de Educación Superior
                </h3>
                <p
                    style="color: var(--color-gray-300); margin-bottom: var(--spacing-lg);">
                    Sistema de Egresados - Conectando nuestra comunidad
                    educativa
                </p>
                <p style="color: var(--color-gray-400);">
                    &copy; 2025 Instituto de Educación Superior. Todos los
                    derechos reservados.
                </p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // Toggle menú móvil
        document
            .getElementById("mobile-menu-button")
            ?.addEventListener("click", () => {
                const menu = document.getElementById("mobile-menu");
                menu?.classList.toggle("hidden");
            });
    </script>
</html>
