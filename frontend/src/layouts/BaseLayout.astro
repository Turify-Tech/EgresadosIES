---
export interface Props {
    title: string;
    description?: string;
    hideAccederButton?: boolean;
}

const { title, description = "Sistema de Gestión de Egresados del IES", hideAccederButton = false } =
    Astro.props;

// Importar estilos CSS
import "../styles/global.css";
import "../styles/components.css";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title} | IES Egresados</title>

        <!-- Fuentes y estilos -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Pontano+Sans:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <!-- Header -->
        <header style="background-color: #E6E6E6; padding: 1rem 2rem;">
            <div style="max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <img src="/images/logo.png" alt="Logo" style="width: 50px; height: auto;" />
                    <h1 style="margin: 0; font-family: 'Inter', sans-serif; font-weight: 700; font-size: 2rem; color: #1a1a1a;">
                        EgresadosIES
                    </h1>
                </div>
                {!hideAccederButton && (
                    <a href="/acceso" id="acceder-btn" style="background: #5284e0; color: white; padding: 0.625rem 1.75rem; border-radius: 25px; text-decoration: none; font-family: 'Pontano Sans', sans-serif; font-weight: 700; font-size: 0.95rem; transition: background 0.3s ease;">
                        Acceder
                    </a>
                )}
            </div>
        </header>
    </body>

    <!-- Contenido principal -->
    <main class="flex-1">
        <slot />
    </main>

    <!-- Footer -->
    <footer
        style="background-color: var(--color-gray-900); color: var(--color-white); margin-top: auto;">
        <div class="container p-xl">
            <div class="text-center">
                <h3 class="text-lg font-semibold mb-md">
                    Instituto de Educación Superior
                </h3>
                <p
                    style="color: var(--color-gray-300); margin-bottom: var(--spacing-lg);">
                    Sistema de Egresados - Conectando nuestra comunidad
                    educativa
                </p>
                <p style="color: var(--color-gray-400);">
                    &copy; 2025 Instituto de Educación Superior. Todos los
                    derechos reservados.
                </p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // Check if user is authenticated and hide "Acceder" button
        const accederBtn = document.getElementById('acceder-btn') as HTMLElement;
        const token = localStorage.getItem('token');
        
        if (token && accederBtn) {
            accederBtn.style.display = 'none';
        }
        
        // Hover effect for acceder button (only if visible)
        if (accederBtn && !token) {
            accederBtn.addEventListener('mouseenter', () => {
                accederBtn.style.background = '#3d6fc7';
                accederBtn.style.boxShadow = '0 4px 12px rgba(82, 132, 224, 0.3)';
            });
            accederBtn.addEventListener('mouseleave', () => {
                accederBtn.style.background = '#5284e0';
                accederBtn.style.boxShadow = 'none';
            });
        }
    </script>
</html>
