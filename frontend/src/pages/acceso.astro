---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Acceso - EgresadosIES" hideAccederButton={true}>
  <div class="acceso-container">
    <div class="acceso-card">
      <div class="card-header">
        <div class="card-bg"></div>
      </div>

      <div class="card-body">
        <h2 class="acceso-title">Acceder</h2>
        
        <form id="acceso-form">
          <div class="form-group">
            <label for="dni">DNI</label>
            <input 
              type="text" 
              id="dni"
              name="dni" 
              required 
              inputmode="numeric"
              maxlength="8"
              placeholder="" 
              autocomplete="username"
            />
          </div>

          <div class="form-group">
            <label for="password">Contraseña</label>
            <div class="password-input-wrapper">
              <input 
                type="password" 
                id="password"
                name="password" 
                required 
                placeholder=""
                autocomplete="current-password"
              />
              <button type="button" id="toggle-password" class="toggle-password-btn" aria-label="Mostrar contraseña">
                <svg id="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg id="eye-off-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="display:none;">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                  <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" id="acceso-btn" class="btn-iniciar">
            Iniciar
          </button>

          <div id="acceso-loading" class="loading-msg" style="display:none;">
            Validando...
          </div>
          <div id="acceso-error" class="error-msg" style="display:none;"></div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .acceso-container {
    min-height: auto;
    height: calc(100vh - 82px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 75px 1rem 1rem;
    background-image: url('/images/Imagen de Fondo.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    overflow: auto;
  }

  .acceso-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    width: 100%;
    max-width: 440px;
    overflow: hidden;
    margin: 0 auto;
  }

  .card-header {
    position: relative;
    height: 70px;
    background: linear-gradient(135deg, #2196F3 0%, #1976D2 50%, #0D47A1 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-bg {
    position: absolute;
    top: -100%;
    right: -30%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(100, 181, 246, 0.4) 0%, transparent 60%);
    border-radius: 50%;
  }

  .card-bg::before {
    content: '';
    position: absolute;
    top: 80%;
    left: -50%;
    width: 300px;
    height: 300px;
    background: rgba(33, 150, 243, 0.3);
    border-radius: 50%;
  }

  .card-bg::after {
    content: '';
    position: absolute;
    top: 20%;
    right: 40%;
    width: 150px;
    height: 150px;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(255, 255, 255, 0.03) 10px,
      rgba(255, 255, 255, 0.03) 20px
    );
  }

  .sistema-text {
    position: relative;
    z-index: 10;
    margin: 0;
    color: rgba(255,255,255,0.9);
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  .card-body {
    padding: 2rem 2rem 1.75rem;
  }

  .acceso-title {
    text-align: center;
    color: #1565c0;
    font-family: 'Inter', sans-serif;
    font-weight: bold;
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 1rem 0;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: #333;
    font-size: 1rem;
    font-weight: 700;
    font-family: 'Pontano Sans', sans-serif;
  }

  .form-group input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid #000000;
    border-radius: 20px;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .form-group input:focus {
    outline: none;
    border-color: #1565c0;
    box-shadow: 0 0 0 3px rgba(21, 101, 192, 0.1);
  }

  .password-input-wrapper {
    position: relative;
    width: 100%;
  }

  .password-input-wrapper input {
    padding-right: 3rem;
  }

  .toggle-password-btn {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    transition: color 0.2s ease;
  }

  .toggle-password-btn:hover {
    color: #1565c0;
  }

  .toggle-password-btn svg {
    width: 20px;
    height: 20px;
    stroke-width: 2;
  }

  .btn-iniciar {
    width: auto;
    min-width: 180px;
    padding: 0.75rem 3rem;
    background: #5284e0;
    color: white;
    border: none;
    border-radius: 25px;
    font-size: 1rem;
    font-weight: 700;
    font-family: 'Pontano Sans', sans-serif;
    cursor: pointer;
    transition: all 0.3s ease;
    margin: 1rem auto 0;
    display: block;
  }

  .btn-iniciar:hover {
    background: #3d6fc7;
    box-shadow: 0 4px 12px rgba(82, 132, 224, 0.3);
  }

  .btn-iniciar:active {
    transform: translateY(1px);
  }

  .btn-iniciar:disabled {
    background: #a5c1e8;
    cursor: not-allowed;
    box-shadow: none;
  }

  .loading-msg {
    text-align: center;
    color: #1565c0;
    margin-top: 0.75rem;
    font-size: 0.85rem;
  }

  .error-msg {
    text-align: center;
    color: #d32f2f;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    padding: 0.6rem;
    background: #ffebee;
    border-radius: 6px;
  }

  @media (max-width: 480px) {
    .acceso-container {
      padding: 1rem;
    }

    .acceso-header {
      margin-bottom: 1.5rem;
    }

    .logo {
      width: 50px;
    }

    .header-text h1 {
      font-size: 1.5rem;
    }

    .card-body {
      padding: 2rem 1.5rem 1.5rem;
    }

    .acceso-title {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  const form = document.getElementById('acceso-form') as HTMLFormElement;
  const btn = document.getElementById('acceso-btn') as HTMLButtonElement;
  const loading = document.getElementById('acceso-loading') as HTMLElement;
  const errorMsg = document.getElementById('acceso-error') as HTMLElement;
  const togglePasswordBtn = document.getElementById('toggle-password') as HTMLButtonElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const dniInput = document.getElementById('dni') as HTMLInputElement;
  const eyeIcon = document.getElementById('eye-icon') as HTMLElement;
  const eyeOffIcon = document.getElementById('eye-off-icon') as HTMLElement;

  // Validar que solo se ingresen números en el DNI
  dniInput.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    target.value = target.value.replace(/[^0-9]/g, '');
  });

  // Toggle password visibility
  togglePasswordBtn.addEventListener('click', () => {
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';
    eyeIcon.style.display = isPassword ? 'none' : 'block';
    eyeOffIcon.style.display = isPassword ? 'block' : 'none';
    togglePasswordBtn.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.style.display = 'none';
    
    const dni = dniInput.value.trim();
    const password = passwordInput.value;

    // Validación del DNI
    if (dni.length < 7 || dni.length > 8 || !/^\d+$/.test(dni)) {
      errorMsg.textContent = 'El DNI debe tener 7 u 8 dígitos numéricos';
      errorMsg.style.display = 'block';
      return;
    }

    loading.style.display = 'block';
    btn.disabled = true;

    try {
      const res = await fetch('http://localhost:3000/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ dni, password })
      });

      const data = await res.json();

      if (data.success && data.token) {
        localStorage.setItem('token', data.token);
        localStorage.setItem('user', JSON.stringify({
          dni: data.dni,
          tipoUsuario: data.tipoUsuario,
          email: data.email
        }));

        // Redirección según tipo de usuario
        if (data.tipoUsuario === 'administrador') {
          window.location.href = '/admin';
        } else if (data.isNewUser) {
          window.location.href = '/completar-perfil';
        } else {
          window.location.href = '/dashboard';
        }
      } else {
        errorMsg.textContent = data.message || 'Credenciales incorrectas';
        errorMsg.style.display = 'block';
      }
    } catch (err) {
      errorMsg.textContent = 'Error de conexión con el servidor';
      errorMsg.style.display = 'block';
    } finally {
      loading.style.display = 'none';
      btn.disabled = false;
    }
  });
</script>
