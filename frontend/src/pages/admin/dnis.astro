---
import "../../styles/admin.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CargaExcel from "../../components/admin/CargaExcel.astro";
import AgregarDni from "../../components/admin/AgregarDni.astro";
import TablaDnis from "../../components/admin/TablaDnis.astro";
---

<BaseLayout title="Gestión de DNIs - Admin" hideAccederButton={true}>
    <div class="dnis-page">
        <div class="page-container">
            <!-- Header -->
            <header class="page-header">
                <div class="header-content">
                    <div class="header-title">
                        <svg
                            width="28"
                            height="28"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                            ></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        <div>
                            <h1>Gestión de DNIs Válidos</h1>
                            <p class="subtitle">
                                Administra los DNIs autorizados para registro en
                                el sistema
                            </p>
                        </div>
                    </div>
                    <div class="header-actions">
                        <a href="/admin" class="btn-back">
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <polyline points="15 18 9 12 15 6"></polyline>
                            </svg>
                            Volver
                        </a>
                    </div>
                </div>
            </header>

            <!-- Layout de dos columnas -->
            <div class="content-layout">
                <!-- Columna izquierda - Formularios -->
                <aside class="sidebar-forms">
                    <CargaExcel />
                    <AgregarDni />
                </aside>

                <!-- Columna derecha - Tabla -->
                <main class="main-content">
                    <TablaDnis />
                </main>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .dnis-page {
        background: #f5f5f5;
        min-height: 100vh;
        padding: 2rem 1rem;
    }

    .dnis-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Header */
    .page-header {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .header-title svg {
        color: var(--color-primary);
        flex-shrink: 0;
    }

    .header-title h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .subtitle {
        margin: 0.25rem 0 0 0;
        font-size: 0.9375rem;
        color: #666;
    }

    .header-actions {
        display: flex;
        gap: 0.75rem;
    }

    .btn-back {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        background: var(--color-gray-100);
        color: var(--color-gray-700);
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9375rem;
        transition: all 0.2s ease;
    }

    .btn-back:hover {
        background: var(--color-gray-200);
        color: var(--color-gray-900);
    }

    /* Layout */
    .content-layout {
        display: grid;
        grid-template-columns: 400px 1fr;
        gap: 2rem;
        align-items: start;
    }

    .sidebar-forms {
        position: sticky;
        top: 100px;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .main-content {
        min-height: 500px;
    }

    /* Responsive */
    @media (max-width: 1200px) {
        .content-layout {
            grid-template-columns: 350px 1fr;
        }
    }

    @media (max-width: 992px) {
        .content-layout {
            grid-template-columns: 1fr;
        }

        .sidebar-forms {
            position: static;
        }
    }

    @media (max-width: 768px) {
        .dnis-page {
            padding: 1rem;
        }

        .page-header {
            padding: 1.5rem;
        }

        .header-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-title {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-title h1 {
            font-size: 1.5rem;
        }

        .content-layout {
            gap: 1.5rem;
        }
    }
</style>

<script>
    const API_URL = window.API_URL || "http://localhost:3000/api";

    // Verificar que el usuario sea administrador
    async function verificarAdmin() {
        try {
            const token = localStorage.getItem("auth_token");
            if (!token) {
                window.location.href = "/acceso";
                return;
            }

            // Verificar permisos de administrador
            const response = await fetch(`${API_URL}/admin/dnis?limit=1`, {
                method: "GET",
                headers: {
                    Authorization: `Bearer ${token}`,
                },
            });

            if (response.status === 403) {
                alert("No tienes permisos de administrador");
                window.location.href = "/";
                return;
            }

            if (response.status === 401) {
                localStorage.removeItem("token");
                window.location.href = "/acceso";
                return;
            }

            if (!response.ok) {
                throw new Error("Error verificando permisos");
            }
        } catch (error) {
            console.error("Error verificando permisos:", error);
            alert("Error de conexión. Por favor intenta nuevamente.");
            window.location.href = "/acceso";
        }
    }

    // Inicializar
    document.addEventListener("DOMContentLoaded", verificarAdmin);
</script>
