---
import "../../styles/admin.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EstadisticasAdmin from "../../components/admin/EstadisticasAdmin.astro";
---

<BaseLayout title="Panel de Administración" hideAccederButton={true}>
    <div class="admin-page">
            <!-- Header -->
            <header class="admin-header-full">
                <div class="header-content">
                    <div class="header-title">
                        <div>
                            <h1>Panel de Administración</h1>
                        </div>
                    </div>
                    <div class="header-actions">
                        <a href="/" class="btn-back">
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                                ></path>
                                <polyline points="9 22 9 12 15 12 15 22"
                                ></polyline>
                            </svg>
                            Ir al Inicio
                        </a>
                    </div>
                </div>
            </header>

        <div class="admin-container">
            <!-- Estadísticas -->
            <section class="stats-section">
                <EstadisticasAdmin />
            </section>

            <!-- Tarjetas de acceso rápido -->
            <section class="quick-access">
                <h2 class="section-title">Acceso Rápido</h2>
                <div class="cards-grid">
                    <a href="/admin/dnis" class="access-card">
                        <div class="card-icon blue">
                            <svg
                                width="28"
                                height="28"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                <path d="M7 8h5"></path>
                                <path d="M7 12h3"></path>
                                <circle cx="16" cy="11" r="2"></circle>
                            </svg>
                        </div>
                        <div class="card-content">
                            <h3>Gestión de DNIs</h3>
                            <p>
                                Administrar DNIs válidos, carga masiva y CRUD
                                individual
                            </p>
                        </div>
                        <div class="card-arrow">
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </div>
                    </a>

                    <div class="access-card disabled">
                        <div class="card-icon gray">
                            <svg
                                width="28"
                                height="28"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <div class="card-content">
                            <h3>Gestión de Usuarios</h3>
                            <p>Administrar egresados y validar registros</p>
                            <span class="badge-pronto">Próximamente</span>
                        </div>
                    </div>

                    <div class="access-card disabled">
                        <div class="card-icon gray">
                            <svg
                                width="28"
                                height="28"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path d="M3 3v18h18"></path>
                                <path d="M18 17V9"></path>
                                <path d="M13 17v-5"></path>
                                <path d="M8 17v-3"></path>
                            </svg>
                        </div>
                        <div class="card-content">
                            <h3>Reportes</h3>
                            <p>Estadísticas y análisis del sistema</p>
                            <span class="badge-pronto">Próximamente</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Actividad reciente -->
            <section class="activity-section">
                <h2 class="section-title">Actividad Reciente</h2>
                <div class="activity-card">
                    <!-- Estado de carga -->
                    <div id="actividad-loading" class="activity-loading" style="display: none;">
                        <div class="spinner"></div>
                        <p>Cargando actividades...</p>
                    </div>

                    <!-- Estado de error -->
                    <div id="actividad-error" class="activity-error" style="display: none;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <p id="actividad-error-mensaje">Error al cargar actividades</p>
                        <button id="actividad-retry" class="btn-retry">Reintentar</button>
                    </div>

                    <!-- Estado vacío -->
                    <div id="actividad-vacio" class="activity-empty" style="display: none;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                            <path d="M9 9h6v6H9z"></path>
                        </svg>
                        <p>No hay actividades recientes</p>
                        <span class="activity-hint">Las acciones que realices aparecerán aquí</span>
                    </div>

                    <!-- Lista de actividades -->
                    <div id="actividad-lista" class="activity-list" style="display: none;">
                        <!-- Se llenarán dinámicamente desde JavaScript -->
                    </div>
                </div>
            </section>
        </div>
    </div>
</BaseLayout>

<script>
    import { 
        obtenerActividadesRecientes, 
        formatearFechaActividad, 
        obtenerIconoAccion,
        obtenerColorAccion 
    } from "../../utils/actividadesAdminApi.js";

    const API_URL = "http://localhost:3000/api";

    // Verificar que el usuario sea administrador
    async function verificarAdmin() {
        try {
            const token = localStorage.getItem("auth_token");
            if (!token) {
                window.location.href = "/acceso";
                return;
            }

            // Verificar token y rol
            const response = await fetch(`${API_URL}/admin/dnis`, {
                method: "GET",
                headers: {
                    Authorization: `Bearer ${token}`,
                },
            });

            if (response.status === 403 || response.status === 401) {
                alert("No tienes permisos de administrador");
                window.location.href = "/dashboard";
                return;
            }

            // Cargar estadísticas y actividades en paralelo
            await Promise.all([
                cargarEstadisticas(),
                cargarActividadesRecientes()
            ]);
        } catch (error) {
            console.error("Error verificando permisos:", error);
            window.location.href = "/acceso";
        }
    }

    // Estado de paginación
    let paginaActual = 1;
    const actividadesPorPagina = 5;
    let todasLasActividades = [];

    /**
     * Carga las actividades recientes del administrador
     */
    async function cargarActividadesRecientes() {
        const loadingEl = document.getElementById("actividad-loading");
        const errorEl = document.getElementById("actividad-error");
        const vacioEl = document.getElementById("actividad-vacio");
        const listaEl = document.getElementById("actividad-lista");

        try {
            // Mostrar loading
            loadingEl.style.display = "flex";
            errorEl.style.display = "none";
            vacioEl.style.display = "none";
            listaEl.style.display = "none";

            // Obtener todas las actividades (límite alto para tener suficientes para paginar)
            todasLasActividades = await obtenerActividadesRecientes(50);

            // Ocultar loading
            loadingEl.style.display = "none";

            // Verificar si hay actividades
            if (!todasLasActividades || todasLasActividades.length === 0) {
                vacioEl.style.display = "flex";
                return;
            }

            // Renderizar primera página
            renderizarActividades();
            listaEl.style.display = "block";

        } catch (error) {
            console.error("Error cargando actividades:", error);
            
            // Mostrar error
            loadingEl.style.display = "none";
            errorEl.style.display = "flex";
            
            const errorMensaje = document.getElementById("actividad-error-mensaje");
            errorMensaje.textContent = error.message || "Error al cargar actividades";
        }
    }

    /**
     * Renderiza las actividades de la página actual
     */
    function renderizarActividades() {
        const listaEl = document.getElementById("actividad-lista");
        const inicio = (paginaActual - 1) * actividadesPorPagina;
        const fin = inicio + actividadesPorPagina;
        const actividadesPagina = todasLasActividades.slice(inicio, fin);
        const totalPaginas = Math.ceil(todasLasActividades.length / actividadesPorPagina);

        // Renderizar actividades
        const actividadesHTML = actividadesPagina.map(actividad => `
            <div class="activity-item" data-tipo="${actividad.tipoAccion}">
                <div class="activity-icon ${obtenerColorAccion(actividad.tipoAccion)}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        ${obtenerIconoAccion(actividad.tipoAccion)}
                    </svg>
                </div>
                <div class="activity-content">
                    <p>${actividad.descripcion}</p>
                    <span class="activity-time">${formatearFechaActividad(actividad.fechaCreacion)}</span>
                </div>
            </div>
        `).join('');

        // Renderizar controles de paginación si hay más de una página
        const paginacionHTML = totalPaginas > 1 ? `
            <div class="activity-pagination">
                <button 
                    class="pagination-btn" 
                    id="btn-anterior" 
                    ${paginaActual === 1 ? 'disabled' : ''}
                >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                    Anterior
                </button>
                <span class="pagination-info">
                    Página ${paginaActual} de ${totalPaginas}
                </span>
                <button 
                    class="pagination-btn" 
                    id="btn-siguiente" 
                    ${paginaActual === totalPaginas ? 'disabled' : ''}
                >
                    Siguiente
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>
            </div>
        ` : '';

        listaEl.innerHTML = actividadesHTML + paginacionHTML;

        // Agregar event listeners a los botones de paginación
        if (totalPaginas > 1) {
            const btnAnterior = document.getElementById('btn-anterior');
            const btnSiguiente = document.getElementById('btn-siguiente');

            btnAnterior?.addEventListener('click', () => {
                if (paginaActual > 1) {
                    paginaActual--;
                    renderizarActividades();
                }
            });

            btnSiguiente?.addEventListener('click', () => {
                if (paginaActual < totalPaginas) {
                    paginaActual++;
                    renderizarActividades();
                }
            });
        }
    }

    async function cargarEstadisticas() {
        try {
            const token = localStorage.getItem("auth_token");

            // Obtener total de DNIs válidos
            const dniResponse = await fetch(`${API_URL}/admin/dnis?limit=1`, {
                headers: { Authorization: `Bearer ${token}` },
            });

            // Obtener total de egresados registrados con limit alto para obtener todos
            const egresadosResponse = await fetch(`${API_URL}/perfiles/?limit=100`, {
                headers: { Authorization: `Bearer ${token}` },
            });

            let totalDnis = 0;
            let totalEgresados = 0;

            if (dniResponse.ok) {
                const dniData = await dniResponse.json();
                totalDnis = dniData.data?.pagination?.total || 0;
            }

            if (egresadosResponse.ok) {
                const egresadosData = await egresadosResponse.json();
                // El endpoint de perfiles retorna paginación
                if (egresadosData.pagination) {
                    totalEgresados = egresadosData.pagination.totalRecords || egresadosData.pagination.total || 0;
                } else if (Array.isArray(egresadosData.data)) {
                    totalEgresados = egresadosData.data.length;
                } else if (Array.isArray(egresadosData)) {
                    totalEgresados = egresadosData.length;
                }
            }

            // Actualizar las tres estadísticas
            const statsContainer = document.querySelector(
                ".estadisticas-container"
            );
            if (statsContainer) {
                const statCards = statsContainer.querySelectorAll(".stat-card");
                
                // DNIs Válidos (primera tarjeta)
                if (statCards[0]) {
                    const statValue = statCards[0].querySelector(".stat-value");
                    if (statValue) {
                        statValue.textContent = totalDnis.toString();
                    }
                }

                // Egresados Registrados (segunda tarjeta)
                if (statCards[1]) {
                    const statValue = statCards[1].querySelector(".stat-value");
                    if (statValue) {
                        statValue.textContent = totalEgresados.toString();
                    }
                }

                // Pendientes (tercera tarjeta) - por ahora 0
                if (statCards[2]) {
                    const statValue = statCards[2].querySelector(".stat-value");
                    if (statValue) {
                        statValue.textContent = "0";
                    }
                }
            }
        } catch (error) {
            console.error("Error cargando estadísticas:", error);
        }
    }

    // Event listener para el botón de reintentar
    document.addEventListener("DOMContentLoaded", () => {
        verificarAdmin();

        // Botón de reintentar en caso de error
        const retryBtn = document.getElementById("actividad-retry");
        if (retryBtn) {
            retryBtn.addEventListener("click", cargarActividadesRecientes);
        }
    });
</script>
