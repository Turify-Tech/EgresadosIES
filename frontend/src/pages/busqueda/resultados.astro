    function formatearTiempoRelativo(fechaISO: string) {
        const ahora = new Date();
        // Si la fecha no tiene 'Z' al final, agregarla para indicar UTC
        const fechaFormateada = fechaISO.includes('Z') ? fechaISO : fechaISO.replace(' ', 'T') + 'Z';
        const fecha = new Date(fechaFormateada);
        
        const diffMs = ahora.getTime() - fecha.getTime();
        
        const diffMinutos = Math.floor(diffMs / (1000 * 60));
        const diffHoras = Math.floor(diffMs / (1000 * 60 * 60));
        const diffDias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        
        // Menos de 1 hora: mostrar minutos
        if (diffHoras === 0) {
            if (diffMinutos <= 0) return 'Ahora';
            return `${diffMinutos}m`;
        }
        
        // Entre 1 y 24 horas: mostrar horas
        if (diffDias === 0) {
            return `${diffHoras}h`;
        }
        
        // Más de 24 horas: mostrar días
        if (diffDias < 7) return `${diffDias}d`;
        
        // Más de 7 días: mostrar fecha
        return fecha.toLocaleDateString('es-AR', { day: 'numeric', month: 'short' });
    }

    async function crearComentario(publicacionId: number, contenido: string) {
        const token = getAuthToken();
        if (!token) {
            showNotification('Debes iniciar sesión para comentar', 'error');
            return;
        }

        try {
            const response = await fetch(`${API_BASE_URL}/api/comentarios`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({
                    publicacionId: publicacionId,
                    contenido: contenido
                })
            });

            const result = await response.json();
            console.log('Resultado crear comentario:', result);

            if (result.success) {
                console.log('Comentario creado, recargando lista...');
                await cargarComentarios(publicacionId, 1);
                const input = document.getElementById('comentario-input') as HTMLInputElement;
                if (input) input.value = '';
                showNotification('Comentario publicado', 'success');
            } else {
                showNotification(result.message || 'Error al publicar comentario', 'error');
            }
        } catch (error) {
            console.error('Error creando comentario:', error);
            showNotification('Error al publicar comentario', 'error');
        }
    }

    async function editarComentario(comentarioId: number, nuevoContenido: string) {
        const token = getAuthToken();
        if (!token) {
            showNotification('Debes iniciar sesión', 'error');
            return false;
        }

        try {
            const response = await fetch(`${API_BASE_URL}/api/comentarios/${comentarioId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ contenido: nuevoContenido })
            });

            const result = await response.json();

            if (result.success) {
                showNotification('Comentario editado', 'success');
                return true;
            } else {
                showNotification(result.message || 'Error al editar comentario', 'error');
                return false;
            }
        } catch (error) {
            console.error('Error editando comentario:', error);
            showNotification('Error al editar comentario', 'error');
            return false;
        }
    }

    async function eliminarComentario(comentarioId: number) {
        if (!confirm('¿Estás seguro de que quieres eliminar este comentario?')) {
            return;
        }

        const token = getAuthToken();
        if (!token) {
            showNotification('Debes iniciar sesión', 'error');
            return;
        }

        try {
            const response = await fetch(`${API_BASE_URL}/api/comentarios/${comentarioId}`, {
                method: 'DELETE',
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });

            const result = await response.json();

            if (result.success) {
                const comentarioItem = document.querySelector(`.comentario-item[data-comentario-id="${comentarioId}"]`);
                if (comentarioItem) {
                    comentarioItem.remove();
                }
                
                // Verificar si ya no hay más comentarios y mostrar el mensaje
                const comentariosContainer = document.getElementById('comentarios-list');
                if (comentariosContainer && comentariosContainer.children.length === 0) {
                    comentariosContainer.innerHTML = '<p class="no-comentarios">No hay comentarios en esta publicación.</p>';
                }
                
                showNotification('Comentario eliminado', 'success');
            } else {
                showNotification(result.message || 'Error al eliminar comentario', 'error');
            }
        } catch (error) {
            console.error('Error eliminando comentario:', error);
            showNotification('Error al eliminar comentario', 'error');
        }
    }

    async function crearRespuesta(comentarioPadreId: number, contenido: string) {
        const token = getAuthToken();
        if (!token) {
            showNotification('Debes iniciar sesión para responder', 'error');
            return false;
        }

        try {
            const response = await fetch(`${API_BASE_URL}/api/comentarios`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({
                    publicacionId: currentPublicacionId,
                    contenido: contenido,
                    comentarioPadreId: comentarioPadreId
                })
            });

