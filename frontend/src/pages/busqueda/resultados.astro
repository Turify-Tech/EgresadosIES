    // Variables globales para comentarios
    let currentPublicacionId: number | null = null;
    let currentComentariosPage = 1;

    // Función para abrir modal de comentarios
    async function toggleComments(postId: number) {
        currentPublicacionId = postId;
        currentComentariosPage = 1;
        
        const modal = document.getElementById('comentarios-modal');
        const comentariosList = document.getElementById('comentarios-list');
        
        if (modal) {
            modal.style.display = 'flex';
            // Agregar publicacionId al contenedor para usarlo después
            if (comentariosList) {
                comentariosList.setAttribute('data-publicacion-id', postId.toString());
            }
            await cargarComentarios(postId, 1);
        }
    }

    function cerrarModal() {
        const modal = document.getElementById('comentarios-modal');
        if (modal) {
            modal.style.display = 'none';
            currentPublicacionId = null;
        }
    }

    async function cargarComentarios(publicacionId: number, page = 1) {
        const comentariosList = document.getElementById('comentarios-list');
        if (!comentariosList) return;

        try {
            const response = await fetch(`${API_BASE_URL}/api/comentarios/publicacion/${publicacionId}?page=${page}&limit=10`);
            const result = await response.json();

            console.log('Comentarios recibidos:', result);

            if (result.success) {
                if (page === 1) {
                    comentariosList.innerHTML = '';
                }

                const comentarios = result.data || [];

                if (comentarios.length === 0 && page === 1) {
                    comentariosList.innerHTML = '<p class="no-comentarios">No hay comentarios en esta publicación.</p>';
                } else {
                    comentarios.forEach((comentario: any) => {
                        const comentarioHTML = crearComentarioHTML(comentario);
                        comentariosList.insertAdjacentHTML('beforeend', comentarioHTML);
                    });
                    
                    // Cargar estado de likes de todos los comentarios
                    await cargarEstadosLikesComentarios();
                }

                const pagination = document.getElementById('comentarios-pagination');
                if (pagination && result.pagination) {
                    pagination.style.display = result.pagination.hasNextPage ? 'block' : 'none';
                }
            }
        } catch (error) {
            console.error('Error cargando comentarios:', error);
            comentariosList.innerHTML = '<p class="error-comentarios">Error al cargar comentarios</p>';
        }
    }

