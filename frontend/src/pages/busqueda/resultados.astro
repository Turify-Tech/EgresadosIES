                }
            });

            if (response.status === 401) {
                showNotification('Tu sesión ha expirado. Por favor inicia sesión nuevamente.', 'error');
                setTimeout(() => {
                    window.location.href = '/acceso';
                }, 1500);
                return;
            }

            const result = await response.json();

            if (result.success) {
                const { liked, totalLikes } = result.data;
                actualizarUILike(comentarioId, liked, totalLikes);
            } else {
                showNotification(result.message || 'Error al dar me gusta', 'error');
            }
        } catch (error) {
            console.error('Error al dar like:', error);
            showNotification('Error al procesar tu reacción', 'error');
        }
    }

    function actualizarUILike(comentarioId: number, liked: boolean, totalLikes: number) {
        const btnLike = document.querySelector(`.btn-like-comentario[data-comentario-id="${comentarioId}"]`) as HTMLElement;
        if (!btnLike) return;

        const iconoLike = btnLike.querySelector('.like-icon');
        const contadorLike = btnLike.querySelector('.like-count');
        
        btnLike.setAttribute('data-liked', liked ? 'true' : 'false');
        
        if (liked) {
            iconoLike?.setAttribute('fill', '#dc2626');
            iconoLike?.setAttribute('stroke', '#dc2626');
            btnLike.style.backgroundColor = '#fee2e2';
            if (contadorLike) (contadorLike as HTMLElement).style.color = '#dc2626';
            btnLike.onmouseover = () => btnLike.style.backgroundColor = '#fecaca';
            btnLike.onmouseout = () => btnLike.style.backgroundColor = '#fee2e2';
        } else {
            iconoLike?.setAttribute('fill', 'none');
            iconoLike?.setAttribute('stroke', '#6b7280');
            btnLike.style.backgroundColor = '#f3f4f6';
            if (contadorLike) (contadorLike as HTMLElement).style.color = '#6b7280';
            btnLike.onmouseover = () => btnLike.style.backgroundColor = '#e5e7eb';
            btnLike.onmouseout = () => btnLike.style.backgroundColor = '#f3f4f6';
        }
        
        if (contadorLike) contadorLike.textContent = totalLikes > 0 ? totalLikes.toString() : '0';
    }

    async function cargarEstadosLikesComentarios(comentarioIds: number[] | null = null) {
        const token = getAuthToken();
        if (!token) return;

        let botonesLike: NodeListOf<Element> | Element[];
        if (comentarioIds && comentarioIds.length > 0) {
            botonesLike = comentarioIds.map(id => 
                document.querySelector(`.btn-like-comentario[data-comentario-id="${id}"]`)
            ).filter(btn => btn !== null) as Element[];
        } else {
            botonesLike = document.querySelectorAll('.btn-like-comentario');
        }
        
        for (const btn of botonesLike) {
            const comentarioId = btn.getAttribute('data-comentario-id');
            if (!comentarioId) continue;

            try {
                const response = await fetch(`${API_BASE_URL}/api/comentarios/${comentarioId}/mi-like`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.status === 401) {
                    showNotification('Tu sesión ha expirado. Por favor inicia sesión nuevamente.', 'error');
                    setTimeout(() => {
                        window.location.href = '/acceso';
                    }, 1500);
                    return;
                }

                const result = await response.json();
                if (result.success && result.data.liked) {
                    const totalLikes = parseInt((btn.querySelector('.like-count') as HTMLElement)?.textContent || '0') || 0;
                    actualizarUILike(parseInt(comentarioId), true, totalLikes);
                }
            } catch (error) {
                console.error('Error verificando like:', error);
            }
        }
    }

    // Función para dar/quitar like
    async function toggleLike(postId: number, btnElement: HTMLElement) {
        const token = getAuthToken();
        if (!token) {
            window.location.href = '/acceso';
            return;
        }

        const isLiked = btnElement.classList.contains('liked');
        
        try {
            const response = await fetch(`${API_BASE_URL}/api/likes/toggle/${postId}`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });

            if (!response.ok) {
                throw new Error('Error al procesar like');
            }

            const result = await response.json();

            // Actualizar UI
            btnElement.classList.toggle('liked');
            const icon = btnElement.querySelector('svg');
            if (icon) {
                icon.setAttribute('fill', isLiked ? 'none' : 'currentColor');
            }

            const countSpan = btnElement.querySelector('.count');
            if (countSpan && result.data) {
                const newCount = result.data.totalLikes || 0;
                countSpan.textContent = newCount >= 1000 ? (newCount / 1000).toFixed(1) + 'k' : newCount.toString();
            }

        } catch (error) {
            console.error('Error al procesar like:', error);
        }
    }

    // Event listeners para botones de categoría
    categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const category = btn.getAttribute('data-category');
            if (category) {
                filtrarPorCategoria(category);
            }
        });
    });

    // Configurar cierre del modal de comentarios
    const closeModalBtn = document.getElementById('close-modal-btn');
    if (closeModalBtn) {
        closeModalBtn.addEventListener('click', cerrarModal);
    }

    // Cerrar modal al hacer click fuera de él
    const modal = document.getElementById('comentarios-modal');
    if (modal) {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                cerrarModal();
            }
        });
    }

    // Event delegation para comentarios
    const comentariosList = document.getElementById('comentarios-list');
    if (comentariosList) {
        comentariosList.addEventListener('click', async (e) => {
            const target = e.target as HTMLElement;
            
            // Botón de eliminar comentario
            const btnEliminar = target?.closest('.btn-eliminar-comentario');
            if (btnEliminar) {
                const comentarioId = parseInt(btnEliminar.getAttribute('data-comentario-id') || '0');
                if (comentarioId) {
                    await eliminarComentario(comentarioId);
                }
                return;
            }
            
            // Botón de like en comentario
            const btnLike = target?.closest('.btn-like-comentario');
            if (btnLike) {
                const comentarioId = parseInt(btnLike.getAttribute('data-comentario-id') || '0');
                if (comentarioId) {
                    await toggleLikeComentario(comentarioId);
                }
                return;
            }
        });
    }

    // Formulario de crear comentario
    const comentarioForm = document.getElementById('comentario-form');
    if (comentarioForm) {
        comentarioForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const input = document.getElementById('comentario-input') as HTMLInputElement;
            const contenido = input?.value.trim();
            
            if (!contenido) {
                showNotification('Escribe algo para comentar', 'error');
                return;
            }

            if (currentPublicacionId) {
                await crearComentario(currentPublicacionId, contenido);
            }
        });
    }

    // Exportar funciones como globales para que sean accesibles desde otros lugares
    (window as any).toggleComments = toggleComments;
    (window as any).crearComentario = crearComentario;
    (window as any).eliminarComentario = eliminarComentario;
    (window as any).toggleLikeComentario = toggleLikeComentario;

    // Ejecutar búsqueda al cargar la página
    realizarBusqueda();
</script>
