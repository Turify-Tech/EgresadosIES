                            </svg>
                            <span>Comentarios</span>
                            ${totalComentarios > 0 ? `<span class="comment-count">${totalComentarios}</span>` : ''}
                        </button>
                        <button class="action-btn like-btn ${userLiked ? 'liked' : ''}" data-post-id="${id}">
                            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="${userLiked ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                            <span class="count">${totalLikes >= 1000 ? (totalLikes / 1000).toFixed(1) + 'k' : totalLikes}</span>
                        </button>
                    </footer>
                </article>
            `;
        }

        // Función para cargar publicaciones
        async function cargarPublicaciones(page = 1) {
            if (isLoading) return;
            
            isLoading = true;
            const loadMoreBtn = document.getElementById('load-more-btn');
            if (loadMoreBtn) {
                loadMoreBtn.textContent = 'Cargando...';
                loadMoreBtn.disabled = true;
            }

            try {
                const token = getAuthToken();
                const headers: any = {};
                
                // Agregar token solo si existe (usuario autenticado)
                if (token) {
                    headers['Authorization'] = `Bearer ${token}`;
                }

                const response = await fetch(`${API_URL}/publicaciones?page=${page}&limit=10`, {
                    headers
                });

                if (response.status === 401) {
                    // Si no está autenticado, mostrar mensaje pero continuar cargando publicaciones
                    console.log('Usuario no autenticado - modo lectura');
                }

                const result = await response.json();
                console.log('API Response:', result);

                if (result.success && result.data.publicaciones) {
                    const feedList = document.getElementById('feed-list');
                    console.log('Publicaciones recibidas:', result.data.publicaciones);
                    
                    // Actualizar nombre del usuario en localStorage si encontramos su publicación
                    if (page === 1 && currentUser) {
                        const miPublicacion = result.data.publicaciones.find(p => p.autor.id === currentUser.id);
                        if (miPublicacion && miPublicacion.autor.nombre) {
                            const userData = getUserData();
                            if (userData && userData.nombre !== miPublicacion.autor.nombre) {
                                userData.nombre = miPublicacion.autor.nombre;
                                localStorage.setItem('user_data', JSON.stringify(userData));
                                // Actualizar también en BaseLayout
                                window.dispatchEvent(new Event('storage'));
                            }
                        }
                    }
                    
                    // Si es la primera página, limpiar el contenido
                    if (page === 1) {
                        feedList.innerHTML = '';
                    }

                    // Si no hay publicaciones
                    if (result.data.publicaciones.length === 0 && page === 1) {
                        feedList.innerHTML = `
                            <div class="empty-feed">
                                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                    <path d="M12 2v20m8-10H4"></path>
                                </svg>
                                <h3>Aún no hay publicaciones</h3>
                                <p>¡Sé el primero en compartir algo con la comunidad!</p>
                            </div>
                        `;
                    } else {
                        // Obtener IDs de todas las publicaciones
                        const publicacionIds = result.data.publicaciones.map(p => p.id);
                        
                        // Obtener estados de likes en batch (una sola llamada)
                        let likesMap = {};
                        try {
                            const likesRes = await fetch(`${API_URL}/likes/mi-estado-batch`, {
                                method: 'POST',
                                headers: {
                                    'Authorization': `Bearer ${token}`,
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ publicacionIds })
                            });
                            
                            if (likesRes.ok) {
                                const likesData = await likesRes.json();
                                likesMap = likesData.data || {};
                            }
                        } catch (error) {
                            console.warn('Error al obtener likes en batch:', error);
                        }

                        // Agregar las nuevas publicaciones con sus likes
                        result.data.publicaciones.forEach(publicacion => {
                            publicacion.userLiked = likesMap[publicacion.id] || false;
                            const cardHTML = crearPostCard(publicacion, publicacion.userLiked);
                            feedList.insertAdjacentHTML('beforeend', cardHTML);
                        });

                        // Agregar event listeners a los botones
                        agregarEventListeners();
                    }

                    // Actualizar estado de paginación
                    hasMorePages = result.data.pagination.hasNext;
                    
                    // Mostrar/ocultar botón de cargar más
                    const loadMoreSection = document.querySelector('.load-more');
                    if (loadMoreSection) {
                        loadMoreSection.style.display = hasMorePages ? 'block' : 'none';
                    }
                }
            } catch (error) {
                console.error('Error cargando publicaciones:', error);
                const feedList = document.getElementById('feed-list');
                if (page === 1) {
                    feedList.innerHTML = `
                        <div style="text-align: center; padding: 2rem; color: #666;">
                            <p>Error al cargar las publicaciones. Por favor, intenta de nuevo.</p>
                            <button onclick="cargarPublicaciones(1)" style="margin-top: 1rem; padding: 0.5rem 1rem; background: #3b82f6; color: white; border: none; border-radius: 6px; cursor: pointer;">
                                Reintentar
                            </button>
                        </div>
                    `;
                }
            } finally {
                isLoading = false;
                if (loadMoreBtn) {
                    loadMoreBtn.textContent = 'Cargar más';
                    loadMoreBtn.disabled = false;
                }
            }
        }

        // Función para crear nueva publicación
        async function crearPublicacion(contenido, imageFiles = []) {
            const token = getAuthToken();
            if (!token) {
                window.location.href = '/acceso';
                return;
            }

            try {
                // Usar FormData para enviar archivos
                const formData = new FormData();
                formData.append('contenido', contenido);
                
                // Agregar archivos de imagen
                imageFiles.forEach(file => {
                    formData.append('imagenes', file);
                });

                const response = await fetch(`${API_URL}/publicaciones`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                        // NO enviar Content-Type, el navegador lo configura automáticamente con el boundary
                    },
                    body: formData
                });

                if (response.status === 401) {
                    window.location.href = '/acceso';
                    return;
                }

                const result = await response.json();

                if (result.success) {
                    // Recargar el feed
                    currentPage = 1;
                    await cargarPublicaciones(1);
                    
                    // Limpiar el formulario completamente
                    const postContent = document.getElementById('post-content');
                    const imagePreview = document.getElementById('image-preview');
                    const postImagesInput = document.getElementById('post-images');
                    
                    if (postContent) postContent.value = '';
                    if (imagePreview) imagePreview.innerHTML = '';
                    if (postImagesInput) postImagesInput.value = ''; // Limpiar el input de archivos
                    selectedImages = []; // Limpiar el array de imágenes
                    
                    showNotification('Publicación creada exitosamente', 'success');
                } else {
                    showNotification(result.message || 'Error al crear la publicación', 'error');
                }
            } catch (error) {
                console.error('Error creando publicación:', error);
                showNotification('Error al crear la publicación', 'error');
            }
        }

