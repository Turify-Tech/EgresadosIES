        function formatearTiempoRelativo(fechaISO) {
            const ahora = new Date();
            // Si la fecha no tiene 'Z' al final, agregarla para indicar UTC
            const fechaFormateada = fechaISO.includes('Z') ? fechaISO : fechaISO.replace(' ', 'T') + 'Z';
            const fecha = new Date(fechaFormateada);
            
            const diffMs = ahora - fecha;
            
            const diffMinutos = Math.floor(diffMs / (1000 * 60));
            const diffHoras = Math.floor(diffMs / (1000 * 60 * 60));
            const diffDias = Math.floor(diffMs / (1000 * 60 * 60 * 24));
            
            // Menos de 1 hora: mostrar minutos
            if (diffHoras === 0) {
                if (diffMinutos <= 0) return 'Ahora';
                return `${diffMinutos}m`;
            }
            
            // Entre 1 y 24 horas: mostrar horas
            if (diffDias === 0) {
                return `${diffHoras}h`;
            }
            
            // Más de 24 horas: mostrar días
            if (diffDias < 7) return `${diffDias}d`;
            
            // Más de 7 días: mostrar fecha
            return fecha.toLocaleDateString('es-AR', { day: 'numeric', month: 'short' });
        }

        async function crearComentario(publicacionId, contenido) {
            const token = getAuthToken();
            if (!token) {
                showNotification('Debes iniciar sesión para comentar', 'error');
