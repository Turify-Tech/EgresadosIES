---
import BaseLayout from "../layouts/BaseLayout.astro";
import ComentariosModal from "../components/ComentariosModal.astro";
import "../styles/dashboard.css";
import "../styles/publicaciones-imagenes.css";
---

<BaseLayout title="Dashboard | Feed" hideAccederButton={true}>
    <div class="feed-page">
        <div class="feed-container">
            <!-- Sidebar izquierdo - Perfil del usuario -->
            <aside class="sidebar-left">
                <!-- Card de perfil -->
                <div class="profile-card">
                    <div class="profile-banner">
                        <img src="/images/Fondo Azul card.jpg" alt="Banner" class="card-banner" loading="lazy" />
                    </div>
                    <div class="profile-info">
                        <div class="profile-header">
                            <div class="profile-avatar" id="profile-avatar">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <circle cx="12" cy="10" r="3"></circle>
                                    <path d="M6.168 18.849A4 4 0 0 1 10 16h4a4 4 0 0 1 3.834 2.855"></path>
                                </svg>
                            </div>
                            <div class="profile-text">
                                <h3 id="profile-name">Julieta Sotelo</h3>
                                <p class="profile-subtitle" id="profile-year">Egresado en 2026</p>
                                <p class="profile-career" id="profile-career">Desarrollo Full stack</p>
                            </div>
                        </div>
                        
                        <div class="profile-actions">
                            <div class="profile-status" id="profile-status">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                </svg>
                                <span id="profile-status-text">En búsqueda de trabajo</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card de menú de usuario -->
                <div class="menu-card">
                    <div class="menu-banner">
                        <img src="/images/Fondo Azul card.jpg" alt="Banner" class="card-banner" loading="lazy" />
                    </div>
                    <div class="menu-content">
                        <h3>Menú de usuario</h3>
                        <ul class="menu-list">
                            <li>
                                <a href="/perfil/editar" class="menu-link">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    Editar información de CV
                                </a>
                            </li>
                            <li>
                                <a href="#" class="menu-link" id="menu-link-cv">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="14" width="7" height="7"></rect>
                                        <rect x="3" y="14" width="7" height="7"></rect>
                                    </svg>
                                    Ver mi CV y Portafolio
                                </a>
                            </li>
                            <li>
                                <a href="/mis-publicaciones" class="menu-link">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                    Mis publicaciones
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </aside>

            <!-- Contenido principal -->
            <main class="feed-main">
                <section class="page-header">
                    <h1 id="welcome-title">Hola,</h1>
                </section>

                <!-- Desplegable de Menú de Usuario (solo móvil) -->
                <details class="menu-mobile">
                    <summary>Menú de usuario</summary>
                    <ul>
                        <li>
                            <a href="/perfil/editar">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                Editar información de CV
                            </a>
                        </li>
                        <li>
                            <a href="#" id="menu-mobile-link-cv">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="14" width="7" height="7"></rect>
                                    <rect x="3" y="14" width="7" height="7"></rect>
                                </svg>
                                Ver mi CV y Portafolio
                            </a>
                        </li>
                        <li>
                            <a href="/mis-publicaciones">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                                Mis publicaciones
                            </a>
                        </li>
                    </ul>
                </details>

                <!-- Formulario crear publicación (visible para egresados autenticados) -->
                <form class="crear-post" id="crear-form">
                    <div class="form-user-info">
                        <div class="avatar" id="form-avatar">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <circle cx="12" cy="10" r="3"></circle>
                                <path d="M6.168 18.849A4 4 0 0 1 10 16h4a4 4 0 0 1 3.834 2.855"></path>
                            </svg>
                        </div>
                        <div>
                            <strong id="user-name-form">Usuario</strong>
                        </div>
                    </div>
                    <textarea id="post-content" placeholder="¿Qué quieres compartir con la comunidad de egresados?" rows="3"></textarea>
                    <div class="form-actions">
                        <label class="file-upload-btn">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                            <span>Imagen</span>
                            <input type="file" id="post-images" accept="image/*" multiple style="display: none;" />
                        </label>
                        <button type="submit" id="submit-post-btn">Publicar</button>
                    </div>
                    <div id="image-preview" class="image-preview"></div>
                </form>

                <div class="feed-intro">
                    <h2>Feed de la comunidad</h2>
                </div>

                <!-- Feed de publicaciones -->
                <div id="feed-list">
                    <!-- Aquí se cargarán las publicaciones dinámicamente -->
                    <div class="loading-posts">
                        <div class="loading-spinner"></div>
                        <p>Cargando publicaciones...</p>
                    </div>
                </div>

                <div class="load-more" style="display: none;">
                    <button id="load-more-btn">Cargar más</button>
                </div>
            </main>
        </div>
    </div>

    <!-- Modal de visor de imágenes -->
    <div id="imagen-modal" class="imagen-modal">
        <button class="btn-cerrar" id="cerrar-modal-imagen" aria-label="Cerrar">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        
        <button class="btn-nav btn-prev" id="btn-imagen-prev" aria-label="Anterior">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>
        
        <div class="imagen-modal-content">
            <img id="modal-imagen" src="" alt="Imagen en vista completa" />
        </div>
        
        <button class="btn-nav btn-next" id="btn-imagen-next" aria-label="Siguiente">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>
        
        <div class="contador-imagenes" id="contador-imagenes">1 / 1</div>
    </div>

    <script>
        // @ts-nocheck
        const API_URL = 'http://localhost:3000/api';
        let currentPage = 1;
        let isLoading = false;
        let hasMorePages = true;
        let currentUser: any = null;
        let currentPublicacionId: number | null = null;
        let currentComentariosPage = 1;
        let selectedImages: File[] = [];
        
        // Variables para el modal de imágenes
        let modalImagenes: string[] = [];
        let modalImagenIndex = 0;

        // ========================================
        // NAVEGACIÓN DESDE NOTIFICACIONES
        // ========================================
        
        /**
         * Obtiene parámetros de URL para navegación desde notificaciones
         */
        function obtenerParametrosNavegacion() {
            const params = new URLSearchParams(window.location.search);
            return {
                publicacionId: params.get('publicacion'),
                comentarioId: params.get('comentario'),
                abrirComentarios: params.get('abrirComentarios') === 'true'
            };
        }

        /**
         * Hace scroll a un comentario específico dentro del modal
         * Si es una respuesta, expande automáticamente el comentario padre (con soporte para múltiples niveles)
         */
        async function scrollAComentario(comentarioId) {
            console.log(`🔍 Buscando comentario ${comentarioId}...`);
            
            // Buscar en comentarios principales Y respuestas
            let comentario = document.querySelector(`.comentario-item[data-comentario-id="${comentarioId}"], .respuesta-item[data-comentario-id="${comentarioId}"]`);
            
            // Si no se encuentra, expandir niveles iterativamente
            if (!comentario) {
                console.log('⚠️ Comentario no visible, expandiendo respuestas en múltiples niveles...');
                
                try {
                    let nivelActual = 1;
                    const maxNiveles = 3; // Máximo 3 niveles de anidación
                    
                    while (nivelActual <= maxNiveles && !comentario) {
                        console.log(`📂 Expandiendo nivel ${nivelActual}...`);
                        
                        // Obtener todos los botones "Ver respuestas" visibles actualmente
                        const botonesVerRespuestas = document.querySelectorAll('.btn-ver-respuestas');
                        
                        if (botonesVerRespuestas.length === 0) {
                            console.warn(`⚠️ No hay más botones de respuestas en nivel ${nivelActual}`);
                            break;
                        }

                        let expandidosEnEsteNivel = 0;
                        
                        // Expandir todos los que estén cerrados
                        for (const boton of botonesVerRespuestas) {
                            const comentarioPadreId = boton.getAttribute('data-comentario-id');
                            const respuestasContainer = document.querySelector(`.respuestas-container[data-comentario-id="${comentarioPadreId}"]`);
                            
                            // Si no está expandido, expandirlo
                            if (respuestasContainer && respuestasContainer.style.display === 'none') {
                                console.log(`  🔓 Expandiendo comentario ${comentarioPadreId}...`);
                                await toggleVerRespuestas(parseInt(comentarioPadreId));
                                expandidosEnEsteNivel++;
                                // Pausa breve entre expansiones (optimizado)
                                await new Promise(resolve => setTimeout(resolve, 150));
                            }
                        }
                        
                        if (expandidosEnEsteNivel === 0) {
                            console.log(`✓ Nivel ${nivelActual}: no hay más contenedores cerrados`);
                            break;
                        }
                        
                        // Esperar a que las respuestas se carguen (optimizado)
                        await new Promise(resolve => setTimeout(resolve, 600));
                        
                        // Buscar nuevamente el comentario
                        comentario = document.querySelector(`.comentario-item[data-comentario-id="${comentarioId}"], .respuesta-item[data-comentario-id="${comentarioId}"]`);
                        
                        if (comentario) {
                            console.log(`✓ Comentario encontrado en nivel ${nivelActual}!`);
                            break;
                        }
                        
                        nivelActual++;
                    }
                    
                    if (!comentario) {
                        console.warn(`⚠️ Comentario ${comentarioId} no encontrado después de ${nivelActual-1} niveles`);
                        // Debug: mostrar todos los data-comentario-id disponibles
                        const todosComentarios = document.querySelectorAll('[data-comentario-id]');
                        console.log('IDs disponibles:', Array.from(todosComentarios).map(el => el.getAttribute('data-comentario-id')));
                    }
                    
                } catch (error) {
                    console.error('❌ Error al expandir respuestas:', error);
                }
            }
            
            if (!comentario) {
                console.warn(`⚠️ Comentario ${comentarioId} no encontrado después de todas las búsquedas`);
                return false;
            }

            const modalContent = document.querySelector('.comentarios-list');
            if (!modalContent) {
                console.warn('⚠️ Modal de comentarios no encontrado');
                return false;
            }

            // Scroll al comentario
            const comentarioTop = comentario.offsetTop;
            modalContent.scrollTop = comentarioTop - 100;

            // Highlight sutil del comentario
            comentario.style.transition = 'background-color 0.3s ease';
            comentario.style.backgroundColor = 'rgba(59, 130, 246, 0.1)';
            setTimeout(() => {
                comentario.style.backgroundColor = '';
            }, 2000);

            console.log('✅ Scroll al comentario completado');
            return true;
        }

        /**
         * Navega a un comentario específico - Versión optimizada (estilo Instagram)
         * Abre directamente el modal sin animaciones innecesarias
         */
        async function navegarAComentario(publicacionId, comentarioId) {
            try {
                console.log('⚡ Navegación rápida a comentario', comentarioId, 'en publicación', publicacionId);

                const postIdNum = parseInt(publicacionId);
                
                // Verificar que toggleComments existe
                if (typeof toggleComments !== 'function') {
                    console.error('❌ toggleComments no está definida');
                    return;
                }

                // 1. Abrir modal de comentarios INMEDIATAMENTE
                console.log('📂 Abriendo modal...');
                await toggleComments(postIdNum);

                // 2. Esperar a que los comentarios principales se carguen (optimizado)
                await new Promise(resolve => setTimeout(resolve, 500));

                // 3. Verificar que el modal está visible
                const modal = document.getElementById('comentarios-modal');
                if (!modal || modal.style.display !== 'flex') {
                    console.error('❌ Modal no visible');
                    return;
                }

                // 4. Hacer scroll al comentario específico
                const scrollExitoso = await scrollAComentario(comentarioId);
                
                if (scrollExitoso) {
                    console.log('✅ Comentario encontrado y visible');
                } else {
                    console.warn('⚠️ Comentario no visible, pero modal abierto');
                }

            } catch (error) {
                console.error('❌ Error en navegación:', error);
            }
        }

        /**
         * Procesa la navegación desde notificaciones al cargar la página
         */
        async function procesarNavegacionDesdeNotificaciones() {
            const { publicacionId, comentarioId, abrirComentarios } = obtenerParametrosNavegacion();
            
            // Detectar también hash en la URL (desde búsqueda)
            const hash = window.location.hash;
            let hashPostId = null;
            if (hash && hash.startsWith('#post-')) {
                hashPostId = hash.replace('#post-', '');
                console.log('📍 Detectado hash de publicación:', hashPostId);
            }
            
            const targetPostId = publicacionId || hashPostId;
            
            if (!targetPostId) {
                console.log('ℹ️ No hay parámetros de navegación');
                // Cargar feed normal
                await cargarPublicaciones(1);
                return;
            }

            console.log('📍 Detectada navegación desde notificación:', { publicacionId: targetPostId, comentarioId, abrirComentarios, esDesdeHash: !!hashPostId });

            try {
                // Decidir si es like a publicación o algo relacionado con comentarios
                const esLikeAPublicacion = !comentarioId && !abrirComentarios;

                if (esLikeAPublicacion) {
                    // LIKE A PUBLICACIÓN o DESDE BÚSQUEDA: Cargar feed completo y scrollear
                    console.log(hashPostId ? '🔍 Navegación desde búsqueda - cargando feed completo...' : '❤️ Notificación de like a publicación - cargando feed completo...');
                    await cargarPublicaciones(1);
                    
                    // Esperar a que el feed se cargue (optimizado)
                    await new Promise(resolve => setTimeout(resolve, 400));
                    
                    // Hacer scroll a la publicación
                    const publicacion = document.querySelector(`[data-post-id="${targetPostId}"]`);
                    if (publicacion) {
                        console.log('📜 Scrolleando a publicación...');
                        publicacion.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        
                        // Highlight sutil
                        publicacion.style.transition = 'box-shadow 0.3s ease';
                        publicacion.style.boxShadow = '0 0 0 3px rgba(59, 130, 246, 0.5)';
                        setTimeout(() => {
                            publicacion.style.boxShadow = '';
                        }, 2000);
                        
                        console.log('✅ Navegación a publicación completada');
                    } else {
                        console.warn('⚠️ Publicación no encontrada en el feed');
                    }
                    
                    // Limpiar parámetros de URL y hash
                    const cleanUrl = window.location.pathname;
                    window.history.replaceState({}, document.title, cleanUrl);
                    
                } else {
                    // COMENTARIO/RESPUESTA/MENCIÓN: Cargar solo publicación específica y abrir modal
                    console.log('💬 Notificación relacionada con comentarios - carga optimizada...');
                    const token = getAuthToken();
                    if (!token) {
                        window.location.href = '/acceso';
                        return;
                    }

                    const response = await fetch(`${API_URL}/publicaciones/${targetPostId}`, {
                        headers: {
                            'Authorization': `Bearer ${token}`
                        }
                    });

                    if (!response.ok) {
                        console.error('❌ Error al cargar publicación');
                        await cargarPublicaciones(1);
                        return;
                    }

                    const result = await response.json();
                    
                    if (result.success && result.data) {
                        const publicacion = result.data;
                        console.log('✓ Publicación cargada');

                        // Obtener estado de like
                        const likeRes = await fetch(`${API_URL}/likes/mi-estado/${publicacion.id}`, {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        const likeData = await likeRes.json();
                        publicacion.userLiked = likeData.data?.liked || false;

                        // Renderizar la publicación
                        const feedList = document.getElementById('feed-list');
                        if (feedList) {
                            feedList.innerHTML = crearPostCard(publicacion, publicacion.userLiked);
                            agregarEventListeners();
                        }

                        console.log('✓ Publicación renderizada');
                    } else {
                        await cargarPublicaciones(1);
                    }

                    // Esperar mínimo para asegurar renderizado (optimizado)
                    await new Promise(resolve => setTimeout(resolve, 150));

                    // Limpiar parámetros de URL sin recargar la página
                    const cleanUrl = window.location.pathname;
                    window.history.replaceState({}, document.title, cleanUrl);

                    // Decidir qué acción tomar
                    if (comentarioId) {
                        // Tiene comentarioId específico - navegar directo a él (comentario, respuesta o like a comentario)
                        console.log('🎯 Abriendo comentario específico...');
                        await navegarAComentario(targetPostId, comentarioId);
                    } else if (abrirComentarios) {
                        // Es notificación de comentario/mencion sin ID específico - abrir modal
                        console.log('💬 Abriendo modal de comentarios (sin ID específico)...');
                        const postIdNum = parseInt(targetPostId);
                        if (typeof toggleComments === 'function') {
                            await toggleComments(postIdNum);
                            console.log('✓ Modal de comentarios abierto');
                        }
                    }

                    console.log('✅ Navegación completada');

                    // Cargar el resto del feed en segundo plano (optimizado)
                    setTimeout(() => {
                        cargarPublicaciones(1);
                    }, 1000);
                }

            } catch (error) {
                console.error('❌ Error en procesarNavegacionDesdeNotificaciones:', error);
                // En caso de error, cargar feed completo
                await cargarPublicaciones(1);
            }
        }

        // Obtener datos del usuario autenticado
        function getUserData() {
            const userDataString = localStorage.getItem('user_data');
            if (!userDataString) return null;
            try {
                return JSON.parse(userDataString);
            } catch {
                return null;
            }
        }

        // Obtener token de autenticación
        function getAuthToken() {
            return localStorage.getItem('auth_token');
        }

        // Función para formatear fecha relativa
        function formatearFechaRelativa(fechaString) {
            const fecha = new Date(fechaString);
            const ahora = new Date();
            const diffMs = ahora.getTime() - fecha.getTime();
            const diffMins = Math.floor(diffMs / 60000);
            const diffHoras = Math.floor(diffMs / 3600000);
            const diffDias = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'Ahora';
            if (diffMins < 60) return `${diffMins}m`;
            if (diffHoras < 24) return `${diffHoras}h`;
            if (diffDias < 7) return `${diffDias}d`;
            
            return fecha.toLocaleDateString('es-AR', { day: 'numeric', month: 'short' });
        }

        // Función para crear el HTML de una publicación
        function crearPostCard(publicacion, userLiked = false) {
            const { id, contenido, autor, fechaCreacion, totalComentarios = 0, totalLikes = 0, imagenes } = publicacion;
            const isOwner = currentUser && currentUser.id === autor.id;
            
            // Escapar HTML para prevenir XSS
            const contenidoEscapado = contenido.replace(/</g, '&lt;').replace(/>/g, '&gt;');
            const nombreAutor = autor.nombre || 'Usuario';
            
            const optionsHTML = isOwner ? `
                <button class="delete-btn" onclick="deletePost(${id})" title="Eliminar publicación">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <line x1="10" y1="11" x2="10" y2="17"></line>
                        <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                </button>
            ` : '';

            // Renderizar imágenes con el nuevo sistema de galería
            let imagenesHTML = '';
            if (imagenes && imagenes.length > 0) {
                const numImagenes = Math.min(imagenes.length, 5);
                const imagenesJSON = JSON.stringify(imagenes.map(img => 
                    img.startsWith('http') ? img : `http://localhost:3000${img}`
                )).replace(/"/g, '&quot;');
                
                imagenesHTML = `<div class="publicacion-imagenes imagenes-${numImagenes}" data-imagenes='${imagenesJSON}'>`;
                
                // Mostrar hasta 4 imágenes (si hay 5, solo mostramos 4 con +1 en la última)
                const maxDisplay = imagenes.length === 5 ? 4 : Math.min(4, imagenes.length);
                
                for (let i = 0; i < maxDisplay; i++) {
                    let imgUrl = imagenes[i].startsWith('http') ? imagenes[i] : `http://localhost:3000${imagenes[i]}`;
                    
                    // Optimizar URLs de ImageKit con parámetros de compresión
                    if (imgUrl.includes('ik.imagekit.io')) {
                        imgUrl += '?tr=w-800,q-80,f-auto';
                    }
                    
                    // Agregar clase especial a la última imagen si hay 5 en total
                    const extraClass = (imagenes.length === 5 && i === 3) ? ' imagen-con-indicador' : '';
                    imagenesHTML += `
