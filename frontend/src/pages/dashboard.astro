                ? (autor.urlFotoPerfil.startsWith('http') 
                    ? autor.urlFotoPerfil 
                    : `http://localhost:3000${autor.urlFotoPerfil}`)
                : null;
            
            // Optimizar URL si es de ImageKit o agregar parámetros para reducir tamaño
            if (fotoUrl) {
                if (fotoUrl.includes('ik.imagekit.io')) {
                    fotoUrl += '?tr=w-100,h-100,q-80,f-auto';
                }
            }
            
            const avatarHTML = fotoUrl 
                ? `<div class="avatar"><img src="${fotoUrl}" alt="${nombreAutor}" loading="lazy" /></div>`
                : `<div class="avatar"></div>`;
            
            return `
                <article class="post-card" id="post-${id}" data-post-id="${id}">
