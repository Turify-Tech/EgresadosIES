            try {
                const response = await fetch(`${API_URL}/comentarios`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        publicacionId: publicacionId,
                        contenido: contenido
                    })
                });

                const result = await response.json();
                console.log('Resultado crear comentario:', result);

                if (result.success) {
                    console.log('Comentario creado, recargando lista...');
                    await cargarComentarios(publicacionId, 1);
