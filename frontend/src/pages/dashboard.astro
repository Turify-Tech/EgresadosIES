        async function crearRespuesta(comentarioPadreId, contenido) {
            const token = getAuthToken();
            if (!token) {
                showNotification('Debes iniciar sesión para responder', 'error');
                return false;
            }

            try {
                const response = await fetch(`${API_URL}/comentarios`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        publicacionId: currentPublicacionId,
                        contenido: contenido,
                        comentarioPadreId: comentarioPadreId
                    })
                });

                if (response.status === 401) {
                    showNotification('Tu sesión ha expirado. Por favor inicia sesión nuevamente.', 'error');
                    setTimeout(() => {
                        window.location.href = '/acceso';
                    }, 1500);
                    return false;
                }

                const result = await response.json();

                if (result.success) {
                    showNotification('Respuesta publicada', 'success');
                    return result.data;
                } else {
                    showNotification(result.message || 'Error al publicar respuesta', 'error');
                    return false;
                }
            } catch (error) {
                console.error('Error creando respuesta:', error);
                showNotification('Error al publicar respuesta', 'error');
                return false;
            }
        }

        async function cargarRespuestas(comentarioId) {
            const token = getAuthToken();
            
            try {
                const response = await fetch(`${API_URL}/comentarios/${comentarioId}/respuestas?limit=20`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.status === 401) {
                    showNotification('Tu sesión ha expirado. Por favor inicia sesión nuevamente.', 'error');
                    setTimeout(() => {
                        window.location.href = '/acceso';
                    }, 1500);
                    return [];
                }

                const result = await response.json();
                console.log('Respuestas cargadas para comentario', comentarioId, ':', result);

                if (result.success && result.data) {
                    return result.data;
                }
                return [];
            } catch (error) {
                console.error('Error cargando respuestas:', error);
                return [];
            }
        }

