        function abrirModalImagen(imagenes, index) {
            modalImagenes = imagenes;
            modalImagenIndex = index;
            
            const modal = document.getElementById('imagen-modal');
            const modalImg = document.getElementById('modal-imagen');
            const contador = document.getElementById('contador-imagenes');
            const btnPrev = document.getElementById('btn-imagen-prev');
            const btnNext = document.getElementById('btn-imagen-next');
            
            if (modal && modalImg) {
                modal.classList.add('active');
                actualizarImagenModal();
                document.body.style.overflow = 'hidden'; // Prevenir scroll del body
                
                // Actualizar estado de botones de navegación
                if (btnPrev) btnPrev.disabled = modalImagenes.length <= 1;
                if (btnNext) btnNext.disabled = modalImagenes.length <= 1;
            }
        }
        
        function cerrarModalImagen() {
            const modal = document.getElementById('imagen-modal');
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = ''; // Restaurar scroll
                modalImagenes = [];
                modalImagenIndex = 0;
            }
        }
        
        function actualizarImagenModal() {
            const modalImg = document.getElementById('modal-imagen');
            const contador = document.getElementById('contador-imagenes');
            
            if (modalImg && modalImagenes.length > 0) {
                modalImg.src = modalImagenes[modalImagenIndex];
                
                if (contador) {
                    contador.textContent = `${modalImagenIndex + 1} / ${modalImagenes.length}`;
                }
            }
        }
        
        function navegarImagenModal(direccion) {
            if (modalImagenes.length <= 1) return;
            
            if (direccion === 'prev') {
                modalImagenIndex = (modalImagenIndex - 1 + modalImagenes.length) % modalImagenes.length;
            } else if (direccion === 'next') {
                modalImagenIndex = (modalImagenIndex + 1) % modalImagenes.length;
            }
            
            actualizarImagenModal();
        }

        // Función para eliminar publicación
        async function deletePost(postId) {
            if (!confirm('¿Estás seguro de que quieres eliminar esta publicación?')) {
                return;
            }

            const token = getAuthToken();
            if (!token) {
                window.location.href = '/acceso';
                return;
            }

            try {
                const response = await fetch(`${API_URL}/publicaciones/${postId}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.status === 401) {
                    window.location.href = '/acceso';
                    return;
                }

                const result = await response.json();

                if (result.success) {
                    // Remover la publicación del DOM
                    const postCard = document.querySelector(`[data-post-id="${postId}"]`);
                    if (postCard) {
                        postCard.remove();
                    }
                    showNotification('Publicación eliminada', 'success');
                } else {
                    showNotification(result.message || 'Error al eliminar la publicación', 'error');
                }
            } catch (error) {
                console.error('Error eliminando publicación:', error);
                showNotification('Error al eliminar la publicación', 'error');
            }
        }

        // Funciones para likes y comentarios
        async function toggleLike(postId) {
            const token = getAuthToken();
            if (!token) {
                showNotification('Debes iniciar sesión para dar me gusta', 'error');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/likes/toggle/${postId}`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                const result = await response.json();

                if (result.success) {
                    const likeBtn = document.querySelector(`[data-post-id="${postId}"].like-btn`);
                    if (likeBtn) {
                        const iconSvg = likeBtn.querySelector('.icon');
                        const countSpan = likeBtn.querySelector('.count');
                        
                        if (result.data.liked) {
                            likeBtn.classList.add('liked');
                            if (iconSvg) iconSvg.setAttribute('fill', 'currentColor');
                        } else {
                            likeBtn.classList.remove('liked');
                            if (iconSvg) iconSvg.setAttribute('fill', 'none');
                        }
                        
                        if (countSpan) {
                            const totalLikes = result.data.totalLikes;
                            countSpan.textContent = totalLikes >= 1000 ? (totalLikes / 1000).toFixed(1) + 'k' : totalLikes.toString();
                        }
                    }
                    showNotification(result.data.liked ? 'Te gusta esta publicación' : 'Ya no te gusta', 'success');
                }
            } catch (error) {
                console.error('Error al dar like:', error);
                showNotification('Error al procesar tu reacción', 'error');
            }
        }

