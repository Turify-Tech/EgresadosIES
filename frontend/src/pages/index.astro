---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Inicio | Feed">
    <div class="feed-page">
        <div class="feed-container">
            <!-- Sidebar izquierdo -->
            <aside class="sidebar-left">
                <img src="/images/Fondo Azul card.jpg" alt="Banner" class="sidebar-banner" />
                <h3>Tecnicaturas</h3>
                <ul>
                    <li>Administración de Empresas</li>
                    <li>Análisis y Programación de Sistemas</li>
                    <li>Computación y Redes</li>
                    <li>Construcciones Livianas</li>
                    <li>Desarrollo de Software</li>
                    <li>Higiene y Seguridad Laboral</li>
                    <li>Logística</li>
                    <li>Obras Viales</li>
                    <li>Redes y Ciberseguridad</li>
                    <li>Recursos Humanos</li>
                    <li>Tecnología Biomédica</li>
                </ul>
            </aside>

            <!-- Contenido principal -->
            <main class="feed-main">
                <section class="page-header">
                    <h1>Perfiles Profesionales del IES</h1>
                    <p>El Instituto de Educación Superior N°9-012 "San Rafael en Informática" es un establecimiento educativo técnico de nivel superior ubicado en San Rafael, Mendoza.</p>
                </section>

                <!-- Desplegable de Tecnicaturas (solo móvil) -->
                <details class="tecnicaturas-mobile">
                    <summary>Ver las tecnicaturas del I.E.S 9-012</summary>
                    <ul>
                        <li>Administración de Empresas</li>
                        <li>Análisis y Programación de Sistemas</li>
                        <li>Computación y Redes</li>
                        <li>Construcciones Livianas</li>
                        <li>Desarrollo de Software</li>
                        <li>Higiene y Seguridad Laboral</li>
                        <li>Logística</li>
                        <li>Obras Viales</li>
                        <li>Redes y Ciberseguridad</li>
                        <li>Recursos Humanos</li>
                        <li>Tecnología Biomédica</li>
                    </ul>
                </details>

                <div class="feed-intro">
                    <h2>Feed de la comunidad</h2>
                    </div>

                <!-- Formulario crear publicación (solo visible para egresados autenticados) -->
                <form class="crear-post" id="crear-form" style="display:none;">
                    <textarea placeholder="¿Qué estás pensando?" rows="3"></textarea>
                    <div class="form-actions">
                        <input type="file" accept="image/*" multiple />
                        <button type="submit">Publicar</button>
                    </div>
                </form>

                <!-- Feed de publicaciones -->
                <div id="feed-list">
                    <!-- Posts estáticos de ejemplo -->
                    <article class="post-card">
                        <header class="post-header">
                            <div class="avatar"></div>
                            <div class="post-meta">
                                <strong>Marta Gonzales</strong>
                                <time>3h</time>
                            </div>
                        </header>
                        <div class="post-body">
                            <p>¡Hola comunidad! Acabo de conseguir mi primer trabajo como desarrolladora en una startup de fintech. Gracias a todos los que me apoyaron durante mi búsqueda. ¡La perseverancia vale la pena! 🚀</p>
                        </div>
                        <footer class="post-actions">
                            <button class="action-btn comment-btn">
                                <span>💬</span>
                                <span class="count">Comentarios</span>
                            </button>
                            <button class="action-btn like-btn">
                                <span>❤</span>
                                <span class="count">2.5k</span>
                            </button>
                        </footer>
                    </article>

                    <article class="post-card">
                        <header class="post-header">
                            <div class="avatar"></div>
                            <div class="post-meta">
                                <strong>Marta Gonzales</strong>
                                <time>Miembro de la comunidad</time>
                            </div>
                        </header>
                        <div class="post-body">
                            <p>¡Hola comunidad! Acabo de conseguir mi primer trabajo como desarrolladora en una startup de fintech. Gracias a todos los que me apoyaron durante mi búsqueda. ¡La perseverancia vale la pena! 🚀</p>
                        </div>
                        <footer class="post-actions">
                            <button class="action-btn like-btn">
                                <span>❤</span>
                                <span class="count">2</span>
                            </button>
                        </footer>
                    </article>
                </div>

                <div class="load-more">
                    <button id="load-more-btn">Cargar más</button>
                </div>
            </main>
        </div>
    </div>

    <style is:global>
        .feed-page {
            background: #f5f5f5;
            min-height: 100vh;
            padding: 1rem;
            overflow: visible;
        }
        
        .feed-container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 1.5rem;
            align-items: start;
        }

        /* Sidebar */
        .sidebar-left {
            background: white;
            padding: 0;
            border-radius: 8px;
            position: sticky;
            top: 28px;
            overflow: hidden;
            align-self: start;
        }
        
        .sidebar-banner {
            width: 100%;
            height: 70px;
            object-fit: cover;
            display: block;
        }
        
        .sidebar-left h3 {
            margin: 0;
            padding: 0.75rem 1.5rem;
            font-size: 1.2rem;
            color: #1437C3;
            font-weight: 700 !important;
        }
        
        .sidebar-left ul {
            list-style: none;
            padding: 0 1.5rem 1.5rem 1.5rem;
            margin: 0;
        }
        
        .sidebar-left li {
            padding: 0.25rem 0;
            color: #333;
            font-size: 0.9rem;
            line-height: 1.4;
        }

        /* Main content */
        .feed-main {
            max-width: 680px;
        }
        
        .page-header {
            margin-bottom: 1.5rem;
        }
        
        .page-header h1 {
            font-size: 1.75rem;
            margin: 0 0 0.5rem 0;
            color: #000;
        }
        
        .page-header p {
            color: #666;
            margin: 0;
            line-height: 1.6;
            font-size: 1rem;
        }

        
        .feed-intro h2 {
            margin: 0 0 0.5rem 0;
            font-size: 1.30rem;
            color: #000;
        }
        
        .feed-intro p {
            margin: 0;
            color: #666;
            font-size: 0.9rem;
        }

        /* Formulario crear post */
        .crear-post {
            background: white;
            padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }
        
        .crear-post textarea {
            width: 100%;
            border: 1px solid #e5e7eb;
            padding: 0.75rem;
            border-radius: 8px;
            font-size: 0.95rem;
            font-family: inherit;
            resize: vertical;
        }
        
        .crear-post textarea:focus {
            outline: none;
            border-color: #3b82f6;
        }
        
        .form-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.75rem;
        }
        
        .form-actions button {
            background: #3b82f6;
            color: white;
            border: none;
            padding: 0.5rem 1.5rem;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 500;
        }
        
        .form-actions button:hover {
            background: #2563eb;
        }

        /* Post card */
        .post-card {
            background: white;
            padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            border: 1px solid #e5e7eb;
        }
        
        .post-header {
            display: flex;
            gap: 0.75rem;
            align-items: center;
            margin-bottom: 1rem;
        }
        
        .avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #c7d2fe;
            flex-shrink: 0;
        }
        
        .post-meta {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }
        
        .post-meta strong {
            font-weight: 600;
            color: #000;
            font-size: 1rem;
        }
        
        .post-meta time {
            font-size: 0.8rem;
            color: #9ca3af;
        }
        
        .post-body {
            margin-bottom: 1rem;
        }
        
        .post-body p {
            margin: 0 0 1rem 0;
            color: #1f2937;
            font-size: 0.95rem;
            line-height: 1.6;
        }
        
        .post-images {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 0.5rem;
            margin-top: 1rem;
        }
        
        .post-images img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 8px;
        }
        
        .post-stats {
            display: flex;
            gap: 1.5rem;
            padding-top: 1rem;
            border-top: 1px solid #e5e7eb;
        }
        
        .stat-item {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            color: #6b7280;
            font-size: 0.9rem;
        }

        /* Desplegable de tecnicaturas (solo móvil) */
        .tecnicaturas-mobile {
            display: none;
            background: white;
            border-radius: 8px;
            padding: 1rem;
            margin: 1rem 0.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .tecnicaturas-mobile summary {
            cursor: pointer;
            font-weight: 600;
            color: #1437C3;
            font-size: 1rem;
            padding: 0.5rem;
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .tecnicaturas-mobile summary::-webkit-details-marker {
            display: none;
        }

        .tecnicaturas-mobile summary::after {
            content: '▼';
            font-size: 0.8rem;
            transition: transform 0.3s;
        }

        .tecnicaturas-mobile[open] summary::after {
            transform: rotate(180deg);
        }

        .tecnicaturas-mobile ul {
            list-style: none;
            padding: 0;
            margin: 0.75rem 0 0 0;
        }

        .tecnicaturas-mobile li {
            padding: 0.5rem;
            color: #333;
            font-size: 0.9rem;
            border-bottom: 1px solid #f0f0f0;
        }

        .tecnicaturas-mobile li:last-child {
            border-bottom: none;
        }

        /* Load more */
        .load-more {
            text-align: center;
            margin: 2rem 0;
        }
        
        .load-more button {
            background: #eef2ff;
            border: 1px solid #dbeafe;
            padding: 0.5rem 1.5rem;
            border-radius: 6px;
            cursor: pointer;
            color: #3b82f6;
            font-weight: 500;
        }
        
        .load-more button:hover {
            background: #dbeafe;
        }

        @media (max-width: 768px) {
            .feed-page {
                padding: 0.5rem;
            }

            .feed-container {
                grid-template-columns: 1fr;
                gap: 0.5rem;
            }
            
            .sidebar-left {
                display: none;
            }

            .tecnicaturas-mobile {
                display: block;
            }

            .feed-main {
                max-width: 100%;
            }

            .page-header {
                padding: 0 0.5rem;
                margin-bottom: 0.5rem;
            }

            .page-header h1 {
                font-size: 1.3rem;
                margin-bottom: 0.5rem;
            }

            .page-header p {
                font-size: 0.85rem;
            }

            .feed-intro {
                padding: 0 0.5rem;
            }

            .post-card {
                margin: 0 0.5rem 1rem 0.5rem;
                padding: 1rem;
            }

            .post-header {
                flex-wrap: wrap;
            }

            .load-more {
                padding: 0 0.5rem;
            }
        }
    </style>

    <script>
        const API_URL = 'http://localhost:3000/api';
        let currentPage = 1;
        let isLoading = false;
        let hasMorePages = true;

        // Función para formatear fecha relativa
        function formatearFechaRelativa(fechaString) {
            const fecha = new Date(fechaString);
            const ahora = new Date();
            const diffMs = ahora - fecha;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHoras = Math.floor(diffMs / 3600000);
            const diffDias = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'Ahora';
            if (diffMins < 60) return `${diffMins}m`;
            if (diffHoras < 24) return `${diffHoras}h`;
            if (diffDias < 7) return `${diffDias}d`;
            
            return fecha.toLocaleDateString('es-AR', { day: 'numeric', month: 'short' });
        }

        // Función para crear el HTML de una publicación
        function crearPostCard(publicacion) {
            const { id, contenido, autor, fechaCreacion, totalComentarios, totalLikes, imagenes } = publicacion;
            
            return `
                <article class="post-card" data-post-id="${id}">
                    <header class="post-header">
                        <div class="avatar"></div>
                        <div class="post-meta">
                            <strong>${autor.nombre}</strong>
                            <time>${formatearFechaRelativa(fechaCreacion)}</time>
                        </div>
                    </header>
                    <div class="post-body">
                        <p>${contenido}</p>
                        ${imagenes && imagenes.length > 0 ? `
                            <div class="post-images">
                                ${imagenes.map(img => `<img src="${img}" alt="Imagen de publicación" />`).join('')}
                            </div>
                        ` : ''}
                    </div>
                    <footer class="post-stats">
                        <span class="stat-item">
                            <span>💬</span>
                            <span class="count">${totalComentarios} ${totalComentarios === 1 ? 'comentario' : 'comentarios'}</span>
                        </span>
                        <span class="stat-item">
                            <span>❤</span>
                            <span class="count">${totalLikes} ${totalLikes === 1 ? 'me gusta' : 'me gusta'}</span>
                        </span>
                    </footer>
                </article>
            `;
        }

        // Función para cargar publicaciones
        async function cargarPublicaciones(page = 1) {
            if (isLoading) return;
            
            isLoading = true;
            const loadMoreBtn = document.getElementById('load-more-btn');
            if (loadMoreBtn) {
                loadMoreBtn.textContent = 'Cargando...';
                loadMoreBtn.disabled = true;
            }

            try {
                const response = await fetch(`${API_URL}/publicaciones?page=${page}&limit=10`);
                const result = await response.json();
                
                console.log('API Response index.astro:', result);

                if (result.success && result.data.publicaciones) {
                    const feedList = document.getElementById('feed-list');
                    
                    console.log('Publicaciones recibidas:', result.data.publicaciones);
                    
                    // Si es la primera página, limpiar el contenido de ejemplo
                    if (page === 1) {
                        feedList.innerHTML = '';
                    }

                    // Agregar las nuevas publicaciones
                    result.data.publicaciones.forEach(publicacion => {
                        console.log('Procesando publicación:', publicacion);
                        const cardHTML = crearPostCard(publicacion);
                        console.log('HTML generado:', cardHTML);
                        feedList.insertAdjacentHTML('beforeend', cardHTML);
                    });

                    // Actualizar estado de paginación
                    hasMorePages = result.data.pagination.hasNext;
                    
                    // Mostrar/ocultar botón de cargar más
                    const loadMoreSection = document.querySelector('.load-more');
                    if (loadMoreSection) {
                        loadMoreSection.style.display = hasMorePages ? 'block' : 'none';
                    }
                }
            } catch (error) {
                console.error('Error cargando publicaciones:', error);
                // Mostrar mensaje de error
                const feedList = document.getElementById('feed-list');
                if (page === 1) {
                    feedList.innerHTML = `
                        <div style="text-align: center; padding: 2rem; color: #666;">
                            <p>Error al cargar las publicaciones. Por favor, intenta de nuevo.</p>
                        </div>
                    `;
                }
            } finally {
                isLoading = false;
                if (loadMoreBtn) {
                    loadMoreBtn.textContent = 'Cargar más';
                    loadMoreBtn.disabled = false;
                }
            }
        }

        // Event listener para el botón de cargar más
        document.addEventListener('DOMContentLoaded', () => {
            // Cargar primera página al cargar la página
            cargarPublicaciones(1);

            // Configurar botón de cargar más
            const loadMoreBtn = document.getElementById('load-more-btn');
            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', () => {
                    currentPage++;
                    cargarPublicaciones(currentPage);
                });
            }
        });
    </script>
</BaseLayout>
