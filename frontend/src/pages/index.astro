---
import BaseLayout from "../layouts/BaseLayout.astro";
import ComentariosModal from "../components/ComentariosModal.astro";
import "../styles/index.css";
---

<BaseLayout title="Inicio | Feed">
    <div class="feed-page">
        <div class="feed-container">
            <!-- Sidebar izquierdo -->
            <aside class="sidebar-left">
                <img src="/images/Fondo Azul card.jpg" alt="Banner" class="sidebar-banner" />
                <h3>Tecnicaturas</h3>
                <ul>
                    <li>Administración de Empresas</li>
                    <li>Análisis y Programación de Sistemas</li>
                    <li>Computación y Redes</li>
                    <li>Construcciones Livianas</li>
                    <li>Desarrollo de Software</li>
                    <li>Higiene y Seguridad Laboral</li>
                    <li>Logística</li>
                    <li>Obras Viales</li>
                    <li>Redes y Ciberseguridad</li>
                    <li>Recursos Humanos</li>
                    <li>Tecnología Biomédica</li>
                </ul>
            </aside>

            <!-- Contenido principal -->
            <main class="feed-main">
                <section class="page-header">
                    <h1>Perfiles Profesionales del IES</h1>
                    <p>El Instituto de Educación Superior N°9-012 "San Rafael en Informática" es un establecimiento educativo técnico de nivel superior ubicado en San Rafael, Mendoza.</p>
                </section>

                <!-- Desplegable de Tecnicaturas (solo móvil) -->
                <details class="tecnicaturas-mobile">
                    <summary>Ver las tecnicaturas del I.E.S 9-012</summary>
                    <ul>
                        <li>Administración de Empresas</li>
                        <li>Análisis y Programación de Sistemas</li>
                        <li>Computación y Redes</li>
                        <li>Construcciones Livianas</li>
                        <li>Desarrollo de Software</li>
                        <li>Higiene y Seguridad Laboral</li>
                        <li>Logística</li>
                        <li>Obras Viales</li>
                        <li>Redes y Ciberseguridad</li>
                        <li>Recursos Humanos</li>
                        <li>Tecnología Biomédica</li>
                    </ul>
                </details>

                <div class="feed-intro">
                    <h2>Feed de la comunidad</h2>
                    </div>

                <!-- Formulario crear publicación (solo visible para egresados autenticados) -->
                <form class="crear-post" id="crear-form" style="display:none;">
                    <textarea placeholder="¿Qué estás pensando?" rows="3"></textarea>
                    <div class="form-actions">
                        <input type="file" accept="image/*" multiple />
                        <button type="submit">Publicar</button>
                    </div>
                </form>

                <!-- Feed de publicaciones -->
                <div id="feed-list">
                    <!-- Aquí se cargarán las publicaciones dinámicamente -->
                    <div class="loading-posts">
                        <div class="loading-spinner"></div>
                        <p>Cargando publicaciones...</p>
                    </div>
                </div>

                <div class="load-more" style="display: none;">
                    <button id="load-more-btn">Cargar más</button>
                </div>
            </main>
        </div>
    </div>

    <!-- Modal de comentarios -->
    <ComentariosModal />

    <script>
        const API_URL = 'http://localhost:3000/api';
        let currentPage = 1;
        let isLoading = false;
        let hasMorePages = true;

        // Función para formatear fecha relativa
        function formatearFechaRelativa(fechaString) {
            const fecha = new Date(fechaString);
            const ahora = new Date();
            const diffMs = ahora - fecha;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHoras = Math.floor(diffMs / 3600000);
            const diffDias = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'Ahora';
            if (diffMins < 60) return `${diffMins}m`;
            if (diffHoras < 24) return `${diffHoras}h`;
            if (diffDias < 7) return `${diffDias}d`;
            
            return fecha.toLocaleDateString('es-AR', { day: 'numeric', month: 'short' });
        }

        // Función para crear el HTML de una publicación
        function crearPostCard(publicacion) {
            const { id, contenido, autor, fechaCreacion, totalComentarios, totalLikes, imagenes } = publicacion;
            
            console.log(`Post ${id} - Comentarios: ${totalComentarios}, Likes: ${totalLikes}`);
            
            // Procesar URL de foto de perfil
            let avatarURL = '';
            if (autor.urlFotoPerfil) {
                avatarURL = autor.urlFotoPerfil.startsWith('http') 
                    ? autor.urlFotoPerfil 
                    : `http://localhost:3000${autor.urlFotoPerfil}`;
            }
            
            return `
                <article class="post-card" data-post-id="${id}">
                    <header class="post-header">
                        <div class="avatar">
                            ${avatarURL ? `<img src="${avatarURL}" alt="${autor.nombre}" style="width: 100%; height: 100%; object-fit: cover;">` : `
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <circle cx="12" cy="10" r="3"></circle>
                                    <path d="M6.168 18.849A4 4 0 0 1 10 16h4a4 4 0 0 1 3.834 2.855"></path>
                                </svg>
                            `}
                        </div>
                        <div class="post-meta">
                            <strong>${autor.nombre}</strong>
                            <time>${formatearFechaRelativa(fechaCreacion)}</time>
                        </div>
                    </header>
                    <div class="post-body">
                        <p>${contenido}</p>
                        ${imagenes && imagenes.length > 0 ? `
                            <div class="post-images">
                                ${imagenes.map(img => `<img src="${img}" alt="Imagen de publicación" />`).join('')}
                            </div>
                        ` : ''}
                    </div>
                    <footer class="post-actions">
                        <button class="action-btn comment-btn" onclick="toggleComments(${id})">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span class="action-text">Comentarios</span>
                            ${totalComentarios > 0 ? `<span class="comment-count">${totalComentarios}</span>` : ''}
                        </button>
                        <button class="action-btn like-btn">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                            ${totalLikes > 0 ? `<span class="like-count">${totalLikes > 999 ? (totalLikes / 1000).toFixed(1) + 'k' : totalLikes}</span>` : ''}
                        </button>
                    </footer>
                </article>
            `;
        }

        // Función para cargar publicaciones
        async function cargarPublicaciones(page = 1) {
            if (isLoading) return;
            
            isLoading = true;
            const loadMoreBtn = document.getElementById('load-more-btn');
            if (loadMoreBtn) {
                loadMoreBtn.textContent = 'Cargando...';
                loadMoreBtn.disabled = true;
            }

            try {
                const response = await fetch(`${API_URL}/publicaciones?page=${page}&limit=10`);
                const result = await response.json();
                
                console.log('API Response index.astro:', result);

                if (result.success && result.data.publicaciones) {
                    const feedList = document.getElementById('feed-list');
                    
                    console.log('Publicaciones recibidas:', result.data.publicaciones);
                    
                    // Si es la primera página, limpiar el contenido de ejemplo
                    if (page === 1) {
                        feedList.innerHTML = '';
                    }

                    // Agregar las nuevas publicaciones
                    result.data.publicaciones.forEach(publicacion => {
                        console.log('Procesando publicación:', publicacion);
                        const cardHTML = crearPostCard(publicacion);
                        console.log('HTML generado:', cardHTML);
                        feedList.insertAdjacentHTML('beforeend', cardHTML);
                    });

                    // Actualizar estado de paginaciónes
                    hasMorePages = result.data.pagination.hasNext;
                    
                    // Mostrar/ocultar botón de cargar más
                    const loadMoreSection = document.querySelector('.load-more');
                    if (loadMoreSection) {
                        loadMoreSection.style.display = hasMorePages ? 'block' : 'none';
                    }
                }
            } catch (error) {
                console.error('Error cargando publicaciones:', error);
                // Mostrar mensaje de error
                const feedList = document.getElementById('feed-list');
                if (page === 1) {
                    feedList.innerHTML = `
                        <div style="text-align: center; padding: 2rem; color: #666;">
                            <p>Error al cargar las publicaciones. Por favor, intenta de nuevo.</p>
                        </div>
                    `;
                }
            } finally {
                isLoading = false;
                if (loadMoreBtn) {
                    loadMoreBtn.textContent = 'Cargar más';
                    loadMoreBtn.disabled = false;
                }
            }
        }

        // Variables para el modal de comentarios
        let currentPublicacionId = null;

        // Función para obtener el token
        function getAuthToken() {
            return localStorage.getItem('auth_token');
        }

        // Función para verificar si el usuario es egresado
        function isEgresado() {
            const userData = localStorage.getItem('user_data');
            if (!userData) return false;
            try {
                const user = JSON.parse(userData);
                return user.tipo_usuario === 'Egresado';
            } catch {
                return false;
            }
        }

        // Función para formatear tiempo relativo
        function formatearTiempoRelativo(fechaString) {
            const fecha = new Date(fechaString + 'Z'); // Agregar Z para UTC
            const ahora = new Date();
            const diffMs = ahora - fecha;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHoras = Math.floor(diffMs / 3600000);
            const diffDias = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'Ahora';
            if (diffMins < 60) return `${diffMins}m`;
            if (diffHoras < 24) return `${diffHoras}h`;
            if (diffDias < 7) return `${diffDias}d`;
            
            return fecha.toLocaleDateString('es-AR', { day: 'numeric', month: 'short' });
        }

        // Obtener usuario actual
        let currentUser = null;
        try {
            const userData = localStorage.getItem('user_data');
            if (userData) {
                currentUser = JSON.parse(userData);
            }
        } catch (e) {
            console.error('Error parsing user data:', e);
        }

        // Función para crear HTML de comentario
        function crearComentarioHTML(comentario) {
            const { id, contenido, autor, fechaCreacion, totalLikes, totalRespuestas } = comentario;
            let avatarURL = '';
            if (autor.urlFotoPerfil) {
                avatarURL = autor.urlFotoPerfil.startsWith('http') 
                    ? autor.urlFotoPerfil 
                    : `http://localhost:3000${autor.urlFotoPerfil}`;
            }
            const nombreCompleto = autor.apellido ? `${autor.nombre} ${autor.apellido}` : autor.nombre;
            const tituloCarrera = autor.tituloCarrera || '';
            const esPropio = currentUser && currentUser.id === autor.id;
            
            return `
                <div class="comentario-item" data-comentario-id="${id}" style="display: flex; gap: 0.75rem; padding: 1rem 0; border-bottom: 1px solid #f3f4f6;">
                    <div class="comentario-avatar" style="width: 40px; height: 40px; min-width: 40px; min-height: 40px; border-radius: 50%; overflow: hidden; flex-shrink: 0;">
                        ${avatarURL ? `<img src="${avatarURL}" alt="${nombreCompleto}" style="width: 40px !important; height: 40px !important; object-fit: cover; border-radius: 50%; display: block;">` : `
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #6366f1;">
                                <circle cx="12" cy="12" r="10"></circle>
                                <circle cx="12" cy="10" r="3"></circle>
                                <path d="M6.168 18.849A4 4 0 0 1 10 16h4a4 4 0 0 1 3.834 2.855"></path>
                            </svg>
                        `}
                    </div>
                    <div class="comentario-content" style="flex: 1;">
                        <div style="margin-bottom: 0.25rem; display: flex; justify-content: space-between; align-items: flex-start;">
                            <div>
                                <strong class="comentario-autor" style="color: #000 !important; font-weight: 600; font-size: 0.9375rem; display: block; line-height: 1.3;">${nombreCompleto}</strong>
                                ${tituloCarrera ? `<div class="comentario-subtitle" style="color: #6b7280 !important; font-size: 0.8125rem; margin-top: 0.125rem; line-height: 1.3;">${tituloCarrera}</div>` : ''}
                            </div>
                            ${esPropio ? `
                                <button class="btn-eliminar-comentario" data-comentario-id="${id}" style="background: none; border: none; color: #9ca3af; font-size: 1.125rem; cursor: pointer; padding: 0; line-height: 1; transition: color 0.2s;" onmouseover="this.style.color='#dc2626'" onmouseout="this.style.color='#9ca3af'" title="Eliminar comentario">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        <line x1="10" y1="11" x2="10" y2="17"></line>
                                        <line x1="14" y1="11" x2="14" y2="17"></line>
                                    </svg>
                                </button>
                            ` : ''}
                        </div>
                        <p class="comentario-texto" data-comentario-id="${id}" style="color: #000 !important; margin: 0.5rem 0 0.625rem 0; font-size: 0.9375rem; line-height: 1.4;">${contenido}</p>
                        <div class="comentario-footer" style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
                            <span class="comentario-tiempo" style="color: #9ca3af; font-size: 0.8125rem;">${formatearTiempoRelativo(fechaCreacion)}</span>
                            <button class="btn-responder" data-comentario-id="${id}" style="background: none; border: none; color: #6b7280; font-size: 0.8125rem; font-weight: 500; cursor: pointer; padding: 0; transition: color 0.2s;" onmouseover="this.style.color='#2563eb'" onmouseout="this.style.color='#6b7280'">Responder</button>
                            ${totalRespuestas > 0 ? `
                                <button class="btn-ver-respuestas" data-comentario-id="${id}" data-nivel="1" style="background: none; border: none; color: #2563eb; font-size: 0.8125rem; font-weight: 500; cursor: pointer; padding: 0; display: flex; align-items: center; gap: 0.25rem;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icono-toggle">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                    <span class="texto-respuestas">Ver respuestas (${totalRespuestas})</span>
                                </button>
                            ` : ''}
                            <button class="btn-like-comentario" data-comentario-id="${id}" data-liked="false" style="background: none; border: none; cursor: pointer; padding: 0.25rem 0.5rem; display: inline-flex; align-items: center; gap: 0.25rem; border-radius: 1rem; transition: all 0.2s; background-color: #f3f4f6; font-size: 0.75rem;" onmouseover="this.style.backgroundColor='#e5e7eb'" onmouseout="this.style.backgroundColor='#f3f4f6'">
                                <svg class="like-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                                <span class="like-count" style="font-weight: 600; color: #6b7280;">${totalLikes > 0 ? totalLikes : '0'}</span>
                            </button>
                        </div>
                        <!-- Contenedor de respuestas (oculto por defecto) -->
                        <div class="respuestas-container" data-comentario-id="${id}" style="display: none; margin-top: 1rem; padding-left: 0; border-left: 0px solid #e5e7eb;">
                            <div class="respuestas-list"></div>
                        </div>
                    </div>
                </div>
            `;
        }

        // Función para cargar comentarios
        async function cargarComentarios(publicacionId, page = 1) {
            const comentariosList = document.getElementById('comentarios-list');
            if (!comentariosList) return;

            try {
                const response = await fetch(`${API_URL}/comentarios/publicacion/${publicacionId}?page=${page}&limit=10`);
                const result = await response.json();

                if (result.success) {
                    if (page === 1) {
                        comentariosList.innerHTML = '';
                    }

                    const comentarios = result.data || [];

                    if (comentarios.length === 0 && page === 1) {
                        comentariosList.innerHTML = '<p class="no-comentarios">No hay comentarios en esta publicación.</p>';
                    } else {
                        comentarios.forEach(comentario => {
                            const comentarioHTML = crearComentarioHTML(comentario);
                            comentariosList.insertAdjacentHTML('beforeend', comentarioHTML);
                        });
                        
                        // Cargar estados de likes después de agregar los comentarios
                        await cargarEstadosLikesComentarios();
                    }

                    const pagination = document.getElementById('comentarios-pagination');
                    if (pagination && result.pagination) {
                        pagination.style.display = result.pagination.hasNextPage ? 'block' : 'none';
                    }
                }
            } catch (error) {
                console.error('Error cargando comentarios:', error);
                comentariosList.innerHTML = '<p class="error-comentarios">Error al cargar comentarios</p>';
            }
        }

        // ========================================
        // Funciones para respuestas a comentarios
        // ========================================
        
        async function crearRespuesta(comentarioPadreId, contenido) {
            const token = getAuthToken();
            if (!token) {
                alert('Debes iniciar sesión para responder');
                return false;
            }

            try {
                const response = await fetch(`${API_URL}/comentarios`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        publicacionId: currentPublicacionId,
                        contenido: contenido,
                        comentarioPadreId: comentarioPadreId
                    })
                });

                if (response.status === 401) {
                    alert('Tu sesión ha expirado. Por favor inicia sesión nuevamente.');
                    setTimeout(() => {
                        window.location.href = '/acceso';
                    }, 1500);
                    return false;
                }

                const result = await response.json();

                if (result.success) {
                    return result.data;
                } else {
                    alert(result.message || 'Error al publicar respuesta');
                    return false;
                }
            } catch (error) {
                console.error('Error creando respuesta:', error);
                alert('Error al publicar respuesta');
                return false;
            }
        }

        async function cargarRespuestas(comentarioId) {
            const token = getAuthToken();
            
            try {
                const response = await fetch(`${API_URL}/comentarios/${comentarioId}/respuestas?limit=20`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.status === 401) {
                    alert('Tu sesión ha expirado. Por favor inicia sesión nuevamente.');
                    setTimeout(() => {
                        window.location.href = '/acceso';
                    }, 1500);
                    return [];
                }

                const result = await response.json();
                console.log('Respuestas cargadas para comentario', comentarioId, ':', result);

                if (result.success && result.data) {
                    return result.data;
                }
                return [];
            } catch (error) {
                console.error('Error cargando respuestas:', error);
                return [];
            }
        }

        function crearRespuestaHTML(respuesta, nivel = 1) {
            const { id, contenido, autor, fechaCreacion, totalLikes, totalRespuestas } = respuesta;
            let avatarURL = '';
            if (autor.urlFotoPerfil) {
                avatarURL = autor.urlFotoPerfil.startsWith('http') 
                    ? autor.urlFotoPerfil 
                    : `http://localhost:3000${autor.urlFotoPerfil}`;
            }
            const nombreCompleto = autor.apellido ? `${autor.nombre} ${autor.apellido}` : autor.nombre;
            const tituloCarrera = autor.tituloCarrera || '';
            const esPropio = currentUser && currentUser.id === autor.id;
            
            // SIEMPRE limitar el nivel visual máximo a 2 (como Facebook)
            // Nivel 1: respuestas directas al comentario principal
            // Nivel 2: todas las demás respuestas (respuestas a respuestas)
            const nivelVisual = Math.min(nivel, 2);

            return `
                <div class="respuesta-item nivel-${nivelVisual}" data-comentario-id="${id}" data-nivel="${nivel}">
                    <div class="comentario-avatar" style="width: 32px; height: 32px; min-width: 32px; min-height: 32px; border-radius: 50%; overflow: hidden; flex-shrink: 0;">
                        ${avatarURL ? `<img src="${avatarURL}" alt="${nombreCompleto}" style="width: 32px !important; height: 32px !important; object-fit: cover; border-radius: 50%; display: block;">` : `
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #6366f1;">
                                <circle cx="12" cy="12" r="10"></circle>
                                <circle cx="12" cy="10" r="3"></circle>
                                <path d="M6.168 18.849A4 4 0 0 1 10 16h4a4 4 0 0 1 3.834 2.855"></path>
                            </svg>
                        `}
                    </div>
                    <div class="comentario-content" style="flex: 1;">
                        <div style="margin-bottom: 0.25rem; display: flex; justify-content: space-between; align-items: flex-start;">
                            <div>
                                <strong class="comentario-autor" style="color: #000 !important; font-weight: 600; font-size: 0.875rem; display: block; line-height: 1.3;">${nombreCompleto}</strong>
                                ${tituloCarrera ? `<div class="comentario-subtitle" style="color: #6b7280 !important; font-size: 0.75rem; margin-top: 0.125rem; line-height: 1.3;">${tituloCarrera}</div>` : ''}
                            </div>
                            ${esPropio ? `
                                <button class="btn-eliminar-comentario" data-comentario-id="${id}" style="background: none; border: none; color: #9ca3af; font-size: 1rem; cursor: pointer; padding: 0; line-height: 1; transition: color 0.2s;" onmouseover="this.style.color='#dc2626'" onmouseout="this.style.color='#9ca3af'" title="Eliminar respuesta">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        <line x1="10" y1="11" x2="10" y2="17"></line>
                                        <line x1="14" y1="11" x2="14" y2="17"></line>
                                    </svg>
                                </button>
                            ` : ''}
                        </div>
                        <p class="comentario-texto" style="color: #000 !important; margin: 0.375rem 0; font-size: 0.875rem; line-height: 1.4;">${contenido}</p>
                        <div class="comentario-footer" style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
                            <span class="comentario-tiempo" style="color: #9ca3af; font-size: 0.75rem;">${formatearTiempoRelativo(fechaCreacion)}</span>
                            <button class="btn-responder" data-comentario-id="${id}" style="background: none; border: none; color: #6b7280; font-size: 0.75rem; font-weight: 500; cursor: pointer; padding: 0; transition: color 0.2s;" onmouseover="this.style.color='#2563eb'" onmouseout="this.style.color='#6b7280'">Responder</button>
                            ${totalRespuestas > 0 ? `
                                <button class="btn-ver-respuestas" data-comentario-id="${id}" data-nivel="${Math.min(nivel + 1, 2)}" style="background: none; border: none; color: #2563eb; font-size: 0.75rem; font-weight: 500; cursor: pointer; padding: 0; display: flex; align-items: center; gap: 0.25rem;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icono-toggle">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                    <span class="texto-respuestas">Ver respuestas (${totalRespuestas})</span>
                                </button>
                            ` : ''}
                            <button class="btn-like-comentario" data-comentario-id="${id}" data-liked="false" style="background: none; border: none; cursor: pointer; padding: 0.25rem 0.5rem; display: inline-flex; align-items: center; gap: 0.25rem; border-radius: 1rem; transition: all 0.2s; background-color: #f3f4f6; font-size: 0.75rem;" onmouseover="this.style.backgroundColor='#e5e7eb'" onmouseout="this.style.backgroundColor='#f3f4f6'">
                                <svg class="like-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                                <span class="like-count" style="font-weight: 600; color: #6b7280;">${totalLikes > 0 ? totalLikes : '0'}</span>
                            </button>
                        </div>
                        <div class="respuestas-container" data-comentario-id="${id}" style="display: none; margin-top: 0.75rem;">
                            <div class="respuestas-list"></div>
                        </div>
                    </div>
                </div>
            `;
        }

        async function toggleVerRespuestas(comentarioId) {
            const btnVerRespuestas = document.querySelector(`.btn-ver-respuestas[data-comentario-id="${comentarioId}"]`);
            if (!btnVerRespuestas) return;
            
            const nivelActual = parseInt(btnVerRespuestas.getAttribute('data-nivel') || '1');
            const nivelMaximo = Math.min(nivelActual, 2);
            
            // Buscar el item del comentario
            let comentarioItem = document.querySelector(`.comentario-item[data-comentario-id="${comentarioId}"]`);
            if (!comentarioItem) {
                comentarioItem = document.querySelector(`.respuesta-item[data-comentario-id="${comentarioId}"]`);
            }
            if (!comentarioItem) return;
            
            // Determinar el nivel del comentario actual
            let nivelComentario = 0;
            if (comentarioItem.classList.contains('respuesta-item')) {
                const classList = Array.from(comentarioItem.classList);
                const nivelClass = classList.find(c => c.startsWith('nivel-'));
                if (nivelClass) {
                    nivelComentario = parseInt(nivelClass.replace('nivel-', ''));
                }
            }
            
            // Si es nivel 2, insertar respuestas como hermanos en el contenedor padre
            let respuestasContainer: HTMLElement;
            let respuestasList: HTMLElement;
            let isHermano = false;
            
            if (nivelComentario >= 2) {
                // Para nivel 2: buscar el contenedor padre e insertar como hermanos
                const contenedorPadre = comentarioItem.closest('.respuestas-list');
                if (contenedorPadre) {
                    respuestasList = contenedorPadre as HTMLElement;
                    isHermano = true;
                } else {
                    return;
                }
            } else {
                // Para nivel 0 y 1: usar contenedor hijo normal
                respuestasContainer = comentarioItem.querySelector(':scope > .comentario-content > .respuestas-container') as HTMLElement;
                if (!respuestasContainer) {
                    return;
                }
                respuestasList = respuestasContainer.querySelector('.respuestas-list') as HTMLElement;
            }

            // Verificar si las respuestas están visibles
            let isVisible = false;
            if (isHermano) {
                // Para hermanos: verificar si existen elementos con data-parent-id
                const respuestasHermanas = document.querySelectorAll(`.respuesta-item[data-parent-id="${comentarioId}"]`);
                isVisible = respuestasHermanas.length > 0;
            } else {
                // Para contenedor normal: verificar display
                isVisible = respuestasContainer.style.display !== 'none';
            }
            
            if (isVisible) {
                // Ocultar respuestas
                if (isHermano) {
                    // Para hermanos: remover las respuestas que se agregaron
                    const respuestasHermanas = respuestasList.querySelectorAll(`.respuesta-item[data-parent-id="${comentarioId}"]`);
                    respuestasHermanas.forEach(r => r.remove());
                } else {
                    respuestasContainer.style.display = 'none';
                }
                btnVerRespuestas.querySelector('.icono-toggle').style.transform = 'rotate(0deg)';
                const totalRespuestas = btnVerRespuestas.querySelector('.texto-respuestas').textContent.match(/\d+/)[0];
                btnVerRespuestas.querySelector('.texto-respuestas').textContent = `Ver respuestas (${totalRespuestas})`;
                btnVerRespuestas.classList.remove('active');
            } else {
                // Mostrar respuestas
                
                const needsLoading = isHermano ? true : (respuestasList.children.length === 0);
                
                if (needsLoading) {
                    // Cargar respuestas si no están cargadas
                    const loadingMsg = document.createElement('p');
                    loadingMsg.style.cssText = 'color: #9ca3af; font-size: 0.875rem; padding: 0.5rem 0;';
                    loadingMsg.textContent = 'Cargando respuestas...';
                    
                    if (isHermano) {
                        comentarioItem.insertAdjacentElement('afterend', loadingMsg);
                    } else {
                        respuestasList.appendChild(loadingMsg);
                    }
                    
                    const respuestas = await cargarRespuestas(comentarioId);
                    loadingMsg.remove();
                    
                    if (respuestas.length > 0) {
                        const token = getAuthToken();
                        for (const respuesta of respuestas) {
                            const respuestaHTML = crearRespuestaHTML(respuesta, nivelMaximo);
                            const tempDiv = document.createElement('div');
                            tempDiv.innerHTML = respuestaHTML;
                            const respuestaElement = tempDiv.firstElementChild as HTMLElement;
                            respuestaElement.setAttribute('data-parent-id', comentarioId.toString());
                            
                            if (isHermano) {
                                // Insertar como hermano después del comentario actual
                                comentarioItem.insertAdjacentElement('afterend', respuestaElement);
                            } else {
                                respuestasList.appendChild(respuestaElement);
                            }
                            
                            // Verificar like
                            try {
                                const likeRes = await fetch(`${API_URL}/comentarios/${respuesta.id}/mi-like`, {
                                    headers: { 'Authorization': `Bearer ${token}` }
                                });
                                
                                if (likeRes.status === 401) continue;
                                
                                const likeData = await likeRes.json();
                                if (likeData.success && likeData.data.liked) {
                                    actualizarUILike(respuesta.id, true, respuesta.totalLikes);
                                }
                            } catch {}
                        }
                    }
                }
                
                if (!isHermano) {
                    respuestasContainer.style.display = 'block';
                }
                btnVerRespuestas.classList.add('active');
                btnVerRespuestas.querySelector('.icono-toggle').style.transform = 'rotate(180deg)';
                const totalRespuestas = btnVerRespuestas.querySelector('.texto-respuestas').textContent.match(/\d+/)[0];
                btnVerRespuestas.querySelector('.texto-respuestas').textContent = `Ocultar respuestas (${totalRespuestas})`;
            }
        }

        // ========================================
        // Funciones para likes en comentarios
        // ========================================
        
        async function toggleLikeComentario(comentarioId) {
            const token = getAuthToken();
            if (!token) {
                alert('Debes iniciar sesión para dar me gusta');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/comentarios/${comentarioId}/like`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.status === 401) {
                    alert('Tu sesión ha expirado. Por favor inicia sesión nuevamente.');
                    setTimeout(() => {
                        window.location.href = '/acceso';
                    }, 1500);
                    return;
                }

                const result = await response.json();

                if (result.success) {
                    const { liked, totalLikes } = result.data;
                    actualizarUILike(comentarioId, liked, totalLikes);
                } else {
                    alert(result.message || 'Error al dar me gusta');
                }
            } catch (error) {
                console.error('Error al dar like:', error);
                alert('Error al procesar tu reacción');
            }
        }

        function actualizarUILike(comentarioId, liked, totalLikes) {
            const btnLike = document.querySelector(`.btn-like-comentario[data-comentario-id="${comentarioId}"]`);
            if (!btnLike) return;

            const iconoLike = btnLike.querySelector('.like-icon');
            const contadorLike = btnLike.querySelector('.like-count');
            
            btnLike.setAttribute('data-liked', liked ? 'true' : 'false');
            
            if (liked) {
                iconoLike.setAttribute('fill', '#dc2626');
                iconoLike.setAttribute('stroke', '#dc2626');
                btnLike.style.backgroundColor = '#fee2e2';
                contadorLike.style.color = '#dc2626';
                btnLike.onmouseover = () => btnLike.style.backgroundColor = '#fecaca';
                btnLike.onmouseout = () => btnLike.style.backgroundColor = '#fee2e2';
            } else {
                iconoLike.setAttribute('fill', 'none');
                iconoLike.setAttribute('stroke', '#6b7280');
                btnLike.style.backgroundColor = '#f3f4f6';
                contadorLike.style.color = '#6b7280';
                btnLike.onmouseover = () => btnLike.style.backgroundColor = '#e5e7eb';
                btnLike.onmouseout = () => btnLike.style.backgroundColor = '#f3f4f6';
            }
            
            contadorLike.textContent = totalLikes > 0 ? totalLikes : '0';
        }

        async function cargarEstadosLikesComentarios(comentarioIds = null) {
            const token = getAuthToken();
            if (!token) return;

            let botonesLike;
            if (comentarioIds && comentarioIds.length > 0) {
                botonesLike = comentarioIds.map(id => 
                    document.querySelector(`.btn-like-comentario[data-comentario-id="${id}"]`)
                ).filter(btn => btn !== null);
            } else {
                botonesLike = document.querySelectorAll('.btn-like-comentario');
            }
            for (const btn of botonesLike) {
                const comentarioId = btn.getAttribute('data-comentario-id');
                if (!comentarioId) continue;

                try {
                    const response = await fetch(`${API_URL}/comentarios/${comentarioId}/mi-like`, {
                        headers: {
                            'Authorization': `Bearer ${token}`
                        }
                    });

                    if (response.status === 401) {
                        return;
                    }

                    const result = await response.json();
                    if (result.success && result.data.liked) {
                        const totalLikes = parseInt(btn.querySelector('.like-count').textContent) || 0;
                        actualizarUILike(parseInt(comentarioId), true, totalLikes);
                    }
                } catch (error) {
                    console.error('Error verificando like:', error);
                }
            }
        }

        async function eliminarComentario(comentarioId) {
            const token = getAuthToken();
            if (!token) {
                alert('Debes iniciar sesión');
                return;
            }

            if (!confirm('¿Estás seguro de que quieres eliminar este comentario?')) {
                return;
            }

            try {
                const response = await fetch(`${API_URL}/comentarios/${comentarioId}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                const result = await response.json();

                if (result.success) {
                    // Remover el elemento del DOM
                    const comentarioItem = document.querySelector(`.comentario-item[data-comentario-id="${comentarioId}"], .respuesta-item[data-comentario-id="${comentarioId}"]`);
                    if (comentarioItem) {
                        comentarioItem.remove();
                    }
                } else {
                    alert(result.message || 'Error al eliminar comentario');
                }
            } catch (error) {
                console.error('Error eliminando comentario:', error);
                alert('Error al eliminar comentario');
            }
        }

        async function crearComentario(publicacionId, contenido) {
            const token = getAuthToken();
            if (!token) {
                alert('Debes iniciar sesión para comentar');
                return;
            }

            try {
                const response = await fetch(`${API_URL}/comentarios`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        publicacionId: publicacionId,
                        contenido: contenido
                    })
                });

                const result = await response.json();

                if (result.success) {
                    await cargarComentarios(publicacionId, 1);
                    const input = document.getElementById('comentario-input');
                    if (input) input.value = '';
                } else {
                    alert(result.message || 'Error al publicar comentario');
                }
            } catch (error) {
                console.error('Error creando comentario:', error);
                alert('Error al publicar comentario');
            }
        }

        // Función para mostrar/ocultar modal de comentarios
        function toggleComments(publicacionId) {
            currentPublicacionId = publicacionId;
            const modal = document.getElementById('comentarios-modal');
            if (!modal) return;

            const isVisible = modal.style.display === 'flex';
            
            if (isVisible) {
                modal.style.display = 'none';
                currentPublicacionId = null;
            } else {
                modal.style.display = 'flex';
                cargarComentarios(publicacionId, 1);
                
                // Ocultar el formulario si no es egresado
                const comentarioForm = document.getElementById('comentario-form');
                if (comentarioForm) {
                    if (isEgresado()) {
                        comentarioForm.style.display = 'flex';
                    } else {
                        comentarioForm.style.display = 'none';
                    }
                }
            }
        }

        // Event listener para el botón de cargar más
        document.addEventListener('DOMContentLoaded', () => {
            // Cargar primera página al cargar la página
            cargarPublicaciones(1);

            // Configurar botón de cargar más
            const loadMoreBtn = document.getElementById('load-more-btn');
            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', () => {
                    currentPage++;
                    cargarPublicaciones(currentPage);
                });
            }

            // Cerrar modal de comentarios
            const closeModalBtn = document.getElementById('close-modal-btn');
            if (closeModalBtn) {
                closeModalBtn.addEventListener('click', () => {
                    const modal = document.getElementById('comentarios-modal');
                    if (modal) {
                        modal.style.display = 'none';
                        currentPublicacionId = null;
                    }
                });
            }

            // Cerrar modal al hacer clic fuera
            const modal = document.getElementById('comentarios-modal');
            if (modal) {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        modal.style.display = 'none';
                        currentPublicacionId = null;
                    }
                });
            }

            // Cargar más comentarios
            const loadMoreCommentsBtn = document.getElementById('load-more-comments-btn');
            if (loadMoreCommentsBtn) {
                loadMoreCommentsBtn.addEventListener('click', () => {
                    if (currentPublicacionId) {
                        const comentariosList = document.getElementById('comentarios-list');
                        const currentCount = comentariosList?.children.length || 0;
                        const page = Math.floor(currentCount / 10) + 1;
                        cargarComentarios(currentPublicacionId, page);
                    }
                });
            }

            // Formulario de comentarios
            const comentarioForm = document.getElementById('comentario-form');
            if (comentarioForm) {
                comentarioForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const input = document.getElementById('comentario-input');
                    const contenido = input?.value?.trim();

                    if (!contenido) return;
                    if (!currentPublicacionId) return;

                    await crearComentario(currentPublicacionId, contenido);
                });
            }

            // Event delegation para botones dinámicos
            document.addEventListener('click', async (e) => {
                const target = e.target.closest('button');
                if (!target) return;

                // Botón ver/ocultar respuestas
                if (target.classList.contains('btn-ver-respuestas')) {
                    const comentarioId = target.getAttribute('data-comentario-id');
                    if (comentarioId) {
                        await toggleVerRespuestas(parseInt(comentarioId));
                    }
                    return;
                }

                // Botón like comentario
                if (target.classList.contains('btn-like-comentario')) {
                    const comentarioId = target.getAttribute('data-comentario-id');
                    if (comentarioId) {
                        await toggleLikeComentario(parseInt(comentarioId));
                    }
                    return;
                }

                // Botón eliminar comentario
                if (target.classList.contains('btn-eliminar-comentario')) {
                    const comentarioId = target.getAttribute('data-comentario-id');
                    if (comentarioId) {
                        await eliminarComentario(parseInt(comentarioId));
                    }
                    return;
                }

                // Botón responder
                if (target.classList.contains('btn-responder')) {
                    const comentarioId = parseInt(target.getAttribute('data-comentario-id') || '0');
                    if (comentarioId) {
                        // Buscar si ya existe un formulario de respuesta abierto
                        let comentarioItem = document.querySelector(`.comentario-item[data-comentario-id="${comentarioId}"]`);
                        if (!comentarioItem) {
                            comentarioItem = document.querySelector(`.respuesta-item[data-comentario-id="${comentarioId}"]`);
                        }
                        if (!comentarioItem) return;

                        // Remover cualquier formulario de respuesta existente
                        const formExistente = document.querySelector('.respuesta-form-container');
                        if (formExistente) {
                            formExistente.remove();
                        }

                        // Clonar template
                        const template = document.getElementById('respuesta-form-template');
                        if (!template) return;

                        const formClone = template.content.cloneNode(true);
                        const formContainer = formClone.querySelector('.respuesta-form-container');
                        const form = formClone.querySelector('.respuesta-form');
                        const input = formClone.querySelector('.respuesta-input');
                        const btnEnviar = formClone.querySelector('.btn-responder-enviar');
                        const btnCancelar = formClone.querySelector('.btn-responder-cancelar');

                        // Insertar después del footer del comentario
                        const comentarioContent = comentarioItem.querySelector('.comentario-content');
                        const comentarioFooter = comentarioContent.querySelector('.comentario-footer');
                        comentarioFooter.parentElement.insertBefore(formContainer, comentarioFooter.nextSibling);

                        // Focus en el input
                        input.focus();

                        // Manejar envío de respuesta
                        form.addEventListener('submit', async (e) => {
                            e.preventDefault();
                            const contenido = input.value.trim();

                            if (!contenido) {
                                alert('Escribe algo para responder');
                                return;
                            }

                            btnEnviar.disabled = true;
                            btnEnviar.textContent = 'Enviando...';

                            const nuevaRespuesta = await crearRespuesta(comentarioId, contenido);

                            if (nuevaRespuesta) {
                                // Determinar nivel de anidación
                                let nivelPadre = 1;
                                const respuestaItem = comentarioItem.classList.contains('respuesta-item');
                                if (respuestaItem) {
                                    const classList = Array.from(comentarioItem.classList);
                                    const nivelClass = classList.find(c => c.startsWith('nivel-'));
                                    if (nivelClass) {
                                        nivelPadre = parseInt(nivelClass.replace('nivel-', ''));
                                    }
                                }
                                const nivelHijo = nivelPadre + 1;

                                // Buscar o crear contenedor de respuestas
                                let respuestasContainer = comentarioItem.querySelector(':scope > .comentario-content > .respuestas-container');
                                if (!respuestasContainer) {
                                    respuestasContainer = document.createElement('div');
                                    respuestasContainer.className = 'respuestas-container';
                                    respuestasContainer.setAttribute('data-comentario-id', comentarioId.toString());
                                    respuestasContainer.style.cssText = 'display: none; margin-top: 0.75rem;';
                                    respuestasContainer.innerHTML = '<div class="respuestas-list"></div>';
                                    const comentarioContent = comentarioItem.querySelector(':scope > .comentario-content');
                                    comentarioContent.appendChild(respuestasContainer);
                                }

                                // Mostrar contenedor si estaba oculto
                                respuestasContainer.style.display = 'block';

                                // Agregar la nueva respuesta
                                const respuestasList = respuestasContainer.querySelector('.respuestas-list');
                                const respuestaHTML = crearRespuestaHTML(nuevaRespuesta, nivelHijo);
                                respuestasList.insertAdjacentHTML('beforeend', respuestaHTML);

                                // Actualizar contador
                                const comentarioFooter = comentarioItem.querySelector(':scope > .comentario-content > .comentario-footer');
                                let btnVerRespuestas = comentarioFooter.querySelector('.btn-ver-respuestas');
                                if (btnVerRespuestas) {
                                    const countSpan = btnVerRespuestas.querySelector('.texto-respuestas');
                                    const currentCount = parseInt(countSpan.textContent.match(/\d+/)[0]) || 0;
                                    countSpan.textContent = `Ocultar respuestas (${currentCount + 1})`;
                                    btnVerRespuestas.classList.add('active');
                                    btnVerRespuestas.querySelector('.icono-toggle').style.transform = 'rotate(180deg)';
                                } else {
                                    const btnResponder = comentarioFooter.querySelector('.btn-responder');
                                    const verRespuestasBtn = document.createElement('button');
                                    verRespuestasBtn.className = 'btn-ver-respuestas active';
                                    verRespuestasBtn.setAttribute('data-comentario-id', comentarioId.toString());
                                    verRespuestasBtn.setAttribute('data-nivel', (nivelHijo).toString());
                                    verRespuestasBtn.style.cssText = 'background: none; border: none; color: #2563eb; font-size: 0.75rem; font-weight: 500; cursor: pointer; padding: 0; display: flex; align-items: center; gap: 0.25rem;';
                                    verRespuestasBtn.innerHTML = `
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icono-toggle" style="transform: rotate(180deg);">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                        <span class="texto-respuestas">Ocultar respuestas (1)</span>
                                    `;
                                    btnResponder.parentNode.insertBefore(verRespuestasBtn, btnResponder.nextSibling);
                                }

                                // Cargar estado de like
                                await cargarEstadosLikesComentarios([nuevaRespuesta.id]);

                                formContainer.remove();
                            } else {
                                btnEnviar.disabled = false;
                                btnEnviar.textContent = 'Responder';
                            }
                        });

                        // Manejar cancelar
                        btnCancelar.addEventListener('click', () => {
                            formContainer.remove();
                        });
                    }
                    return;
                }
            });
        });

        // Exponer función globalmente
        window.toggleComments = toggleComments;
    </script>
</BaseLayout>