---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Inicio">
    <section class="hero">
        <div class="container">
            <div class="text-center">
                <h1 class="hero-title">Instituto de Educación Superior</h1>
                <h2 class="hero-subtitle">Sistema de Gestión de Egresados</h2>
                <p class="hero-description">
                    Plataforma oficial para el seguimiento y vinculación de
                    nuestros egresados con el mundo profesional y la comunidad
                    educativa.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>
