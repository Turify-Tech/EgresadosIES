        async function toggleVerRespuestas(comentarioId) {
            const btnVerRespuestas = document.querySelector(
                `.btn-ver-respuestas[data-comentario-id="${comentarioId}"]`,
            );
            if (!btnVerRespuestas) return;

            const nivelActual = parseInt(
                btnVerRespuestas.getAttribute("data-nivel") || "1",
            );
            const nivelMaximo = Math.min(nivelActual, 2);

            let comentarioItem = document.querySelector(
                `.comentario-item[data-comentario-id="${comentarioId}"]`,
            );
            if (!comentarioItem) {
                comentarioItem = document.querySelector(
                    `.respuesta-item[data-comentario-id="${comentarioId}"]`,
                );
            }
            if (!comentarioItem) return;

            let nivelComentario = 0;
            if (comentarioItem.classList.contains("respuesta-item")) {
                const classList = Array.from(comentarioItem.classList);
                const nivelClass = classList.find((c) =>
                    c.startsWith("nivel-"),
                );
                if (nivelClass) {
                    nivelComentario = parseInt(
                        nivelClass.replace("nivel-", ""),
                    );
                }
            }

            let respuestasContainer;
            let respuestasList;
            let isHermano = false;

            if (nivelComentario >= 2) {
                const contenedorPadre =
                    comentarioItem.closest(".respuestas-list");
                if (contenedorPadre) {
                    respuestasList = contenedorPadre;
                    isHermano = true;
                } else {
                    return;
                }
            } else {
                respuestasContainer = comentarioItem.querySelector(
                    ":scope > .comentario-content > .respuestas-container",
                );
                if (!respuestasContainer) return;
                respuestasList =
                    respuestasContainer.querySelector(".respuestas-list");
            }

            let isVisible = false;
            if (isHermano) {
                const respuestasHermanas = document.querySelectorAll(
                    `.respuesta-item[data-parent-id="${comentarioId}"]`,
                );
                isVisible = respuestasHermanas.length > 0;
            } else {
                isVisible = respuestasContainer.style.display !== "none";
            }

            if (isVisible) {
                if (isHermano) {
                    const respuestasHermanas = respuestasList.querySelectorAll(
                        `.respuesta-item[data-parent-id="${comentarioId}"]`,
                    );
                    respuestasHermanas.forEach((r) => r.remove());
                } else {
                    respuestasContainer.style.display = "none";
                }
                btnVerRespuestas.querySelector(
                    ".icono-toggle",
                ).style.transform = "rotate(0deg)";
                const totalRespuestas = btnVerRespuestas
                    .querySelector(".texto-respuestas")
                    .textContent.match(/\d+/)[0];
                btnVerRespuestas.querySelector(
                    ".texto-respuestas",
                ).textContent = `Ver respuestas (${totalRespuestas})`;
                btnVerRespuestas.classList.remove("active");
            } else {
                const needsLoading = isHermano
                    ? true
                    : respuestasList.children.length === 0;

                if (needsLoading) {
                    const loadingMsg = document.createElement("p");
                    loadingMsg.style.cssText =
                        "color: #9ca3af; font-size: 0.875rem; padding: 0.5rem 0;";
                    loadingMsg.textContent = "Cargando respuestas...";

                    if (isHermano) {
                        comentarioItem.insertAdjacentElement(
                            "afterend",
                            loadingMsg,
                        );
                    } else {
                        respuestasList.appendChild(loadingMsg);
                    }

                    const respuestas = await cargarRespuestas(comentarioId);
                    loadingMsg.remove();

                    if (respuestas.length > 0) {
                        const token = getAuthToken();
                        for (const respuesta of respuestas) {
                            const respuestaHTML = await crearRespuestaHTML(
                                respuesta,
                                nivelMaximo,
                            );
                            const tempDiv = document.createElement("div");
                            tempDiv.innerHTML = respuestaHTML;
                            const respuestaElement = tempDiv.firstElementChild;
                            respuestaElement.setAttribute(
                                "data-parent-id",
                                comentarioId.toString(),
                            );

                            if (isHermano) {
                                comentarioItem.insertAdjacentElement(
                                    "afterend",
                                    respuestaElement,
                                );
                            } else {
                                respuestasList.appendChild(respuestaElement);
                            }

                            try {
                                const likeRes = await fetch(
                                    `${API_URL}/comentarios/${respuesta.id}/mi-like`,
                                    {
                                        headers: {
                                            Authorization: `Bearer ${token}`,
                                        },
                                    },
                                );

                                if (likeRes.status === 401) continue;

                                const likeData = await likeRes.json();
                                if (likeData.success && likeData.data.liked) {
                                    actualizarUILike(
                                        respuesta.id,
                                        true,
                                        respuesta.totalLikes,
                                    );
                                }
                            } catch {}
                        }
                    }
                }

                if (!isHermano) {
                    respuestasContainer.style.display = "block";
                }
                btnVerRespuestas.classList.add("active");
                btnVerRespuestas.querySelector(
                    ".icono-toggle",
                ).style.transform = "rotate(180deg)";
                const totalRespuestas = btnVerRespuestas
                    .querySelector(".texto-respuestas")
                    .textContent.match(/\d+/)[0];
                btnVerRespuestas.querySelector(
                    ".texto-respuestas",
                ).textContent = `Ocultar respuestas (${totalRespuestas})`;
            }
        }

        async function crearRespuesta(comentarioPadreId, contenido) {
            const token = getAuthToken();
            if (!token) {
                showNotification(
                    "Debes iniciar sesión para responder",
                    "error",
                );
                return false;
            }

            try {
                const response = await fetch(`${API_URL}/comentarios`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Authorization: `Bearer ${token}`,
                    },
                    body: JSON.stringify({
                        publicacionId: currentPublicacionId,
                        contenido: contenido,
                        comentarioPadreId: comentarioPadreId,
                    }),
                });

                if (response.status === 401) {
                    showNotification(
                        "Tu sesión ha expirado. Por favor inicia sesión nuevamente.",
                        "error",
                    );
                    setTimeout(() => {
                        window.location.href = "/acceso";
                    }, 1500);
                    return false;
                }

                const result = await response.json();

                if (result.success) {
                    showNotification("Respuesta publicada", "success");
                    return result.data;
                } else {
                    showNotification(
                        result.message || "Error al publicar respuesta",
                        "error",
                    );
                    return false;
                }
            } catch (error) {
                console.error("Error creando respuesta:", error);
                showNotification("Error al publicar respuesta", "error");
                return false;
            }
        }

        async function cargarRespuestas(comentarioId) {
            const token = getAuthToken();

            try {
                const response = await fetch(
                    `${API_URL}/comentarios/${comentarioId}/respuestas?limit=20`,
                    {
                        headers: {
                            Authorization: `Bearer ${token}`,
                        },
                    },
                );

                if (response.status === 401) {
                    showNotification(
                        "Tu sesión ha expirado. Por favor inicia sesión nuevamente.",
                        "error",
                    );
                    setTimeout(() => {
                        window.location.href = "/acceso";
                    }, 1500);
                    return [];
                }

                const result = await response.json();

                if (result.success && result.data) {
                    return result.data;
                }
                return [];
            } catch (error) {
                console.error("Error cargando respuestas:", error);
                return [];
            }
        }

        async function editarComentario(comentarioId, nuevoContenido) {
            const token = getAuthToken();
            if (!token) {
                showNotification("Debes iniciar sesión", "error");
                return false;
            }

            try {
                const response = await fetch(
                    `${API_URL}/comentarios/${comentarioId}`,
                    {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json",
                            Authorization: `Bearer ${token}`,
                        },
                        body: JSON.stringify({ contenido: nuevoContenido }),
                    },
                );

                const result = await response.json();

                if (result.success) {
                    showNotification("Comentario editado", "success");
                    return true;
                } else {
                    showNotification(
                        result.message || "Error al editar comentario",
                        "error",
                    );
                    return false;
                }
            } catch (error) {
                console.error("Error editando comentario:", error);
                showNotification("Error al editar comentario", "error");
                return false;
            }
        }

        async function eliminarComentario(comentarioId) {
            if (
                !confirm(
                    "¿Estás seguro de que quieres eliminar este comentario?",
                )
            ) {
                return;
            }

            const token = getAuthToken();
            if (!token) {
                showNotification("Debes iniciar sesión", "error");
                return;
            }

            try {
                const response = await fetch(
                    `${API_URL}/comentarios/${comentarioId}`,
                    {
                        method: "DELETE",
                        headers: {
                            Authorization: `Bearer ${token}`,
                        },
                    },
                );

                const result = await response.json();

                if (result.success) {
                    const comentarioItem = document.querySelector(
                        `.comentario-item[data-comentario-id="${comentarioId}"]`,
                    );
                    if (comentarioItem) {
                        comentarioItem.remove();
                    } else {
                        const respuestaItem = document.querySelector(
                            `.respuesta-item[data-comentario-id="${comentarioId}"]`,
                        );
                        if (respuestaItem) respuestaItem.remove();
                    }

                    const comentariosContainer =
                        document.getElementById("comentarios-list");
                    if (
                        comentariosContainer &&
                        comentariosContainer.children.length === 0
                    ) {
                        comentariosContainer.innerHTML =
                            '<p class="no-comentarios">No hay comentarios en esta publicación.</p>';
                    }

                    showNotification("Comentario eliminado", "success");
                } else {
                    showNotification(
                        result.message || "Error al eliminar comentario",
                        "error",
                    );
                }
            } catch (error) {
                console.error("Error eliminando comentario:", error);
                showNotification("Error al eliminar comentario", "error");
            }
        }

        async function toggleLikeComentario(comentarioId) {
            const token = getAuthToken();
            if (!token) {
                showNotification(
                    "Debes iniciar sesión para dar me gusta",
                    "error",
                );
                return;
            }

            try {
                const response = await fetch(
                    `${API_URL}/comentarios/${comentarioId}/like`,
                    {
                        method: "POST",
                        headers: {
                            Authorization: `Bearer ${token}`,
                        },
                    },
                );

                if (response.status === 401) {
                    showNotification(
                        "Tu sesión ha expirado. Por favor inicia sesión nuevamente.",
                        "error",
                    );
                    setTimeout(() => {
                        window.location.href = "/acceso";
                    }, 1500);
                    return;
                }

                const result = await response.json();

                if (result.success) {
                    const { liked, totalLikes } = result.data;
                    actualizarUILike(comentarioId, liked, totalLikes);
                } else {
                    showNotification(
                        result.message || "Error al dar me gusta",
                        "error",
                    );
                }
            } catch (error) {
                console.error("Error al dar like:", error);
                showNotification("Error al procesar tu reacción", "error");
            }
        }

        function actualizarUILike(comentarioId, liked, totalLikes) {
            const btnLike = document.querySelector(
                `.btn-like-comentario[data-comentario-id="${comentarioId}"]`,
            );
            if (!btnLike) return;

            const iconoLike = btnLike.querySelector(".like-icon");
            const contadorLike = btnLike.querySelector(".like-count");

            btnLike.setAttribute("data-liked", liked ? "true" : "false");

            if (liked) {
                iconoLike?.setAttribute("fill", "#dc2626");
                iconoLike?.setAttribute("stroke", "#dc2626");
                btnLike.style.backgroundColor = "#fee2e2";
                if (contadorLike) contadorLike.style.color = "#dc2626";
                btnLike.onmouseover = () =>
                    (btnLike.style.backgroundColor = "#fecaca");
                btnLike.onmouseout = () =>
                    (btnLike.style.backgroundColor = "#fee2e2");
            } else {
                iconoLike?.setAttribute("fill", "none");
                iconoLike?.setAttribute("stroke", "#6b7280");
                btnLike.style.backgroundColor = "#f3f4f6";
                if (contadorLike) contadorLike.style.color = "#6b7280";
                btnLike.onmouseover = () =>
                    (btnLike.style.backgroundColor = "#e5e7eb");
                btnLike.onmouseout = () =>
                    (btnLike.style.backgroundColor = "#f3f4f6");
            }

            if (contadorLike) {
                contadorLike.textContent = totalLikes > 0 ? totalLikes : "0";
            }
        }

        // Función para cargar comentarios
        async function cargarComentarios(publicacionId, page = 1) {
            const comentariosList = document.getElementById("comentarios-list");
            if (!comentariosList) return;

            try {
                const response = await fetch(
                    `${API_URL}/comentarios/publicacion/${publicacionId}?page=${page}&limit=10`,
                );
                const result = await response.json();

                if (result.success) {
                    if (page === 1) {
                        comentariosList.innerHTML = "";
                    }

                    const comentarios = result.data || [];

                    if (comentarios.length === 0 && page === 1) {
                        comentariosList.innerHTML =
                            '<p class="no-comentarios">No hay comentarios en esta publicación.</p>';
                    } else {
                        const token = getAuthToken();
                        for (const comentario of comentarios) {
                            const comentarioHTML =
                                await crearComentarioHTML(comentario);
                            comentariosList.insertAdjacentHTML(
                                "beforeend",
                                comentarioHTML,
                            );

                            // Verificar si el usuario dio like
                            if (token) {
                                try {
                                    const likeRes = await fetch(
                                        `${API_URL}/comentarios/${comentario.id}/mi-like`,
                                        {
                                            headers: {
                                                Authorization: `Bearer ${token}`,
                                            },
                                        },
                                    );

                                    if (likeRes.status !== 401) {
                                        const likeData = await likeRes.json();
                                        if (
                                            likeData.success &&
                                            likeData.data.liked
                                        ) {
                                            actualizarUILike(
                                                comentario.id,
                                                true,
                                                comentario.totalLikes,
                                            );
                                        }
                                    }
                                } catch {}
                            }
                        }
                    }

                    const pagination = document.getElementById(
                        "comentarios-pagination",
                    );
                    if (pagination && result.pagination) {
                        pagination.style.display = result.pagination.hasNextPage
                            ? "block"
                            : "none";
                    }
                }
            } catch (error) {
                console.error("Error cargando comentarios:", error);
                comentariosList.innerHTML =
                    '<p class="error-comentarios">Error al cargar comentarios</p>';
            }
        }

        // Función para mostrar/ocultar modal de comentarios
        function toggleComments(publicacionId, event = null) {
            currentPublicacionId = publicacionId;

            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            const modal = document.getElementById("comentarios-modal");
            if (!modal) return;

            const isVisible = modal.style.display === "flex";

            if (isVisible) {
                modal.style.display = "none";
                currentPublicacionId = null;
                document.documentElement.style.overflow = "";
                document.body.style.overflow = "";
            } else {
                modal.style.display = "flex";
                document.documentElement.style.overflow = "hidden";
                document.body.style.overflow = "hidden";
                cargarComentarios(publicacionId, 1);
            }
        }

        function cerrarModal() {
            const modal = document.getElementById("comentarios-modal");
            if (modal) {
                modal.style.display = "none";
                currentPublicacionId = null;
                document.documentElement.style.overflow = "";
                document.body.style.overflow = "";
            }
        }

        // Event listener para inicialización
        document.addEventListener("DOMContentLoaded", async () => {
            // Cargar datos del usuario actual
            currentUser = await cargarUsuarioActual();

            // Cargar primera página al cargar la página
            cargarMisPublicaciones(1);

            // Configurar botón de cargar más
            const loadMoreBtn = document.getElementById("load-more-btn");
            if (loadMoreBtn) {
                loadMoreBtn.addEventListener("click", () => {
                    currentPage++;
                    cargarMisPublicaciones(currentPage);
                });
            }

            // Cerrar modal de comentarios
            const closeModalBtn = document.getElementById("close-modal-btn");
            if (closeModalBtn) {
                closeModalBtn.addEventListener("click", cerrarModal);
            }

            // Cerrar modal al hacer clic fuera
            const modal = document.getElementById("comentarios-modal");
            if (modal) {
                modal.addEventListener("click", (e) => {
                    if (e.target === modal) {
                        cerrarModal();
                    }
                });
            }

            // Cargar más comentarios
            const loadMoreCommentsBtn = document.getElementById(
                "load-more-comments-btn",
            );
            if (loadMoreCommentsBtn) {
                loadMoreCommentsBtn.addEventListener("click", () => {
                    if (currentPublicacionId) {
                        const comentariosList =
                            document.getElementById("comentarios-list");
                        const currentCount =
                            comentariosList?.children.length || 0;
                        const page = Math.floor(currentCount / 10) + 1;
                        cargarComentarios(currentPublicacionId, page);
                    }
                });
            }

            // Event listeners para el modal de imágenes
            const imagenModal = document.getElementById("imagen-modal");
            const modalCerrar = document.getElementById("modal-cerrar");
            const modalPrev = document.getElementById("modal-prev");
            const modalNext = document.getElementById("modal-next");

            // Cerrar modal con botón X
            if (modalCerrar) {
                modalCerrar.addEventListener("click", cerrarModalImagen);
            }

            // Navegación con botones
            if (modalPrev) {
                modalPrev.addEventListener("click", () =>
                    navegarImagenModal("prev"),
                );
            }

            if (modalNext) {
                modalNext.addEventListener("click", () =>
                    navegarImagenModal("next"),
                );
            }

            // Cerrar modal al hacer clic en el fondo
            if (imagenModal) {
                imagenModal.addEventListener("click", (e) => {
                    if (e.target === imagenModal) {
                        cerrarModalImagen();
                    }
                });
            }

            // Navegación con teclado
            document.addEventListener("keydown", (e) => {
                if (imagenModal && imagenModal.style.display === "flex") {
                    if (e.key === "Escape") {
                        cerrarModalImagen();
                    } else if (e.key === "ArrowLeft") {
                        navegarImagenModal("prev");
                    } else if (e.key === "ArrowRight") {
                        navegarImagenModal("next");
                    }
                }
            });

            // Event delegation para clicks en imágenes de publicaciones
            document.addEventListener("click", async (e) => {
                const target = e.target;

                // Clicks en menciones - redirigir al perfil
                if (target.classList && target.classList.contains('mention')) {
                    e.preventDefault();
                    const userId = target.getAttribute('data-user-id');
                    if (userId) {
                        window.location.href = `/perfil/${userId}`;
                    }
                    return;
                }

                // Clicks en imágenes de publicaciones
                const container = target.closest(".imagen-container");
                if (container) {
                    const publicacionImagenes = container.closest(
                        ".publicacion-imagenes",
                    );
                    if (publicacionImagenes) {
                        const imagenesJSON =
                            publicacionImagenes.getAttribute("data-imagenes");
                        if (imagenesJSON) {
                            try {
                                const imagenes = JSON.parse(imagenesJSON);
                                const index =
                                    parseInt(
                                        container.getAttribute(
                                            "data-imagen-index",
                                        ),
                                    ) || 0;
                                abrirModalImagen(imagenes, index);
                            } catch (error) {
                                console.error(
                                    "Error parseando imágenes:",
                                    error,
                                );
                            }
                        }
                    }
                    return;
                }

                // Botón responder
                const btnResponder = target?.closest(".btn-responder");
                if (btnResponder) {
                    const comentarioId = parseInt(
                        btnResponder.getAttribute("data-comentario-id") || "0",
                    );
                    if (comentarioId) {
                        let comentarioItem = document.querySelector(
                            `.comentario-item[data-comentario-id="${comentarioId}"]`,
                        );
                        if (!comentarioItem) {
                            comentarioItem = document.querySelector(
                                `.respuesta-item[data-comentario-id="${comentarioId}"]`,
                            );
                        }
                        if (!comentarioItem) return;

                        const comentarioContent = comentarioItem.querySelector(
                            ".comentario-content",
                        );
                        if (!comentarioContent) return;

                        let existingForm =
                            comentarioContent.querySelector(".form-responder");
                        if (existingForm) {
                            existingForm.remove();
                            return;
                        }

                        const formContainer = document.createElement("div");
                        formContainer.className = "form-responder";
                        formContainer.style.cssText =
                            "margin-top: 0.75rem; padding: 0.75rem; background-color: #f9fafb; border-radius: 8px;";

                        const textarea = document.createElement("textarea");
                        textarea.placeholder = "Escribe tu respuesta...";
                        textarea.style.cssText =
                            "width: 100%; min-height: 60px; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 8px; font-family: inherit; font-size: 0.875rem; resize: none;";

                        const botonesDiv = document.createElement("div");
                        botonesDiv.style.cssText =
                            "display: flex; gap: 0.5rem; margin-top: 0.5rem;";

                        const btnPublicar = document.createElement("button");
                        btnPublicar.textContent = "Publicar";
                        btnPublicar.style.cssText =
                            "padding: 0.5rem 1rem; background-color: #3b82f6; color: white; border: none; border-radius: 20px; cursor: pointer; font-size: 0.875rem; font-weight: 500;";

                        const btnCancelar = document.createElement("button");
                        btnCancelar.textContent = "Cancelar";
                        btnCancelar.style.cssText =
                            "padding: 0.5rem 1rem; background-color: #6b7280; color: white; border: none; border-radius: 20px; cursor: pointer; font-size: 0.875rem; font-weight: 500;";

                        botonesDiv.appendChild(btnPublicar);
                        botonesDiv.appendChild(btnCancelar);
                        formContainer.appendChild(textarea);
                        formContainer.appendChild(botonesDiv);

                        comentarioContent.appendChild(formContainer);
                        textarea.focus();

                        btnPublicar.addEventListener("click", async () => {
                            const contenido = textarea.value.trim();
                            if (!contenido) {
                                showNotification(
                                    "Escribe algo para responder",
                                    "error",
                                );
                                return;
                            }

                            btnPublicar.disabled = true;
                            btnPublicar.textContent = "Publicando...";

                            const respuestaCreada = await crearRespuesta(
                                comentarioId,
                                contenido,
                            );

                            if (respuestaCreada) {
                                formContainer.remove();

                                let nivelPadre = 0;
                                if (
                                    comentarioItem.classList.contains(
                                        "respuesta-item",
                                    )
                                ) {
                                    const nivelStr =
                                        comentarioItem.getAttribute(
                                            "data-nivel",
                                        );
                                    nivelPadre = nivelStr
                                        ? parseInt(nivelStr)
                                        : 1;
                                }

                                const respuestaHTML = await crearRespuestaHTML(
                                    respuestaCreada,
                                    nivelPadre + 1,
                                );
                                const tempDiv = document.createElement("div");
                                tempDiv.innerHTML = respuestaHTML;
                                const respuestaElement =
                                    tempDiv.firstElementChild;

                                if (nivelPadre >= 2) {
                                    const respuestasList =
                                        comentarioItem.closest(
                                            ".respuestas-list",
                                        );
                                    if (respuestasList) {
                                        respuestaElement.setAttribute(
                                            "data-parent-id",
                                            comentarioId.toString(),
                                        );
                                        comentarioItem.insertAdjacentElement(
                                            "afterend",
                                            respuestaElement,
                                        );
                                    }
                                } else {
                                    let respuestasContainer =
                                        comentarioItem.querySelector(
                                            ":scope > .comentario-content > .respuestas-container",
                                        );
                                    if (!respuestasContainer) return;

                                    const respuestasList =
                                        respuestasContainer.querySelector(
                                            ".respuestas-list",
                                        );
                                    if (respuestasList) {
                                        respuestasList.appendChild(
                                            respuestaElement,
                                        );
                                    }
                                    respuestasContainer.style.display = "block";

                                    let btnVerRespuestas =
                                        comentarioContent?.querySelector(
                                            ".btn-ver-respuestas",
                                        );
                                    if (!btnVerRespuestas) {
                                        const comentarioFooter =
                                            comentarioContent.querySelector(
                                                ".comentario-footer",
                                            );
                                        if (comentarioFooter) {
                                            const btnResponderExistente =
                                                comentarioFooter.querySelector(
                                                    ".btn-responder",
                                                );
                                            const verRespuestasBtn =
                                                document.createElement(
                                                    "button",
                                                );
                                            verRespuestasBtn.className =
                                                "btn-ver-respuestas active";
                                            verRespuestasBtn.setAttribute(
                                                "data-comentario-id",
                                                comentarioId.toString(),
                                            );
                                            verRespuestasBtn.style.cssText =
                                                "background: none; border: none; color: #2563eb; font-size: 0.8125rem; font-weight: 500; cursor: pointer; padding: 0; display: flex; align-items: center; gap: 0.25rem;";
                                            verRespuestasBtn.innerHTML = `
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icono-toggle" style="transform: rotate(180deg);">
                                                    <polyline points="6 9 12 15 18 9"></polyline>
                                                </svg>
                                                <span class="texto-respuestas">Ocultar respuestas (1)</span>
                                            `;
                                            if (btnResponderExistente) {
                                                btnResponderExistente.insertAdjacentElement(
                                                    "afterend",
                                                    verRespuestasBtn,
                                                );
                                            } else {
                                                comentarioFooter.appendChild(
                                                    verRespuestasBtn,
                                                );
                                            }
                                        }
                                    }
                                }
                            } else {
                                btnPublicar.disabled = false;
                                btnPublicar.textContent = "Publicar";
                            }
                        });

                        btnCancelar.addEventListener("click", () => {
                            formContainer.remove();
                        });
                    }
                    return;
                }

                // Botón de ver respuestas
                const btnVerRespuestas = target?.closest(".btn-ver-respuestas");
                if (btnVerRespuestas) {
                    const comentarioId = parseInt(
                        btnVerRespuestas.getAttribute("data-comentario-id") ||
                            "0",
                    );
                    if (comentarioId) {
                        await toggleVerRespuestas(comentarioId);
                    }
                    return;
                }

                // Botón de like en comentarios
                const btnLike = target?.closest(".btn-like-comentario");
                if (btnLike) {
                    const comentarioId = parseInt(
                        btnLike.getAttribute("data-comentario-id") || "0",
                    );
                    if (comentarioId) {
                        await toggleLikeComentario(comentarioId);
                    }
                    return;
                }

                // Botón de editar
                const btnEditar = target?.closest(".btn-editar-comentario");
                if (btnEditar) {
                    const comentarioId = parseInt(
                        btnEditar.getAttribute("data-comentario-id") || "0",
                    );
                    if (comentarioId) {
                        const comentarioItem = document.querySelector(
                            `.comentario-item[data-comentario-id="${comentarioId}"]`,
                        );
                        if (!comentarioItem) return;

                        const parrafo = comentarioItem.querySelector(
                            `p[data-comentario-id="${comentarioId}"]`,
                        );
                        if (!parrafo) return;

                        const contenidoOriginal = parrafo.textContent || "";

                        const textarea = document.createElement("textarea");
                        textarea.value = contenidoOriginal;
                        textarea.className = "editar-comentario-textarea";
                        textarea.style.cssText =
                            "width: 100%; min-height: 60px; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 8px; font-family: inherit; font-size: 0.875rem; resize: none;";

                        const botonesDiv = document.createElement("div");
                        botonesDiv.style.cssText =
                            "display: flex; gap: 0.5rem; margin-top: 0.5rem;";

                        const btnGuardar = document.createElement("button");
                        btnGuardar.textContent = "Guardar";
                        btnGuardar.style.cssText =
                            "padding: 0.5rem 1rem; background-color: #3b82f6; color: white; border: none; border-radius: 20px; cursor: pointer; font-size: 0.875rem; font-weight: 500;";

                        const btnCancelar = document.createElement("button");
                        btnCancelar.textContent = "Cancelar";
                        btnCancelar.style.cssText =
                            "padding: 0.5rem 1rem; background-color: #6b7280; color: white; border: none; border-radius: 20px; cursor: pointer; font-size: 0.875rem; font-weight: 500;";

                        botonesDiv.appendChild(btnGuardar);
                        botonesDiv.appendChild(btnCancelar);

                        parrafo.style.display = "none";
                        parrafo.insertAdjacentElement("afterend", botonesDiv);
                        parrafo.insertAdjacentElement("afterend", textarea);
                        textarea.focus();

                        btnGuardar.addEventListener("click", async () => {
                            const nuevoContenido = textarea.value.trim();
                            if (!nuevoContenido) {
                                showNotification(
                                    "El comentario no puede estar vacío",
                                    "error",
                                );
                                return;
                            }

                            btnGuardar.disabled = true;
                            btnGuardar.textContent = "Guardando...";

                            const exito = await editarComentario(
                                comentarioId,
                                nuevoContenido,
                            );

                            if (exito) {
                                parrafo.textContent = nuevoContenido;
                                textarea.remove();
                                botonesDiv.remove();
                                parrafo.style.display = "";
                            } else {
                                btnGuardar.disabled = false;
                                btnGuardar.textContent = "Guardar";
                            }
                        });

                        btnCancelar.addEventListener("click", () => {
                            textarea.remove();
                            botonesDiv.remove();
                            parrafo.style.display = "";
                        });
                    }
                    return;
                }

                // Botón de eliminar
                const btnEliminar = target?.closest(".btn-eliminar-comentario");
                if (btnEliminar) {
                    const comentarioId = parseInt(
                        btnEliminar.getAttribute("data-comentario-id") || "0",
                    );
                    if (comentarioId) {
                        await eliminarComentario(comentarioId);
                    }
                    return;
                }
            });
        });

        // Exponer funciones globalmente
        window.toggleComments = toggleComments;
        window.eliminarPublicacion = eliminarPublicacion;
    </script>
</BaseLayout>
