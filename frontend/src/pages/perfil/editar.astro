            async saveHabilidades() {
                try {
                    console.log("💾 Guardando habilidades...");

                    // Obtener datos del HabilidadesManager
                    if (window.habilidadesManager) {
                        const data = window.habilidadesManager.getFormData();
                        console.log("Datos de habilidades:", data);

                        const todasHabilidades = [
                            ...(data.habilidadesTecnicas || []),
                            ...(data.habilidadesBlandas || []),
                        ];

                        console.log("Total de habilidades a guardar:", todasHabilidades.length);

                        if (todasHabilidades.length > 0) {
                            for (const habilidad of todasHabilidades) {
                                // Solo guardar si tiene nombre
                                if (habilidad.nombre && habilidad.nombre.trim()) {
                                    // Preparar datos limpios para la API
                                    const habilidadData = {
                                        nombre: habilidad.nombre.trim(),
                                        tipo: habilidad.tipo || "tecnica",
                                        nivel: habilidad.nivel || "intermedio",
                                    };

                                    console.log("Guardando habilidad:", habilidadData);

                                    try {
                                        if (habilidad.id) {
                                            // Actualizar habilidad existente
                                            await profileService.updateHabilidad(
                                                habilidad.id,
                                                habilidadData
                                            );
                                            console.log(`✅ Habilidad ${habilidad.id} actualizada`);
                                        } else {
                                            // Crear nueva habilidad
                                            const response = await profileService.addHabilidad(
                                                habilidadData
                                            );
                                            if (response.success && response.data) {
                                                // Actualizar el ID en el manager
                                                habilidad.id = response.data.id;
                                                console.log(`✅ Habilidad creada con ID ${habilidad.id}`);
                                            }
                                        }
                                    } catch (error) {
                                        console.error(`Error guardando habilidad "${habilidad.nombre}":`, error);
                                        // Continuar con las demás habilidades incluso si una falla
                                    }
                                }
                            }
                        }

                        this.showNotification("Habilidades guardadas correctamente", "success");
                        this.hasUnsavedChanges = false;

                        // Recargar datos después del guardado exitoso
                        console.log(
                            "✅ Habilidades guardadas, recargando datos..."
                        );
                        await this.loadUserProfile();

                        return true;
                    } else {
                        console.warn("HabilidadesManager no encontrado");
                        return false;
                    }
                } catch (error) {
                    console.error("Error guardando habilidades:", error);

                    // Mostrar error específico al usuario
                    let errorMessage = "Error al guardar habilidades";

                    if (error.response && error.response.data) {
                        // Error del backend con detalles
                        if (
                            error.response.data.details &&
                            Array.isArray(error.response.data.details)
                        ) {
                            errorMessage = `Error de validación: ${error.response.data.details.join(", ")}`;
                        } else if (error.response.data.error) {
                            errorMessage = error.response.data.error;
                        }
                    } else if (error.message) {
                        errorMessage = error.message;
                    }

                    this.showNotification(errorMessage, "error");
                    throw error;
                }
            }

            async saveProyectos() {
                try {
                    console.log("💾 Guardando proyectos...");

                    // Obtener datos del ProyectosManager
                    if (window.proyectosManager) {
                        const data = window.proyectosManager.getFormData();
                        console.log("Datos de proyectos:", data);

                        if (data.proyectos && data.proyectos.length > 0) {
                            for (const proyecto of data.proyectos) {
                                if (proyecto.nombre) {
                                    // Preparar datos limpios para la API
                                    const proyectoData = {
                                        nombre: proyecto.nombre,
                                        descripcion:
                                            proyecto.descripcion || null,
                                        enlace: proyecto.enlace || null,
                                        tecnologias:
                                            proyecto.tecnologias || null,
                                        fechaProyecto:
                                            proyecto.fechaProyecto || null,
                                        imagen: proyecto.imagen || null,
                                    };

                                    if (proyecto.id) {
                                        await profileService.updateProyecto(
                                            proyecto.id,
                                            proyectoData
                                        );
                                    } else {
                                        await profileService.addProyecto(
                                            proyectoData
                                        );
                                    }
                                }
                            }
                        }

                        this.hasUnsavedChanges = false;

                        // Recargar datos después del guardado exitoso
                        console.log(
                            "✅ Proyectos guardados, recargando datos..."
                        );
                        await this.loadUserProfile();

                        return true;
                    } else {
                        console.warn("ProyectosManager no encontrado");
                        return false;
                    }
                } catch (error) {
                    console.error("Error guardando proyectos:", error);

                    // Mostrar error específico al usuario
                    let errorMessage = "Error al guardar proyectos";

                    if (error.response && error.response.data) {
                        // Error del backend con detalles
                        if (
                            error.response.data.details &&
                            Array.isArray(error.response.data.details)
                        ) {
                            errorMessage = `Error de validación: ${error.response.data.details.join(", ")}`;
                        } else if (error.response.data.error) {
                            errorMessage = error.response.data.error;
                        }
                    } else if (error.message) {
                        errorMessage = error.message;
                    }

                    this.showNotification(errorMessage, "error");
                    throw error;
                }
            }
        }

        // Inicializar cuando el DOM esté listo
        document.addEventListener("DOMContentLoaded", () => {
            console.log("Initializing ProfileEditor...");
            const editor = new ProfileEditor();

            // Hacer disponible globalmente
            window.profileEditor = editor;
        });
    </script>
</BaseLayout>
