---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DatosPersonales from "../../components/perfil/DatosPersonales.astro";
import ExperienciaForm from "../../components/perfil/ExperienciaForm.astro";
import FormacionForm from "../../components/perfil/FormacionForm.astro";
import CursoForm from "../../components/perfil/CursoForm.astro";
import ProyectoForm from "../../components/perfil/ProyectoForm.astro";

// Verificar autenticación del lado del servidor si es necesario
// En una implementación real, aquí verificarías el token JWT
---

<BaseLayout title="Editar Perfil" hideAccederButton={true}>
    <main class="profile-edit-container">
        <!-- Hero banner en la parte superior -->
        <div class="profile-hero-banner">
            <div class="hero-background">
                <div class="hero-pattern"></div>
            </div>
            <div class="hero-content">
                <div class="profile-avatar">
                    <img
                        id="profile-image"
                        src="/default-avatar.svg"
                        alt="Foto de perfil"
                    />
                    <button class="change-photo-btn" id="change-photo-btn">
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor">
                            <path
                                d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                            ></path>
                            <circle cx="12" cy="13" r="4"></circle>
                        </svg>
                    </button>
                </div>
                <div class="profile-info">
                    <h1 class="profile-name" id="profile-name">
                        Nombre Usuario
                    </h1>
                    <p class="profile-subtitle" id="profile-subtitle">
                        Desarrollador de Software
                    </p>
                </div>
            </div>
        </div>

        <!-- Container principal con sidebar y contenido -->
        <div class="main-layout">
            <!-- Sidebar izquierdo con navegación -->
            <aside class="sidebar-navigation">
                <!-- Navegación de secciones -->
                <nav class="section-navigation">
                    <button
                        class="nav-btn active"
                        data-section="datos-personales">
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
                            ></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Datos Personales
                    </button>
                    <button class="nav-btn" data-section="formaciones">
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                        </svg>
                        Formaciones
                    </button>
                    <button class="nav-btn" data-section="experiencias">
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor">
                            <rect
                                x="2"
                                y="3"
                                width="20"
                                height="14"
                                rx="2"
                                ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                        Experiencias
                    </button>
                    <button class="nav-btn" data-section="habilidades">
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor">
                            <path d="M9 12l2 2 4-4"></path>
                            <path
                                d="M21 12c-1 0-3-1-3-3s2-3 3-3 3 1 3 3-2 3-3 3"
                            ></path>
                            <path d="M3 12c1 0 3-1 3-3s-2-3-3-3-3 1-3 3 2 3 3 3"
                            ></path>
                            <path
                                d="M12 21c0-1-1-3-3-3s-3 2-3 3 1 3 3 3 3-2 3-3"
                            ></path>
                            <path d="M12 3c0 1-1 3-3 3s-3-2-3-3 1-3 3-3 3 2 3 3"
                            ></path>
                        </svg>
                        Habilidades
                    </button>
                    <button class="nav-btn" data-section="proyectos">
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor">
                            <rect
                                x="3"
                                y="4"
                                width="18"
                                height="18"
                                rx="2"
                                ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        Proyectos
                    </button>
                </nav>

                <!-- Acciones globales en sidebar - eliminado botón Guardar Perfil -->
                <div class="global-actions">
                    <!-- Solo navegación, el guardado se hace desde cada sección -->
                </div>
            </aside>

            <!-- Área principal del contenido -->
            <div class="main-content">
                <!-- Contenido de las secciones -->
                <div class="sections-container">
                    <!-- Sección: Datos Personales -->
                    <section
                        class="profile-section active"
                        id="datos-personales">
                        <DatosPersonales />
                    </section>

                    <!-- Sección: Formaciones -->
                    <section class="profile-section" id="formaciones">
                        <FormacionForm />
                    </section>

                    <!-- Sección: Experiencias -->
                    <section class="profile-section" id="experiencias">
                        <ExperienciaForm />
                    </section>

                    <!-- Sección: Habilidades -->
                    <section class="profile-section" id="habilidades">
                        <CursoForm />
                    </section>

                    <!-- Sección: Proyectos -->
                    <section class="profile-section" id="proyectos">
                        <ProyectoForm />
                    </section>
                </div>
            </div>
        </div>

        <!-- Input oculto para subida de archivos -->
        <input
            type="file"
            id="photo-upload"
            accept="image/*"
            style="display: none;"
        />
    </main>

    <style>
        /* Reset para usar todo el viewport */
        html {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        *,
        *::before,
        *::after {
            box-sizing: inherit;
        }

        .profile-edit-container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            width: 100%;
            margin: 0;
            background: url("/images/imgen_de_fondo.jpg") repeat;
            background-size: auto;
            background-attachment: fixed;
            overflow-x: hidden;
        }

        /* Hero banner superior */
        .profile-hero-banner {
            position: relative;
            width: 100%;
            overflow: hidden;
        }

        /* Layout principal con sidebar y contenido */
        .main-layout {
            display: flex;
            flex: 1;
        }

        /* Sidebar izquierdo */
        .sidebar-navigation {
            width: 280px;
            background: rgba(248, 250, 252, 0.95);
            backdrop-filter: blur(10px);
            border-right: 1px solid #e5e7eb;
            display: flex;
            flex-direction: column;
            padding: 2rem;
        }

        .hero-background {
            position: relative;
            background: linear-gradient(
                135deg,
                #3b82f6 0%,
                #1d4ed8 50%,
                #1e40af 100%
            );
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .hero-background::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: radial-gradient(
                    circle at 20% 20%,
                    rgba(255, 255, 255, 0.1) 0%,
                    transparent 50%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(255, 255, 255, 0.1) 0%,
                    transparent 50%
                ),
                radial-gradient(
                    circle at 40% 40%,
                    rgba(255, 255, 255, 0.05) 0%,
                    transparent 50%
                );
            pointer-events: none;
        }

        .hero-pattern {
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 60%;
            background-image: repeating-linear-gradient(
                    45deg,
                    rgba(255, 255, 255, 0.03) 0px,
                    rgba(255, 255, 255, 0.03) 1px,
                    transparent 1px,
                    transparent 20px
                ),
                repeating-linear-gradient(
                    -45deg,
                    rgba(255, 255, 255, 0.03) 0px,
                    rgba(255, 255, 255, 0.03) 1px,
                    transparent 1px,
                    transparent 20px
                );
        }

        .hero-content {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 2rem;
            width: 100%;
        }

        .profile-avatar {
            position: relative;
            width: 100px;
            height: 100px;
            flex-shrink: 0;
        }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255, 255, 255, 0.2);
        }

        .change-photo-btn {
            position: absolute;
            bottom: -2px;
            right: -2px;
            width: 24px;
            height: 24px;
            background: rgba(255, 255, 255, 0.9);
            border: 2px solid #3b82f6;
            border-radius: 50%;
            color: #3b82f6;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .change-photo-btn:hover:not(:disabled) {
            background: white;
            transform: scale(1.1);
        }

        .change-photo-btn:disabled {
            background: #e5e7eb;
            border-color: #9ca3af;
            cursor: not-allowed;
            transform: none;
        }

        .loading-spinner {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        .profile-avatar img {
            transition: opacity 0.3s ease;
        }

        .profile-info {
            flex: 1;
            min-width: 0;
        }

        .profile-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
            margin: 0 0 0.5rem 0;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        .profile-subtitle {
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.9);
            margin: 0 0 0.25rem 0;
            font-weight: 500;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        }

        .profile-email {
            color: rgba(255, 255, 255, 0.7);
            margin: 0;
            font-size: 0.875rem;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        }

        /* Navegación vertical */
        .section-navigation {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0 2rem;
        }

        .nav-btn {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.875rem 1rem;
            border: none;
            background: transparent;
            color: #6b7280;
            font-weight: 500;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.2s;
            text-align: left;
            width: 100%;
        }

        .nav-btn:hover {
            background: #f1f5f9;
            color: #475569;
        }

        .nav-btn.active {
            color: #3b82f6;
            background: #eff6ff;
            border-left: 3px solid #3b82f6;
        }

        .nav-btn svg {
            flex-shrink: 0;
            width: 20px;
            height: 20px;
        }

        /* Área principal */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .content-header {
            padding: 2rem 2rem 1rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #1f2937;
            margin: 0 0 0.5rem 0;
        }

        .section-subtitle {
            color: #6b7280;
            margin: 0;
        }

        /* Secciones */
        .sections-container {
            flex: 1;
            padding: 2rem;
            overflow-y: auto;
        }

        .profile-section {
            display: none;
            animation: fadeIn 0.3s ease-in-out;
        }

        .profile-section.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Acciones globales - simplificado (sin botón Guardar Perfil) */
        .global-actions {
            display: none; /* Ya no se usa */
        }

        /* Botones */
        .btn-secondary,
        .btn-primary {
            padding: 0.875rem;
            border: none;
            border-radius: 8px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            width: 100%;
        }

        .btn-secondary {
            background: #f3f4f6;
            color: #374151;
            border: 1px solid #d1d5db;
        }

        .btn-secondary:hover {
            background: #e5e7eb;
            border-color: #9ca3af;
        }

        .btn-primary {
            background: #3b82f6;
            color: white;
        }

        .btn-primary:hover {
            background: #2563eb;
        }

        .btn-primary:disabled {
            background: #9ca3af;
            cursor: not-allowed;
        }

        .loading-spinner svg {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .sidebar-navigation {
                width: 250px;
            }
        }

        @media (max-width: 768px) {
            .profile-edit-container {
                flex-direction: column;
                width: 100%;
                min-height: 100vh;
            }

            .main-layout {
                flex-direction: column;
            }

            .sidebar-navigation {
                width: 100%;
                padding: 0;
                border-right: none;
                border-bottom: 1px solid #e5e7eb;
            }

            .main-content {
                padding: 1rem;
            }

            .profile-hero-banner {
                margin: 0;
            }

            .hero-background {
                border-radius: 0;
                padding: 1.5rem 1rem;
            }

            .hero-content {
                flex-direction: column;
                align-items: center;
                text-align: center;
                gap: 1rem;
            }

            .profile-avatar {
                width: 80px;
                height: 80px;
            }

            .profile-info {
                text-align: center;
            }

            .profile-name {
                font-size: 1.25rem;
            }

            .profile-subtitle {
                font-size: 0.875rem;
            }

            .section-navigation {
                flex-direction: row;
                gap: 0.5rem;
                overflow-x: auto;
                padding: 0.5rem 1rem 1rem;
            }

            .nav-btn {
                flex-direction: column;
                gap: 0.25rem;
                padding: 0.75rem;
                font-size: 0.75rem;
                min-width: 80px;
                text-align: center;
            }

            .nav-btn svg {
                width: 16px;
                height: 16px;
            }

            .global-actions {
                flex-direction: row;
                gap: 0.5rem;
                padding: 1rem;
            }

            .main-content {
                order: -1;
            }

            .content-header {
                padding: 1rem;
            }

            .sections-container {
                padding: 1rem;
            }

            .section-title {
                font-size: 1.25rem;
            }
        }

        /* Media query para tablets */
        @media (min-width: 769px) and (max-width: 1024px) {
            .hero-background {
                padding: 1.5rem;
            }

            .profile-avatar {
                width: 90px;
                height: 90px;
            }

            .profile-name {
                font-size: 1.375rem;
            }

            .sidebar-navigation {
                width: 200px;
            }

            .main-content {
                padding: 1.5rem;
            }
        }

        @media (max-width: 480px) {
            .hero-background {
                padding: 1rem 0.75rem;
            }

            .hero-content {
                gap: 0.75rem;
            }

            .profile-avatar {
                width: 70px;
                height: 70px;
            }

            .profile-name {
                font-size: 1.125rem;
            }

            .profile-subtitle {
                font-size: 0.875rem;
            }

            .profile-email {
                font-size: 0.8rem;
            }

            .nav-btn {
                padding: 0.75rem 0.5rem;
                min-width: 75px;
                font-size: 0.7rem;
                min-height: 44px; /* Touch target iOS guidelines */
            }

            .btn-primary,
            .btn-secondary {
                min-height: 48px;
                font-size: 1rem;
                padding: 0.875rem 1rem;
            }

            .change-photo-btn {
                width: 32px;
                height: 32px;
                min-height: 44px;
                min-width: 44px;
            }

            .content-header {
                padding: 0.75rem;
            }

            .sections-container {
                padding: 0.75rem;
            }

            .global-actions {
                padding: 0.75rem;
            }
        }
    </style>

    <script>
        // @ts-nocheck
        import {
            profileService,
            getUserData,
            apiRequest,
            initializeApiAuth,
        } from "../../utils/api.js";
        import { imageService, ImageUtils } from "../../utils/imgbb.js";

        class ProfileEditor {
            constructor() {
                this.currentSection = "datos-personales";
                this.profileData = null;
                this.isLoading = false;
                this.hasUnsavedChanges = false;

                // Asegurar que la autenticación esté inicializada
                initializeApiAuth();

                this.init();
            }

            async init() {
                console.log("ProfileEditor init started");

                // Esperar a que los managers de los componentes estén listos
                await this.waitForManagers();

                this.bindEvents();
                await this.loadUserProfile();
                this.setupAutoSave();

                // Hacer disponible globalmente para los componentes
                window.profileEditor = this;

                console.log("ProfileEditor init completed");
            }

            async waitForManagers() {
                console.log("Esperando a que los managers estén listos...");

                // Esperar hasta que el DatosPersonalesManager esté disponible
                let attempts = 0;
                const maxAttempts = 50; // 5 segundos máximo

                while (
                    !window.datosPersonalesManager &&
                    attempts < maxAttempts
                ) {
                    await new Promise((resolve) => setTimeout(resolve, 100));
                    attempts++;
                }

                if (window.datosPersonalesManager) {
                    console.log("✅ DatosPersonalesManager está listo");
                } else {
                    console.warn(
                        "⚠️ DatosPersonalesManager no se inicializó a tiempo"
                    );
                }
            }
            bindEvents() {
                console.log("🔧 Iniciando bindEvents...");

                // Navegación entre secciones
                document.querySelectorAll(".nav-btn").forEach((btn) => {
                    btn.addEventListener("click", (e) => {
                        const section = e.target.dataset.section;
                        this.switchSection(section);
                    });
                });

                // Cambio de foto de perfil
                const changePhotoBtn =
                    document.getElementById("change-photo-btn");
                const photoUploadInput =
                    document.getElementById("photo-upload");

                console.log("🔍 Verificando elementos de foto:", {
                    changePhotoBtn: !!changePhotoBtn,
                    photoUploadInput: !!photoUploadInput,
                });

                if (changePhotoBtn && photoUploadInput) {
                    console.log("✅ Configurando eventos de foto de perfil");
                    changePhotoBtn.addEventListener("click", () => {
                        console.log("🖱️ Click en botón de cambiar foto");
                        photoUploadInput.click();
                    });

                    photoUploadInput.addEventListener("change", (e) => {
                        console.log(
                            "📁 Archivo seleccionado:",
                            e.target.files[0]
                        );
                        this.handlePhotoUpload(e);
                    });
                } else {
                    console.warn(
                        "⚠️ Elementos de foto de perfil no encontrados:",
                        {
                            changePhotoBtn: !!changePhotoBtn,
                            photoUploadInput: !!photoUploadInput,
                        }
                    );
                }

                // Botones globales - save-profile-btn eliminado
                // document
                //     .getElementById("cancel-btn")
                //     .addEventListener("click", () => {
                //         this.cancelEditing();
                //     });

                // Botones "Siguiente" de cada sección
                this.bindSectionButtons();

                // Detectar cambios en formularios
                document.addEventListener("input", () => {
                    this.hasUnsavedChanges = true;
                });

                // Advertencia antes de cerrar con cambios no guardados
                window.addEventListener("beforeunload", (e) => {
                    if (this.hasUnsavedChanges) {
                        e.preventDefault();
                        e.returnValue = "";
                    }
                });

                // Escuchar eventos de los componentes para manejar API calls
                this.bindComponentEvents();
            }

            bindSectionButtons() {
                console.log("Binding section buttons...");

                // Botones "Siguiente" de cada sección
                const sectionButtons = [
                    { id: "save-datos-personales", nextSection: "formaciones" },
                    { id: "save-formaciones", nextSection: "experiencias" },
                    { id: "save-experiencias", nextSection: "habilidades" },
                    { id: "save-habilidades", nextSection: "proyectos" },
                    { id: "save-proyectos", nextSection: null }, // última sección
                ];

                // Debug: verificar qué botones están disponibles
                console.log(
                    "Available buttons:",
                    sectionButtons.map(({ id }) => {
                        const btn = document.getElementById(id);
                        return { id, found: !!btn, element: btn };
                    })
                );

                sectionButtons.forEach(({ id, nextSection }) => {
                    const button = document.getElementById(id);
                    if (button) {
                        console.log(`✅ Found button: ${id}`);

                        // Remover event listeners existentes
                        const newButton = button.cloneNode(true);
                        button.parentNode.replaceChild(newButton, button);

                        newButton.addEventListener("click", async (e) => {
                            e.preventDefault();
                            e.stopPropagation();

                            console.log(
                                `🔥 Button clicked: ${id}, navigating to: ${nextSection}`
                            );

                            // Desactivar botón mientras procesa
                            newButton.disabled = true;
                            const originalText = newButton.textContent;
                            newButton.textContent = "Guardando...";

                            try {
                                // Si es la primera sección (datos personales), guardar los datos
                                if (id === "save-datos-personales") {
                                    console.log(
                                        "💾 Guardando datos personales..."
                                    );
                                    await this.saveProfile();
                                    this.showNotification(
                                        "Datos personales guardados correctamente",
                                        "success"
                                    );
                                }
                                // Si es la última sección (proyectos), guardar todo el perfil
                                else if (
                                    !nextSection &&
                                    id === "save-proyectos"
                                ) {
                                    console.log(
                                        "💾 Guardando perfil completo..."
                                    );
                                    await this.saveProfile();
                                    this.showNotification(
                                        "¡Perfil guardado exitosamente!",
                                        "success"
                                    );
                                } else {
                                    // Para otras secciones, solo mostrar mensaje por ahora
                                    this.showNotification(
                                        "Navegando a la siguiente sección",
                                        "success"
                                    );
                                }

                                // Si hay siguiente sección, navegar
                                if (nextSection) {
                                    console.log(
                                        `Navigating to: ${nextSection}`
                                    );
                                    setTimeout(() => {
                                        this.switchSection(nextSection);
                                    }, 300);
                                } else {
                                    // Última sección - mostrar mensaje final adicional
                                    setTimeout(() => {
                                        this.showNotification(
                                            "¡Perfil completado exitosamente!",
                                            "success"
                                        );
                                    }, 1000);
                                }
                            } catch (error) {
                                console.error("Error:", error);
                                this.showNotification(
                                    "Error al guardar la sección",
                                    "error"
                                );
                            } finally {
                                // Restaurar botón después de un delay
                                setTimeout(() => {
                                    newButton.disabled = false;
                                    newButton.textContent = originalText;
                                }, 1200);
                            }
                        });
                    } else {
                        console.warn(`❌ Button with id "${id}" not found`);
                    }
                });

                console.log("Section buttons binding completed");
            }

            switchSection(sectionId) {
                console.log(`🔄 Switching to section: ${sectionId}`);

                // Actualizar navegación
                document.querySelectorAll(".nav-btn").forEach((btn) => {
                    btn.classList.remove("active");
                });

                const navBtn = document.querySelector(
                    `[data-section="${sectionId}"]`
                );
                if (navBtn) {
                    navBtn.classList.add("active");
                    console.log(`✅ Updated nav button for: ${sectionId}`);
                } else {
                    console.warn(`❌ Nav button not found for: ${sectionId}`);
                }

                // Mostrar sección correspondiente
                document
                    .querySelectorAll(".profile-section")
                    .forEach((section) => {
                        section.classList.remove("active");
                    });

                const targetSection = document.getElementById(sectionId);
                if (targetSection) {
                    targetSection.classList.add("active");
                    console.log(`✅ Activated section: ${sectionId}`);
                } else {
                    console.warn(`❌ Section not found: ${sectionId}`);
                }

                // Actualizar título de sección
                this.updateSectionTitle(sectionId);

                // updateSaveButton eliminado - ya no se usa

                this.currentSection = sectionId;
                console.log(`✅ Section switch completed: ${sectionId}`);
            }

            /**
             * Actualizar título de la sección actual
             */
            updateSectionTitle(sectionId) {
                const titles = {
                    "datos-personales": {
                        title: "Datos Personales",
                        subtitle: "Completa tu información personal básica",
                    },
                    formaciones: {
                        title: "Formación Académica",
                        subtitle:
                            "Incluye tu educación formal y certificaciones",
                    },
                    experiencias: {
                        title: "Experiencias Laborales",
                        subtitle:
                            "Agrega tu historial profesional y experiencias",
                    },
                    habilidades: {
                        title: "Habilidades y Cursos",
                        subtitle:
                            "Destaca tus competencias y formación complementaria",
                    },
                    proyectos: {
                        title: "Proyectos",
                        subtitle:
                            "Muestra tus proyectos personales y profesionales",
                    },
                };

                const titleEl = document.getElementById("section-title");
                const subtitleEl = document.querySelector(".section-subtitle");

                if (titles[sectionId] && titleEl && subtitleEl) {
                    titleEl.textContent = titles[sectionId].title;
                    subtitleEl.textContent = titles[sectionId].subtitle;
                }
            }

            // updateSaveButton eliminado - ya no se usa el botón Guardar Perfil

            async loadUserProfile() {
                try {
                    // this.setLoading(true); // eliminado

                    const response = await apiRequest(() =>
                        profileService.getMyProfile()
                    );

                    console.log("Respuesta cruda de la API:", response);
                    this.profileData = response;

                    // Actualizar header
                    this.updateHeader(response);

                    // Notificar a los componentes que se cargaron los datos
                    window.dispatchEvent(
                        new CustomEvent("profile-data-loaded", {
                            detail: response,
                        })
                    );

                    console.log("Perfil cargado correctamente:", response);
                } catch (error) {
                    console.error("Error cargando perfil:", error);
                    this.showNotification("Error al cargar el perfil", "error");
                } finally {
                    // this.setLoading(false); // eliminado
                }
            }

            updateHeader(profileData) {
                const nameEl = document.getElementById("profile-name");
                const subtitleEl = document.getElementById("profile-subtitle");
                const imageEl = document.getElementById("profile-image");

                // Usar la estructura de datos de la API real
                const usuario =
                    profileData.data?.usuario ||
                    profileData.usuario ||
                    profileData;
                const carrera =
                    profileData.data?.carrera || profileData.carrera;
                const perfil =
                    profileData.data?.perfil || profileData.perfil || {};

                if (nameEl && usuario?.nombre) {
                    nameEl.textContent = usuario.nombre;
                }

                // Generar subtítulo dinámico basado en el perfil
                if (subtitleEl) {
                    let subtitle = "Egresado IES";

                    if (carrera?.nombre) {
                        subtitle = `Egresado de ${carrera.nombre}`;
                    } else if (perfil.situacionLaboral) {
                        subtitle = perfil.situacionLaboral;
                    }

                    subtitleEl.textContent = subtitle;
                }

                // Cargar imagen de perfil
                if (imageEl) {
                    let imageUrl = "/default-avatar.svg"; // Imagen por defecto

                    if (perfil.urlFotoPerfil) {
                        // ImgBB devuelve URLs directas, no necesitan transformación
                        imageUrl = perfil.urlFotoPerfil;
                    }

                    imageEl.src = imageUrl;
                }
            }

            async handlePhotoUpload(event) {
                const file = event.target.files[0];
                if (!file) return;

                try {
                    // Mostrar loading en el botón
                    const changeBtn =
                        document.getElementById("change-photo-btn");
                    if (changeBtn) {
                        changeBtn.innerHTML = `
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="loading-spinner">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M16 12a4 4 0 0 1-8 0"></path>
                            </svg>
                        `;
                        changeBtn.disabled = true;
                    }

                    // Validar imagen antes de subir
                    await imageService.validateImage(file);

                    // Crear preview inmediato
                    const previewUrl = await imageService.createPreview(file);
                    const imageEl = document.getElementById("profile-image");
                    if (imageEl) {
                        imageEl.src = previewUrl;
                        imageEl.style.opacity = "0.7"; // Indicar que está procesando
                    }

                    // Comprimir imagen si es muy grande
                    let processedFile = file;
                    if (file.size > 1024 * 1024) {
                        // Si es mayor a 1MB
                        processedFile = await ImageUtils.compressImage(file, {
                            maxWidth: 800,
                            maxHeight: 800,
                            quality: 0.8,
                        });
                        console.log(
                            `Imagen comprimida: ${Math.round(file.size / 1024)}KB → ${Math.round(processedFile.size / 1024)}KB`
                        );
                    }

                    // Subir a ImgBB
                    const uploadResult = await imageService.uploadImage(
                        processedFile,
                        {
                            name: `perfil_${Date.now()}`,
                        }
                    );

                    if (uploadResult.success) {
                        // Actualizar imagen con la URL de ImgBB
                        const imageUrl = uploadResult.url;

                        if (imageEl) {
                            imageEl.src = imageUrl;
                            imageEl.style.opacity = "1"; // Restaurar opacidad
                        }

                        // Guardar directamente la foto de perfil en la API
                        await apiRequest(() =>
                            profileService.updateMyProfile({
                                urlFotoPerfil: uploadResult.url,
                            })
                        );

                        // Actualizar datos locales
                        if (!this.profileData)
                            this.profileData = { data: { perfil: {} } };
                        if (!this.profileData.data)
                            this.profileData.data = { perfil: {} };
                        if (!this.profileData.data.perfil)
                            this.profileData.data.perfil = {};

                        this.profileData.data.perfil.urlFotoPerfil =
                            uploadResult.url;

                        this.showNotification(
                            "Foto de perfil actualizada correctamente",
                            "success"
                        );

                        console.log("Imagen subida a ImgBB:", {
                            id: uploadResult.id,
                            url: uploadResult.url,
                            thumbnailUrl: uploadResult.thumbnailUrl,
                        });
                    } else {
                        throw new Error("Error en la subida a ImgBB");
                    }
                } catch (error) {
                    console.error("Error subiendo foto:", error);

                    let errorMessage = "Error al subir la foto de perfil";
                    if (error.message.includes("Tipo de archivo")) {
                        errorMessage =
                            "Solo se permiten imágenes JPEG, PNG o WebP";
                    } else if (error.message.includes("demasiado grande")) {
                        errorMessage =
                            "La imagen es demasiado grande (máximo 5MB)";
                    } else if (error.message.includes("píxeles")) {
                        errorMessage =
                            "La imagen debe ser de al menos 100x100 píxeles";
                    }

                    this.showNotification(errorMessage, "error");

                    // Revertir preview si falló la subida
                    this.loadProfileImage();
                } finally {
                    // Restaurar botón
                    const changeBtn =
                        document.getElementById("change-photo-btn");
                    if (changeBtn) {
                        changeBtn.innerHTML = `
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                <circle cx="12" cy="13" r="4"></circle>
                            </svg>
                        `;
                        changeBtn.disabled = false;
                    }

                    // Limpiar input para permitir cargar la misma imagen de nuevo
                    const photoInput = document.getElementById("photo-upload");
                    if (photoInput) {
                        photoInput.value = "";
                    }
                }
            }

            /**
             * Cargar imagen de perfil desde datos actuales
             */
            loadProfileImage() {
                const imageEl = document.getElementById("profile-image");
                if (!imageEl) return;

                const perfil = this.profileData?.data?.perfil || {};
                let imageUrl = "/default-avatar.svg"; // Imagen por defecto

                if (perfil.urlFotoPerfil) {
                    // ImgBB devuelve URLs directas
                    imageUrl = perfil.urlFotoPerfil;
                }

                if (imageEl.tagName === "IMG") {
                    imageEl.src = imageUrl;
                }
            }

            async saveProfile() {
                try {
                    console.log("💾 Iniciando guardado del perfil...");

                    // Recopilar datos solo del perfil principal (datos personales)
                    const formData = this.gatherFormData();

                    console.log("Datos a guardar:", formData);

                    // Guardar en el backend usando la API correcta
                    const response = await apiRequest(() =>
                        profileService.updateMyProfile(formData)
                    );

                    console.log("Respuesta del guardado:", response);

                    this.hasUnsavedChanges = false;

                    return true; // Indicar éxito
                } catch (error) {
                    console.error("Error guardando perfil:", error);
                    throw error; // Re-lanzar para que el botón lo maneje
                }
            }

            bindComponentEvents() {
                // Mostrar notificaciones
                window.addEventListener("show-notification", (e) => {
                    const customEvent = e;
                    if (customEvent.detail) {
                        this.showNotification(
                            customEvent.detail.message,
                            customEvent.detail.type
                        );
                    }
                });

                // Marcar cambios sin guardar
                window.addEventListener("profile-data-changed", () => {
                    this.hasUnsavedChanges = true;
                });

                // Escuchar eventos de guardado por sección
                window.addEventListener("save-section-data", async (e) => {
                    const customEvent = e;
                    if (customEvent.detail) {
                        try {
                            console.log(
                                "💾 Guardando sección:",
                                customEvent.detail.section
                            );
                            console.log("📋 Datos:", customEvent.detail.data);

                            // Guardar los datos usando la API
                            const response = await apiRequest(() =>
                                profileService.updateMyProfile(
                                    customEvent.detail.data
                                )
                            );

                            console.log(
                                "✅ Sección guardada exitosamente:",
                                response
                            );
                            this.hasUnsavedChanges = false;
                        } catch (error) {
                            console.error("❌ Error guardando sección:", error);
                            this.showNotification(
                                "Error al guardar los datos",
                                "error"
                            );
                        }
                    }
                });
            }

            // Métodos de manejo de eventos eliminados - ahora usamos guardado directo por sección

            gatherFormData() {
                console.log("🔍 Recopilando datos del formulario...");

                // Verificar que el manager existe
                const win = window;
                if (!win.datosPersonalesManager) {
                    console.error(
                        "❌ datosPersonalesManager no está disponible"
                    );
                    return {};
                }

                // Recopilar datos del formulario
                const datosPersonales =
                    win.datosPersonalesManager.getFormData();
                console.log("Datos del formulario:", datosPersonales);

                // Los datos ya vienen mapeados correctamente desde getFormData()
                // Solo necesitamos añadir campos adicionales del perfil existente
                const mappedData = {
                    // Datos personales (ya mapeados en DatosPersonales.getFormData())
                    ...datosPersonales,

                    // Campos adicionales del perfil que no se editan en esta sección
                    urlFotoPerfil:
                        this.profileData?.data?.perfil?.urlFotoPerfil || null,
                    urlBanner:
                        this.profileData?.data?.perfil?.urlBanner || null,
                };

                console.log("Datos mapeados para la API:", mappedData);
                return mappedData;
            }

            cancelEditing() {
                if (this.hasUnsavedChanges) {
                    if (
                        confirm(
                            "¿Estás seguro de que quieres cancelar? Se perderán los cambios no guardados."
                        )
                    ) {
                        window.location.href = "/";
                    }
                } else {
                    window.location.href = "/";
                }
            }

            setupAutoSave() {
                // Guardado automático cada 5 minutos
                setInterval(
                    () => {
                        if (this.hasUnsavedChanges && !this.isLoading) {
                            console.log("Auto-guardando perfil...");
                            // this.saveProfile();
                        }
                    },
                    5 * 60 * 1000
                );
            }

            // setLoading eliminado - ya no se usa el botón Guardar Perfil

            showNotification(message, type = "info") {
                // Crear elemento de notificación
                const notification = document.createElement("div");
                notification.className = `notification notification-${type}`;
                notification.textContent = message;

                // Estilos básicos
                Object.assign(notification.style, {
                    position: "fixed",
                    top: "20px",
                    right: "20px",
                    padding: "1rem 1.5rem",
                    borderRadius: "8px",
                    color: "white",
                    fontWeight: "500",
                    zIndex: "9999",
                    transform: "translateX(400px)",
                    transition: "transform 0.3s ease",
                    background:
                        type === "error"
                            ? "#ef4444"
                            : type === "success"
                              ? "#10b981"
                              : "#3b82f6",
                });

                document.body.appendChild(notification);

                // Animación de entrada
                setTimeout(() => {
                    notification.style.transform = "translateX(0)";
                }, 100);

                // Remover después de 4 segundos
                setTimeout(() => {
                    notification.style.transform = "translateX(400px)";
                    setTimeout(() => {
                        document.body.removeChild(notification);
                    }, 300);
                }, 4000);
            }
        }

        // Inicializar cuando el DOM esté listo
        document.addEventListener("DOMContentLoaded", () => {
            console.log("Initializing ProfileEditor...");
            const editor = new ProfileEditor();

            // Hacer disponible globalmente
            window.profileEditor = editor;
        });
    </script>
</BaseLayout>
