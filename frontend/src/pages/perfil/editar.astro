            // setLoading eliminado - ya no se usa el botón Guardar Perfil

            showNotification(message, type = "info") {
                // Crear elemento de notificación
                const notification = document.createElement("div");
                notification.className = `notification notification-${type}`;
                notification.textContent = message;

                // Estilos básicos
                Object.assign(notification.style, {
                    position: "fixed",
                    top: "20px",
                    right: "20px",
                    padding: "1rem 1.5rem",
                    borderRadius: "8px",
                    color: "white",
                    fontWeight: "500",
                    zIndex: "9999",
                    transform: "translateX(400px)",
                    transition: "transform 0.3s ease",
                    background:
                        type === "error"
                            ? "#ef4444"
                            : type === "success"
                              ? "#10b981"
                              : "#3b82f6",
                });

                document.body.appendChild(notification);

                // Animación de entrada
                setTimeout(() => {
                    notification.style.transform = "translateX(0)";
                }, 100);

                // Remover después de 4 segundos
                setTimeout(() => {
                    notification.style.transform = "translateX(400px)";
                    setTimeout(() => {
                        document.body.removeChild(notification);
                    }, 300);
                }, 4000);
            }

            // Métodos de guardado específicos para cada sección
            async saveFormaciones() {
                try {
                    console.log("💾 Guardando formaciones y cursos...");

                    // Obtener datos del FormacionesManager
                    if (window.formacionesManager) {
                        const data = window.formacionesManager.getFormData();
                        console.log("Datos de formaciones:", data);

                        // Guardar formaciones
                        if (data.formaciones && data.formaciones.length > 0) {
                            for (const formacion of data.formaciones) {
                                // Solo guardar si tiene título e institución
                                if (formacion.titulo && formacion.institucion) {
                                    // Preparar datos limpios para la API
                                    const formacionData = {
                                        titulo: formacion.titulo,
                                        institucion: formacion.institucion,
                                        anioFinalizacion: formacion.anioFinalizacion || null,
                                    };

                                    if (formacion.id) {
                                        // Actualizar formación existente
                                        await profileService.updateFormacion(
                                            formacion.id,
                                            formacionData
                                        );
                                    } else {
                                        // Crear nueva formación
                                        const response = await profileService.addFormacion(
                                            formacionData
                                        );
                                        if (response.success && response.data) {
                                            // Actualizar el ID en el manager
                                            formacion.id = response.data.id;
                                        }
                                    }
                                }
                            }
                        }

                        // Guardar cursos
                        if (data.cursos && data.cursos.length > 0) {
                            for (const curso of data.cursos) {
                                // Solo guardar si tiene nombre
                                if (curso.nombre) {
                                    // Preparar datos limpios para la API
                                    const cursoData = {
                                        nombre: curso.nombre,
                                        institucion: curso.institucionCurso || null,
                                        horasDuracion: curso.horasDuracion || null,
                                        urlCertificado: curso.urlCertificado || null,
                                        fechaFinalizacion: curso.fechaFinalizacion || null,
                                        estado: curso.estado || null,
                                    };

                                    if (curso.id) {
                                        // Actualizar curso existente
                                        await profileService.updateCurso(
                                            curso.id,
                                            cursoData
                                        );
                                    } else {
                                        // Crear nuevo curso
                                        const response = await profileService.addCurso(
                                            cursoData
                                        );
                                        if (response.success && response.data) {
                                            // Actualizar el ID en el manager
                                            curso.id = response.data.id;
                                        }
                                    }
                                }
                            }
                        }

                        this.showNotification("Formaciones y cursos guardados correctamente", "success");
                        this.hasUnsavedChanges = false;

                        // Recargar datos después del guardado exitoso
                        console.log(
                            "✅ Formaciones guardadas, recargando datos..."
                        );
                        await this.loadUserProfile();

                        return true;
                    } else {
                        console.warn("FormacionesManager no encontrado");
                        return false;
                    }
                } catch (error) {
                    console.error("Error guardando formaciones:", error);

                    // Mostrar error específico al usuario
                    let errorMessage = "Error al guardar formaciones y cursos";

                    if (error.response && error.response.data) {
                        // Error del backend con detalles
                        if (
                            error.response.data.details &&
                            Array.isArray(error.response.data.details)
                        ) {
                            errorMessage = `Error de validación: ${error.response.data.details.join(", ")}`;
                        } else if (error.response.data.error) {
                            errorMessage = error.response.data.error;
                        }
                    } else if (error.message) {
                        errorMessage = error.message;
                    }

                    this.showNotification(errorMessage, "error");
                    throw error;
                }
            }

