            async handlePhotoUpload(event) {
                const file = event.target.files[0];
                if (!file) return;

                try {
                    // Mostrar loading en el botón
                    const changeBtn =
                        document.getElementById("change-photo-btn");
                    if (changeBtn) {
                        changeBtn.innerHTML = `
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="loading-spinner">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M16 12a4 4 0 0 1-8 0"></path>
                            </svg>
                        `;
                        changeBtn.disabled = true;
                    }

                    // Validar imagen antes de subir
                    await imageService.validateImage(file);

                    // Crear preview inmediato
                    const previewUrl = await imageService.createPreview(file);
                    const avatarEl = document.getElementById("profile-avatar");
                    if (avatarEl) {
                        avatarEl.innerHTML = `<img src="${previewUrl}" alt="Foto de perfil" style="opacity: 0.7;" />`;
                    }

                    // Comprimir imagen si es muy grande
                    let processedFile = file;
                    if (file.size > 1024 * 1024) {
                        // Si es mayor a 1MB
                        processedFile = await ImageUtils.compressImage(file, {
                            maxWidth: 800,
                            maxHeight: 800,
                            quality: 0.8,
                        });
                        console.log(
                            `Imagen comprimida: ${Math.round(file.size / 1024)}KB → ${Math.round(processedFile.size / 1024)}KB`
                        );
                    }

                    // Subir a ImgBB
                    const uploadResult = await imageService.uploadImage(
                        processedFile,
                        {
                            name: `perfil_${Date.now()}`,
                        }
                    );

                    if (uploadResult.success) {
                        // Actualizar imagen con la URL de ImgBB
                        const imageUrl = uploadResult.url;

                        if (avatarEl) {
                            avatarEl.innerHTML = `<img src="${imageUrl}" alt="Foto de perfil" />`;
                        }

                        // Guardar directamente la foto de perfil en la API
                        await apiRequest(() =>
                            profileService.updateMyProfile({
                                urlFotoPerfil: uploadResult.url,
                            })
                        );

                        // Actualizar datos locales
                        if (!this.profileData)
                            this.profileData = { data: { perfil: {} } };
                        if (!this.profileData.data)
                            this.profileData.data = { perfil: {} };
                        if (!this.profileData.data.perfil)
                            this.profileData.data.perfil = {};

                        this.profileData.data.perfil.urlFotoPerfil =
                            uploadResult.url;

                        this.showNotification(
                            "Foto de perfil actualizada correctamente",
                            "success"
                        );

                        console.log("Imagen subida a ImgBB:", {
                            id: uploadResult.id,
                            url: uploadResult.url,
                            thumbnailUrl: uploadResult.thumbnailUrl,
                        });
                    } else {
                        throw new Error("Error en la subida a ImgBB");
                    }
                } catch (error) {
                    console.error("Error subiendo foto:", error);

                    let errorMessage = "Error al subir la foto de perfil";
                    if (error.message.includes("Tipo de archivo")) {
                        errorMessage =
                            "Solo se permiten imágenes JPEG, PNG o WebP";
                    } else if (error.message.includes("demasiado grande")) {
                        errorMessage =
                            "La imagen es demasiado grande (máximo 5MB)";
                    } else if (error.message.includes("píxeles")) {
                        errorMessage =
                            "La imagen debe ser de al menos 100x100 píxeles";
                    }

                    this.showNotification(errorMessage, "error");

                    // Revertir preview si falló la subida
                    this.loadProfileImage();
                } finally {
                    // Restaurar botón
                    const changeBtn =
                        document.getElementById("change-photo-btn");
                    if (changeBtn) {
                        changeBtn.innerHTML = `
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                <circle cx="12" cy="13" r="4"></circle>
                            </svg>
                        `;
                        changeBtn.disabled = false;
                    }

                    // Limpiar input para permitir cargar la misma imagen de nuevo
                    const photoInput = document.getElementById("photo-upload");
                    if (photoInput) {
                        photoInput.value = "";
                    }
                }
            }

            /**
