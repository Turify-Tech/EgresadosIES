---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Mi Perfil" hideAccederButton={true}>
    <div class="mi-perfil-container">
        <!-- Banner superior -->
        <div class="profile-banner">
            <img
                src="/images/Fondo Azul card.jpg"
                alt="Banner"
                class="banner-image"
                id="banner-image"
            />
        </div>

        <!-- Contenedor principal -->
        <div class="profile-content">
            <!-- Header con foto, nombre y botones -->
            <div class="profile-header">
                <div class="profile-left">
                    <!-- Avatar -->
                    <div class="profile-avatar-container">
                        <div class="profile-avatar" id="profile-avatar">
                            <svg
                                width="80"
                                height="80"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5">
                                <circle cx="12" cy="12" r="10"></circle>
                                <circle cx="12" cy="10" r="3"></circle>
                                <path
                                    d="M6.168 18.849A4 4 0 0 1 10 16h4a4 4 0 0 1 3.834 2.855"
                                ></path>
                            </svg>
                        </div>
                        <button
                            class="btn-cambiar-foto"
                            id="btn-cambiar-foto"
                            style="display: none;"
                            onclick="document.getElementById('input-foto-perfil').click()">
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2">
                                <path
                                    d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                                ></path>
                                <circle cx="12" cy="13" r="4"></circle>
                            </svg>
                        </button>
                        <input
                            type="file"
                            id="input-foto-perfil"
                            accept="image/*"
                            style="display: none;"
                            onchange="handleFotoChange(event)"
                        />
                    </div>
                    <!-- Nombre y carrera -->
                    <div class="profile-info">
                        <h1 class="profile-name" id="profile-name">
                            Cargando...
                        </h1>
                        <p class="profile-career" id="profile-career">
                            Cargando...
                        </p>
                    </div>
                </div>

                <!-- Botones de acción -->
                <div class="profile-actions">
                    <button
                        class="btn-action"
                        id="btn-editar"
                        onclick="toggleEditMode()">Editar Perfil</button
                    >
                    <button
                        class="btn-action"
                        onclick="window.location.href='/mis-publicaciones'"
                        >Mis Publicaciones</button
                    >
                    <button class="btn-action" onclick="descargarCV()"
                        >Descargar CV en PDF</button
                    >
                </div>
            </div>

            <!-- Datos personales -->
            <div class="datos-personales">
                <h2 class="section-title">Datos personales</h2>
                <div class="datos-card">
                    <div class="dato-row">
                        <span class="dato-label">Nombre:</span>
                        <span class="dato-value dato-display" id="dato-nombre"
                            >-</span
                        >
                        <input
                            type="text"
                            class="dato-input"
                            id="input-nombre"
                            style="display: none;"
                        />
                    </div>
                    <div class="dato-row">
                        <span class="dato-label">Apellido:</span>
                        <span class="dato-value dato-display" id="dato-apellido"
                            >-</span
                        >
                        <input
                            type="text"
                            class="dato-input"
                            id="input-apellido"
                            style="display: none;"
                        />
                    </div>
                    <div class="dato-row">
                        <span class="dato-label">DNI:</span>
                        <span class="dato-value" id="dato-dni">-</span>
                        <small class="dato-note">No se puede modificar</small>
                    </div>
                    <div class="dato-row">
                        <span class="dato-label">Correo:</span>
                        <span class="dato-value dato-display" id="dato-email"
                            >-</span
                        >
                        <input
                            type="email"
                            class="dato-input"
                            id="input-email"
                            style="display: none;"
                        />
                    </div>
                    <div class="dato-row">
                        <span class="dato-label">Teléfono:</span>
                        <span class="dato-value dato-display" id="dato-telefono"
                            >-</span
                        >
                        <input
                            type="tel"
                            class="dato-input"
                            id="input-telefono"
                            style="display: none;"
                        />
                    </div>
                    <div class="dato-row">
                        <span class="dato-label">Carrera:</span>
                        <span class="dato-value dato-display" id="dato-carrera"
                            >-</span
                        >
                        <select
                            class="dato-input"
                            id="input-carrera"
                            style="display: none;">
                            <option value="">Cargando carreras...</option>
                        </select>
                    </div>
                    <div class="dato-row">
                        <span class="dato-label">Año de egreso:</span>
                        <span class="dato-value dato-display" id="dato-anio"
                            >-</span
                        >
                        <input
                            type="number"
                            class="dato-input"
                            id="input-anio"
                            min="1990"
                            max="2030"
                            style="display: none;"
                        />
                    </div>
                    <div class="dato-row">
                        <span class="dato-label">Situación laboral:</span>
                        <span
                            class="dato-value dato-display"
                            id="dato-situacion">-</span
                        >
                        <select
                            class="dato-input"
                            id="input-situacion"
                            style="display: none;">
                            <option value="">Selecciona una opción</option>
                            <option value="Trabajando">Trabajando</option>
                            <option value="Freelance">Freelance</option>
                            <option value="Buscando empleo"
                                >Buscando empleo</option
                            >
                            <option value="Estudiando">Estudiando</option>
                            <option value="Estudiando y Trabajando"
                                >Estudiando y Trabajando</option
                            >
                        </select>
                    </div>

                    <!-- Botones de edición -->
                    <div
                        class="edit-actions"
                        id="edit-actions"
                        style="display: none;">
                        <button class="btn-cancelar" onclick="cancelarEdicion()"
                            >Cancelar</button
                        >
                        <button class="btn-guardar" onclick="guardarCambios()">
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2">
                                <path
                                    d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"
                                ></path>
                                <polyline points="17 21 17 13 7 13 7 21"
                                ></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>
                            Guardar cambios
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading overlay -->
        <div class="loading-overlay" id="loading-overlay">
            <div class="loading-spinner"></div>
            <p>Cargando perfil...</p>
        </div>

        <!-- Modal de recorte de imagen -->
        <div class="crop-modal" id="crop-modal" style="display: none;">
            <div class="crop-modal-content">
                <div class="crop-modal-header">
                    <h3>Ajustar foto de perfil</h3>
                    <button
                        class="btn-close-modal"
                        onclick="cerrarModalRecorte()">×</button
                    >
                </div>
                <div class="crop-container">
                    <img id="image-to-crop" src="" alt="Imagen para recortar" />
                </div>
                <div class="crop-modal-actions">
                    <button class="btn-cancelar" onclick="cerrarModalRecorte()"
                        >Cancelar</button
                    >
                    <button class="btn-guardar" onclick="aplicarRecorte()">
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Aplicar recorte
                    </button>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .mi-perfil-container {
        min-height: 100vh;
        background: transparent;
    }

    .profile-banner {
        width: 100%;
        height: 200px;
        overflow: hidden;
        position: relative;
    }

    .banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 3rem;
    }

    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-top: 2rem;
        margin-bottom: 1.5rem;
        gap: 2rem;
        position: relative;
        z-index: 10;
    }

    .profile-left {
        display: flex;
        align-items: flex-end;
        gap: 1.5rem;
        margin-left: 0;
    }

    .profile-avatar-container {
        position: relative;
    }

    .profile-avatar {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        overflow: hidden;
        border: 5px solid white;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 72px;
        color: #000;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        flex-shrink: 0;
        margin-top: -100px;
    }

    .profile-avatar svg {
        color: #666;
        width: 80px;
        height: 80px;
    }

    .profile-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .btn-cambiar-foto {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #5b7fdb;
        color: white;
        border: 3px solid white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
    }

    .btn-cambiar-foto:hover {
        background: #4a6bc9;
        transform: scale(1.1);
    }

    .profile-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: -0.5rem;
    }

    .profile-name {
        font-size: 2.5rem;
        font-weight: 700;
        color: #000;
        margin: 0;
    }

    .profile-career {
        font-size: 1.125rem;
        color: #666;
        margin: 0;
    }

    .profile-actions {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 160px;
        margin-top: 1rem;
    }

    .btn-action {
        background: #5b7fdb;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(91, 127, 219, 0.3);
    }

    .btn-action:hover {
        background: #4a6bc9;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(91, 127, 219, 0.3);
    }

    .datos-personales {
        margin-bottom: 3rem;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #000;
        margin-bottom: 1.5rem;
    }

    .datos-card {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .dato-row {
        display: flex;
        padding: 1rem 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .dato-row:last-child {
        border-bottom: none;
    }

    .dato-label {
        font-weight: 600;
        color: #666;
        min-width: 180px;
        flex-shrink: 0;
    }

    .dato-value {
        color: #333;
        flex: 1;
    }

    .dato-input {
        flex: 1;
        padding: 0.5rem;
        border: 2px solid #5b7fdb;
        border-radius: 6px;
        font-size: 1rem;
        font-family: inherit;
    }

    .dato-input:focus {
        outline: none;
        border-color: #4a6bc9;
    }

    .dato-note {
        font-size: 0.85rem;
        color: #999;
        font-style: italic;
        margin-left: 1rem;
    }

    .edit-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f0f0f0;
    }

    .btn-guardar {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #5b7fdb !important;
        color: white;
    }

    .btn-guardar:hover {
        background: #4a6bc9 !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(91, 127, 219, 0.3);
    }

    .btn-cancelar {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        background: #f0f0f0 !important;
        color: #666;
    }

    .btn-cancelar:hover {
        background: #e0e0e0 !important;
        color: #333;
    }

    .crop-modal {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .crop-modal-content {
        background: white;
        border-radius: 12px;
        width: 90%;
        max-width: 600px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }

    .crop-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid #f0f0f0;
    }

    .crop-modal-header h3 {
        margin: 0;
        font-size: 1.25rem;
        color: #333;
    }

    .btn-close-modal {
        background: none;
        border: none;
        font-size: 2rem;
        color: #999;
        cursor: pointer;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.3s ease;
    }

    .btn-close-modal:hover {
        background: #f0f0f0;
        color: #333;
    }

    .crop-container {
        padding: 1.5rem;
        max-height: 400px;
        overflow: hidden;
    }

    .crop-container img {
        max-width: 100%;
        display: block;
    }

    /* Hacer que el área de recorte se vea circular */
    :global(.cropper-view-box),
    :global(.cropper-face) {
        border-radius: 50%;
    }

    :global(.cropper-view-box) {
        box-shadow: 0 0 0 1px #39f;
        outline: 0;
    }

    .crop-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        padding: 1.5rem;
        border-top: 1px solid #f0f0f0;
    }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.95);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        gap: 1rem;
    }

    .loading-overlay.hidden {
        display: none;
    }

    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #f0f0f0;
        border-top-color: #5b7fdb;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (max-width: 968px) {
        .profile-header {
            flex-direction: column;
            align-items: flex-start;
            margin-top: -40px;
        }

        .profile-left {
            flex-direction: column;
            align-items: center;
            text-align: center;
            width: 100%;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
        }

        .profile-name {
            font-size: 2rem;
        }

        .profile-actions {
            width: 100%;
        }

        .dato-row {
            flex-direction: column;
            gap: 0.5rem;
        }

        .dato-label {
            min-width: auto;
        }
    }

    @media (max-width: 640px) {
        .profile-content {
            padding: 0 1rem;
        }

        .profile-name {
            font-size: 1.75rem;
        }

        .datos-card {
            padding: 1.5rem;
        }
    }
</style>

<script>
    // Declaraciones de tipos para TypeScript
    declare global {
        interface Window {
            perfilData: any;
            nuevaFotoPerfil: File | null;
            toggleEditMode: () => void;
            cancelarEdicion: () => void;
            guardarCambios: () => Promise<void>;
            handleFotoChange: (event: Event) => void;
        }
    }

    // Esperar a que el DOM esté listo
    document.addEventListener("DOMContentLoaded", async () => {
        await cargarCarreras();
        await cargarMiPerfil();
    });

    async function cargarCarreras() {
        try {
            const response = await fetch("http://localhost:3000/api/carreras");
            if (response.ok) {
                const result = await response.json();
                const carreras = result.data || [];

                const selectCarrera = document.getElementById(
                    "input-carrera",
                ) as HTMLSelectElement;
                if (selectCarrera) {
                    selectCarrera.innerHTML =
                        '<option value="">Selecciona una carrera</option>' +
                        carreras
                            .map(
                                (c: any) =>
                                    `<option value="${c.id}">${c.nombre}</option>`,
                            )
                            .join("");
                }
            }
        } catch (error) {
            console.error("Error cargando carreras:", error);
        }
    }

    async function cargarMiPerfil() {
        const loadingOverlay = document.getElementById("loading-overlay");

        try {
            // Obtener token - IMPORTANTE: el token se guarda como "auth_token"
            const token = localStorage.getItem("auth_token");
            const userData = localStorage.getItem("currentUser");

            console.log("=== DEBUG MI PERFIL ===");
            console.log(
                "Token encontrado:",
                token ? "Sí (" + token.substring(0, 30) + "...)" : "No",
            );
            console.log("UserData:", userData);

            if (!token) {
                console.error("❌ No hay token en localStorage");
                alert("No se encontró tu sesión. Por favor, inicia sesión.");
                setTimeout(() => {
                    window.location.href = "/acceso";
                }, 2000);
                return;
            }

            // Llamar a la API
            console.log("📡 Llamando a la API /api/perfil/mi-perfil...");
            const response = await fetch(
                "http://localhost:3000/api/perfil/mi-perfil",
                {
                    method: "GET",
                    headers: {
                        Authorization: `Bearer ${token}`,
                        "Content-Type": "application/json",
                    },
                },
            );

            console.log("📥 Respuesta de la API:", {
                status: response.status,
                statusText: response.statusText,
                ok: response.ok,
            });

            if (!response.ok) {
                const errorData = await response.json().catch(() => ({}));
                console.error("❌ Error de la API:", {
                    status: response.status,
                    error: errorData,
                });

                if (response.status === 401 || response.status === 403) {
                    showNotification(
                        "Tu sesión ha expirado. Por favor, inicia sesión nuevamente.",
                        "error",
                    );
                    localStorage.removeItem("auth_token");
                    localStorage.removeItem("currentUser");
                    setTimeout(() => {
                        window.location.href = "/acceso";
                    }, 2000);
                    return;
                }
                throw new Error(errorData.error || "Error al cargar el perfil");
            }

            const result = await response.json();
            console.log("✅ Datos del perfil recibidos:", result);

            if (!result.success || !result.data) {
                throw new Error("Respuesta inválida del servidor");
            }

            const perfil = result.data;

            // Actualizar información en la página
            actualizarInterfaz(perfil);
            console.log("✅ Interfaz actualizada correctamente");
        } catch (error) {
            console.error("❌ Error completo:", error);
            alert("Error al cargar tu perfil: " + error.message);
        } finally {
            if (loadingOverlay) {
                loadingOverlay.classList.add("hidden");
            }
        }
    }

    function actualizarInterfaz(perfil) {
        // Guardar datos globalmente para el modo edición
        window.perfilData = perfil;

        console.log("=== ACTUALIZAR INTERFAZ ===");
        console.log("Datos usuario:", perfil.usuario);
        console.log("Nombre:", perfil.usuario.nombre);
        console.log("Apellido:", perfil.usuario.apellido);
        console.log("Email:", perfil.usuario.email);

        // Avatar
        const avatarEl = document.getElementById("profile-avatar");
        if (perfil.perfil?.urlFotoPerfil && avatarEl) {
            const fotoUrl = perfil.perfil.urlFotoPerfil.startsWith("http")
                ? perfil.perfil.urlFotoPerfil
                : `http://localhost:3000${perfil.perfil.urlFotoPerfil}`;
            avatarEl.innerHTML = `<img style="width: 200px;" src="${fotoUrl}" alt="Foto de perfil" />`;
        }

        // Banner
        const bannerEl = document.getElementById(
            "banner-image",
        ) as HTMLImageElement;
        if (perfil.perfil?.urlBanner && bannerEl) {
            bannerEl.src = perfil.perfil.urlBanner;
        }

        // Nombre y carrera
        const nombreCompleto =
            `${perfil.usuario.nombre} ${perfil.usuario.apellido || ""}`.trim();
        const nombreEl = document.getElementById("profile-name");
        const carreraHeaderEl = document.getElementById("profile-career");

        if (nombreEl) nombreEl.textContent = nombreCompleto;
        if (carreraHeaderEl)
            carreraHeaderEl.textContent =
                perfil.carrera?.nombre || "Sin carrera asignada";

        // Datos personales
        const datoNombreEl = document.getElementById("dato-nombre");
        const datoApellidoEl = document.getElementById("dato-apellido");
        const datoDniEl = document.getElementById("dato-dni");
        const datoEmailEl = document.getElementById("dato-email");
        const datoTelefonoEl = document.getElementById("dato-telefono");
        const datoCarreraEl = document.getElementById("dato-carrera");
        const datoAnioEl = document.getElementById("dato-anio");
        const datoSituacionEl = document.getElementById("dato-situacion");

        if (datoNombreEl)
            datoNombreEl.textContent = perfil.usuario.nombre || "-";
        if (datoApellidoEl)
            datoApellidoEl.textContent = perfil.usuario.apellido || "-";
        if (datoDniEl) datoDniEl.textContent = perfil.usuario.dni || "-";
        if (datoEmailEl) datoEmailEl.textContent = perfil.usuario.email || "-";
        if (datoTelefonoEl)
            datoTelefonoEl.textContent =
                perfil.usuario.telefono || "No especificado";
        if (datoCarreraEl)
            datoCarreraEl.textContent = perfil.carrera?.nombre || "-";
        if (datoAnioEl) datoAnioEl.textContent = "2026"; // Puedes ajustar esto según tu lógica
        if (datoSituacionEl)
            datoSituacionEl.textContent =
                perfil.perfil?.situacionLaboral || "No especificada";
    }

    function toggleEditMode() {
        const btnEditar = document.getElementById("btn-editar");
        const editActions = document.getElementById("edit-actions");
        const btnCambiarFoto = document.getElementById("btn-cambiar-foto");

        // Mostrar/ocultar botones
        if (btnEditar) btnEditar.style.display = "none";
        if (editActions) editActions.style.display = "flex";
        if (btnCambiarFoto) btnCambiarFoto.style.display = "flex";

        // Convertir campos a inputs
        const perfil = window.perfilData;
        activarModoEdicion(perfil);
    }

    function activarModoEdicion(perfil) {
        // Nombre
        const datoNombre = document.getElementById("dato-nombre");
        const inputNombre = document.getElementById(
            "input-nombre",
        ) as HTMLInputElement;
        if (datoNombre && inputNombre) {
            datoNombre.style.display = "none";
            inputNombre.style.display = "block";
            inputNombre.value = perfil.usuario.nombre || "";
        }

        // Apellido
        const datoApellido = document.getElementById("dato-apellido");
        const inputApellido = document.getElementById(
            "input-apellido",
        ) as HTMLInputElement;
        if (datoApellido && inputApellido) {
            datoApellido.style.display = "none";
            inputApellido.style.display = "block";
            inputApellido.value = perfil.usuario.apellido || "";
        }

        // Email
        const datoEmail = document.getElementById("dato-email");
        const inputEmail = document.getElementById(
            "input-email",
        ) as HTMLInputElement;
        if (datoEmail && inputEmail) {
            datoEmail.style.display = "none";
            inputEmail.style.display = "block";
            inputEmail.value = perfil.usuario.email || "";
        }

        // Teléfono
        const datoTelefono = document.getElementById("dato-telefono");
        const inputTelefono = document.getElementById(
            "input-telefono",
        ) as HTMLInputElement;
        if (datoTelefono && inputTelefono) {
            datoTelefono.style.display = "none";
            inputTelefono.style.display = "block";
            inputTelefono.value = perfil.usuario.telefono || "";
        }

        // Situación laboral
        const datoSituacion = document.getElementById("dato-situacion");
        const inputSituacion = document.getElementById(
            "input-situacion",
        ) as HTMLSelectElement;
        if (datoSituacion && inputSituacion) {
            datoSituacion.style.display = "none";
            inputSituacion.style.display = "block";
            inputSituacion.value = perfil.perfil?.situacionLaboral || "";
        }

        // Carrera
        const datoCarrera = document.getElementById("dato-carrera");
        const inputCarrera = document.getElementById(
            "input-carrera",
        ) as HTMLSelectElement;
        if (datoCarrera && inputCarrera) {
            datoCarrera.style.display = "none";
            inputCarrera.style.display = "block";
            inputCarrera.value = perfil.carrera?.id?.toString() || "";
        }

        // Año de egreso
        const datoAnio = document.getElementById("dato-anio");
        const inputAnio = document.getElementById(
