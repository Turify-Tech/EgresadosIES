</style>

<script>
    // @ts-nocheck
    import { AdvancedSearchManagerSidebar } from "../../utils/advancedSearchSidebar.js";

    class PerfilesPageSidebar {
        constructor() {
            this.searchManager = null;
            this.init();
        }

        async init() {
            try {
                // Inicializar el gestor de búsqueda adaptado al nuevo layout
                this.searchManager = new AdvancedSearchManagerSidebar({
                    searchInputId: "search-input",
                    resultsContainerId: "perfiles-grid",
                    resultsCountId: "results-count",
                    enableAutoSearch: true,
                    enableUrlParams: true,
                    debounceTime: 500,
                });

                // Vincular eventos específicos del sidebar
                this.bindSidebarEvents();
                this.bindMobileEvents();
            } catch (error) {
                console.error("Error inicializando página de perfiles:", error);
                this.showError("Error al inicializar la página");
            }
        }

        bindSidebarEvents() {
            // NOTA: El botón de toggle filtros ya está manejado en AdvancedSearchManagerSidebar
            // No agregamos listener duplicado aquí para evitar conflictos

            // Limpiar todos los filtros
            const clearAllBtn = document.getElementById("clear-all-filters");
            if (clearAllBtn) {
                clearAllBtn.addEventListener("click", () => {
                    if (this.searchManager) {
                        this.searchManager.clear();
                    }
                    this.clearAllCheckboxes();
                });
            }

            // Checkboxes de situación laboral
            const situacionCheckboxes = document.querySelectorAll(
                'input[name="situacion"]'
            );
            situacionCheckboxes.forEach((checkbox) => {
                checkbox.addEventListener("change", () => {
                    this.handleSituacionChange();
                });
            });

            // Botón de reintentar
            const retryButton = document.getElementById("retry-button");
            if (retryButton) {
                retryButton.addEventListener("click", () => {
                    if (this.searchManager) {
                        this.searchManager.search();
                    }
                });
            }

            // Event delegation para botones de enviar mensaje
            document.addEventListener("click", (e) => {
                const btnMensaje = e.target.closest(".btn-enviar-mensaje");
                if (btnMensaje) {
                    e.preventDefault();
                    const userId = parseInt(btnMensaje.dataset.userId);
                    const userName = btnMensaje.dataset.userName;
                    
                    console.log("[PERFILES] Click en enviar mensaje:", { userId, userName });
                    
                    // Verificar si hay token válido antes de redirigir
                    // Intentar ambos nombres de token para compatibilidad
                    const token = localStorage.getItem("auth_token") || localStorage.getItem("token");
                    console.log("[PERFILES] Token encontrado:", !!token);
                    
                    if (!token) {
                        console.warn("[PERFILES] No hay token, redirigiendo al login primero");
                        // Guardar la intención para después del login
                        sessionStorage.setItem('redirectAfterLogin', '/mensajes');
                        sessionStorage.setItem('openConversationUserId', userId.toString());
                        sessionStorage.setItem('openConversationUserName', userName);
                        window.location.href = '/acceso';
                        return;
                    }
                    
                    // Verificar si el token está expirado
                    try {
                        const payload = JSON.parse(atob(token.split(".")[1]));
                        const now = Math.floor(Date.now() / 1000);
                        console.log("[PERFILES] Token exp:", payload.exp, "Now:", now, "Expiró:", payload.exp < now);
                        
                        if (payload.exp && payload.exp < now) {
                            console.warn("[PERFILES] Token expirado, redirigiendo al login");
                            localStorage.removeItem("token");
                            localStorage.removeItem("auth_token");
                            localStorage.removeItem("user");
                            localStorage.removeItem("user_data");
                            // Guardar la intención para después del login
                            sessionStorage.setItem('redirectAfterLogin', '/mensajes');
                            sessionStorage.setItem('openConversationUserId', userId.toString());
                            sessionStorage.setItem('openConversationUserName', userName);
                            window.location.href = '/acceso';
                            return;
                        }
                    } catch (err) {
                        console.error("[PERFILES] Error decodificando token:", err);
                        localStorage.removeItem("token");
                        localStorage.removeItem("auth_token");
                        localStorage.removeItem("user");
                        localStorage.removeItem("user_data");
                        sessionStorage.setItem('redirectAfterLogin', '/mensajes');
                        sessionStorage.setItem('openConversationUserId', userId.toString());
                        sessionStorage.setItem('openConversationUserName', userName);
                        window.location.href = '/acceso';
                        return;
                    }
                    
                    console.log("[PERFILES] Token válido, abriendo sidebar de mensajes");
                    
                    // Abrir el sidebar de mensajes con el usuario específico
                    if ((window as any).abrirChatConUsuario) {
                        (window as any).abrirChatConUsuario(userId, userName);
                    } else {
                        console.warn("[PERFILES] Función abrirChatConUsuario no disponible, redirigiendo a /mensajes");
                        sessionStorage.setItem('openConversationUserId', userId.toString());
                        sessionStorage.setItem('openConversationUserName', userName);
                        window.location.href = '/mensajes';
                    }
                }
            });
        }

        bindMobileEvents() {
            // Toggle sidebar en móvil (si se implementa)
            const toggleSidebar = () => {
                const sidebar = document.querySelector(".filters-sidebar");
                if (sidebar) {
                    sidebar.classList.toggle("open");
                }
            };

            // Cerrar sidebar al hacer clic fuera en móvil
            document.addEventListener("click", (e) => {
                const sidebar = document.querySelector(".filters-sidebar");
                const isMobile = window.innerWidth <= 768;

                if (isMobile && sidebar && !sidebar.contains(e.target)) {
                    sidebar.classList.remove("open");
                }
            });
        }

        handleSituacionChange() {
            const checkedBoxes = document.querySelectorAll(
                'input[name="situacion"]:checked'
            );
            const selectedSituaciones = Array.from(checkedBoxes).map(
                (cb) => cb.value
            );

            if (this.searchManager) {
                // Combinar múltiples situaciones laborales
                const situacionFilter = selectedSituaciones.join(",");
                this.searchManager.setFilter(
                    "situacionLaboral",
                    situacionFilter
                );
            }
        }

        clearAllCheckboxes() {
            const checkboxes = document.querySelectorAll(
                'input[name="situacion"]'
            );
            checkboxes.forEach((cb) => (cb.checked = false));
        }

        showError(message) {
            const errorContainer = document.getElementById("error-message");
            const errorText = document.getElementById("error-text");
            const loadingIndicator =
                document.getElementById("loading-indicator");

            if (loadingIndicator) {
                loadingIndicator.style.display = "none";
            }

            if (errorContainer) {
                errorContainer.style.display = "block";
            }

            if (errorText) {
                errorText.textContent = message;
            }
        }
    }

    // Inicializar cuando el DOM esté listo
    document.addEventListener("DOMContentLoaded", () => {
        new PerfilesPageSidebar();
    });
</script>
