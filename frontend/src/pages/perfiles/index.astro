---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BarraBusqueda from "../../components/busqueda/BarraBusqueda.astro";
---

<BaseLayout title="Perfiles de Egresados">
    <main class="perfiles-main">
        <!-- Layout con sidebar -->
        <div class="perfiles-layout">
            <!-- Contenido principal -->
            <div class="main-content">
                <!-- Título centrado -->
                <div class="page-title-container">
                    <h1 class="page-title">Perfiles</h1>
                </div>
                
                <!-- Header de resultados -->
                <div class="results-wrapper">
                    <div class="results-header">
                        <div class="header-left">
                            <div class="results-info">
                                <span id="results-count">Cargando...</span>
                            </div>
                        </div>
                        <div class="header-right">
                            <button
                                id="toggle-filters-btn"
                                class="toggle-filters-btn">
                                Filtros
                            </button>

                            <!-- Dropdown de filtros -->
                            <div class="filters-sidebar">
                                <div class="sidebar-header">
                                    <h2>Filtros</h2>
                                    <div class="header-actions">
                                        <button
                                            id="close-filters-mobile"
                                            class="close-filters-btn"
                                            aria-label="Cerrar filtros">
                                            ✕
                                        </button>
                                        <button
                                            id="clear-all-filters"
                                            class="clear-all-btn">
                                            Limpiar todo
                                        </button>
                                    </div>
                                </div>

                                <!-- Filtro de Carrera -->
                                <div class="filter-section">
                                    <label class="filter-label">Carrera</label>
                                    <div
                                        class="checkbox-group"
                                        id="carrera-filter-group">
                                        <label class="checkbox-item">
                                            <input
                                                type="checkbox"
                                                value=""
                                                name="carrera"
                                                id="todas-carreras"
                                                checked
                                            />
                                            <span class="checkmark"></span>
                                            Todas
                                        </label>
                                        <!-- Las carreras se llenan dinámicamente aquí -->
                                    </div>
                                </div>

                                <!-- Filtro de Situación Laboral -->
                                <div class="filter-section">
                                    <label
                                        class="filter-label"
                                        for="situacion-filter"
                                        >Situación laboral actual</label
                                    >
                                    <div class="checkbox-group">
                                        <label class="checkbox-item">
                                            <input
                                                type="checkbox"
                                                value="Trabajando"
                                                name="situacion"
                                            />
                                            <span class="checkmark"></span>
                                            Trabajando
                                        </label>
                                        <label class="checkbox-item">
                                            <input
                                                type="checkbox"
                                                value="Freelance"
                                                name="situacion"
                                            />
                                            <span class="checkmark"></span>
                                            Freelance
                                        </label>
                                        <label class="checkbox-item">
                                            <input
                                                type="checkbox"
                                                value="Buscando empleo"
                                                name="situacion"
                                            />
                                            <span class="checkmark"></span>
                                            Buscando empleo
                                        </label>
                                        <label class="checkbox-item">
                                            <input
                                                type="checkbox"
                                                value="Estudiando"
                                                name="situacion"
                                            />
                                            <span class="checkmark"></span>
                                            Estudiando
                                        </label>
                                        <label class="checkbox-item">
                                            <input
                                                type="checkbox"
                                                value="Estudiando y Trabajando"
                                                name="situacion"
                                            />
                                            <span class="checkmark"></span>
                                            Estudiando y Trabajando
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Estados de carga y error -->
                <div
                    id="loading-indicator"
                    class="loading-container"
                    style="display: none;">
                    <div class="loading-spinner"></div>
                    <p>Cargando perfiles...</p>
                </div>

                <div
                    id="error-message"
                    class="error-container"
                    style="display: none;">
                    <div class="error-content">
                        <h3>Error al cargar perfiles</h3>
                        <p id="error-text">
                            Ha ocurrido un error al cargar los perfiles.
                        </p>
                        <button id="retry-button" class="retry-button"
                            >Reintentar</button
                        >
                    </div>
                </div>

                <!-- Grid de perfiles -->
                <div id="perfiles-grid" class="perfiles-grid">
                    <!-- Los perfiles se cargan dinámicamente aquí -->
                </div>

                <!-- Paginación -->
                <div id="pagination-container" class="pagination-container" style="display: none;">
                    <button id="prev-page" class="pagination-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M15 18l-6-6 6-6"/>
                        </svg>
                        Anterior
                    </button>
                    
                    <span id="page-info" class="page-info">Página 1 de 1</span>
                    
                    <button id="next-page" class="pagination-btn">
                        Siguiente
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 18l6-6-6-6"/>
                        </svg>
                    </button>
                </div>

                <!-- Sin resultados -->
                <div id="no-results" class="no-results" style="display: none;">
                    <div class="no-results-content">
                        <svg
                            width="64"
                            height="64"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="m21 21-4.35-4.35"></path>
                        </svg>
                        <h3>No se encontraron perfiles</h3>
                        <p>No hay perfiles que coincidan con tu búsqueda.</p>
                    </div>
                </div>
            </div>

            <!-- Overlay para cerrar filtros en móvil -->
            <div id="sidebar-overlay" class="sidebar-overlay"></div>
        </div>
    </main>
</BaseLayout>

<style is:global>
    /* Variables */
    :root {
        --sidebar-width: 280px;
        --primary-color: #3b82f6;
        --secondary-color: #6366f1;
        --border-color: #e5e7eb;
        --text-primary: #1f2937;
        --text-secondary: #6b7280;
        --bg-gray: #f8fafc;
        --bg-light: #ffffff;
        --radius: 8px;
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1),
            0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    /* Layout principal */
    .perfiles-main {
        min-height: 100vh;
        background: transparent;
    }

    .perfiles-layout {
        display: flex;
        min-height: 100vh;
    }

    /* Sidebar de filtros - Dropdown desde el botón */
    .filters-sidebar {
        width: 300px;
        background: var(--bg-light);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        padding: 1.25rem;
        overflow-y: auto;
        position: absolute;
        max-height: 70vh;
        right: 0;
        top: calc(100% + 0.5rem);
        transform: translateY(-10px);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        z-index: 1000;
        box-shadow: var(--shadow-lg);
        pointer-events: none;
    }

    .filters-sidebar.show {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
        background: #fff;
        pointer-events: auto;
    }

    /* Overlay para pantallas móviles - Deshabilitado para dropdown */
    .sidebar-overlay {
        /* En desktop no se usa, solo se mantiene para compatibilidad */
        display: none;
    }

    .sidebar-overlay.show {
        /* En desktop no se muestra */
        display: none;
    }

    .sidebar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border-color);
    }

    .sidebar-header h2 {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .close-filters-btn {
        display: none; /* Oculto por defecto en desktop */
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background: var(--bg-gray);
        color: var(--text-secondary);
        font-size: 1.25rem;
        cursor: pointer;
        transition: all 0.2s;
        padding: 0;
        line-height: 1;
    }

    .close-filters-btn:hover {
        background-color: #e5e7eb;
        color: var(--text-primary);
    }

    .clear-all-btn {
        color: var(--primary-color);
        background: none;
        border: none;
        font-size: 0.8rem;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        transition: all 0.2s;
        font-weight: 500;
    }

    .clear-all-btn:hover {
        background-color: rgba(59, 130, 246, 0.1);
        color: var(--secondary-color);
    }

    /* Secciones de filtros */
    .filter-section {
        margin-bottom: 1.25rem;
    }

    .filter-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .filter-select,
    .filter-input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        font-size: 0.875rem;
        background: var(--bg-light);
        color: var(--text-primary);
        transition: all 0.2s;
    }

    .filter-select:focus,
    .filter-input:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .filter-input::placeholder {
        color: var(--text-secondary);
        font-size: 0.8rem;
    }

    /* Checkboxes personalizados */
    .checkbox-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        cursor: pointer;
        font-size: 0.8rem;
        color: var(--text-primary);
        padding: 0.2rem 0;
    }

    .checkbox-item input[type="checkbox"] {
        display: none;
    }

    .checkmark {
        width: 14px;
        height: 14px;
        border: 1.5px solid var(--border-color);
        border-radius: 3px;
        margin-right: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        background: var(--bg-light);
    }

    .checkbox-item input[type="checkbox"]:checked + .checkmark {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .checkbox-item input[type="checkbox"]:checked + .checkmark::after {
        content: "✓";
        color: white;
        font-size: 9px;
        font-weight: bold;
    }

    /* Contenido principal */
    .main-content {
        flex: 1;
        padding: 1.5rem 2rem;
        background: transparent;
        min-height: 100vh;
    }

    .main-content.with-sidebar {
        /* Ya no necesitamos margen porque el dropdown se superpone */
    }

    /* Contenedor de resultados centrado con las cards */
    .results-wrapper {
        max-width: 800px;
        margin: 0 auto;
        width: 100%;
    }

    .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
        position: relative;
    }

    .header-left {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .header-right {
        position: relative;
    }

    /* Botón de filtros */
    .toggle-filters-btn {
        padding: 0.5rem 1rem;
        background: white;
        color: var(--text-primary);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 80px;
        justify-content: center;
    }

    .toggle-filters-btn:hover {
        background: var(--bg-gray);
        border-color: var(--primary-color);
    }

    .toggle-filters-btn.active {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }

    /* Título de página centrado */
    .page-title-container {
        text-align: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border-color);
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        letter-spacing: -0.025em;
    }

    .results-info {
        color: var(--text-secondary);
        font-size: 0.875rem;
    }

    /* Grid de perfiles - Layout vertical centrado con ancho limitado */
    .perfiles-grid {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 0;
        max-width: 800px;
        margin: 0 auto;
        width: 100%;
    }

    /* Tarjetas de perfil - estilo exacto del diseño */
    .perfil-card {
        background: var(--bg-light);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        padding: 1.5rem;
        transition: all 0.2s;
        box-shadow: var(--shadow-sm);
        position: relative;
        width: 100%;
    }

    .perfil-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }

    .card-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
        position: relative;
    }

    .avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #f3f4f6;
        border: 3px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: var(--text-secondary);
        flex-shrink: 0;
        overflow: hidden;
    }

    .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
    }

    .avatar-icon {
        font-size: 2.5rem;
        color: #9ca3af;
    }

    .card-title {
        flex: 1;
        padding-top: 0.5rem;
    }

    .card-title h3 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 0.25rem 0;
        line-height: 1.3;
    }

    .card-subtitle {
        font-size: 1rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.4;
    }

    .card-actions {
        position: absolute;
        top: 0;
        right: 0;
    }

    .btn-ver-curriculum {
        padding: 0.75rem 1.5rem;
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: var(--radius);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s;
        text-transform: none;
    }

    .btn-ver-curriculum:hover {
        background-color: var(--secondary-color);
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
    }

    .card-details {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .detail-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .detail-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
        font-weight: 500;
        min-width: 140px;
        flex-shrink: 0;
    }

    .detail-value {
        font-size: 0.875rem;
        color: var(--text-primary);
        flex: 1;
    }

    /* Footer de la tarjeta */
    .card-footer {
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        justify-content: flex-end;
    }

    .btn-enviar-mensaje {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        background: #5284e0;
        color: white;
        border: none;
        border-radius: 25px;
        font-size: 0.875rem;
        font-weight: 600;
        font-family: 'Pontano Sans', sans-serif;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 2px 6px rgba(82, 132, 224, 0.2);
    }

    .btn-enviar-mensaje:hover {
        background: #4070d0;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(82, 132, 224, 0.3);
    }

    .btn-enviar-mensaje:active {
        transform: translateY(0);
    }

    .btn-enviar-mensaje svg {
        width: 18px;
        height: 18px;
    }

    /* Eliminar estilos no utilizados */
    .situacion-badge,
    .btn-ver-perfil {
        display: none;
    }

    /* Estados de carga */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        color: var(--text-secondary);
    }

    .loading-spinner {
        width: 2rem;
        height: 2rem;
        border: 2px solid var(--border-color);
        border-top: 2px solid var(--primary-color);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 1rem;
    }

    @keyframes spin {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }

    .error-container {
        display: flex;
        justify-content: center;
        padding: 4rem 2rem;
    }

    .error-content {
        text-align: center;
        max-width: 400px;
    }

    .retry-button {
        padding: 0.5rem 1rem;
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: var(--radius);
        cursor: pointer;
        margin-top: 1rem;
    }

    .no-results {
        display: flex;
        justify-content: center;
        padding: 4rem 2rem;
    }

    .no-results-content {
        text-align: center;
        color: var(--text-secondary);
    }

    .no-results-content svg {
        stroke: var(--text-secondary);
        margin-bottom: 1rem;
    }

    /* Paginación */
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.5rem;
        padding: 2rem 0;
        margin-top: 2rem;
    }

    .pagination-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        background: white;
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-primary);
        cursor: pointer;
        transition: all 0.2s;
    }

    .pagination-btn:hover:not(:disabled) {
        background-color: var(--bg-gray);
        border-color: var(--primary-color);
        color: var(--primary-color);
    }

    .pagination-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .pagination-btn svg {
        flex-shrink: 0;
    }

    .page-info {
        font-size: 0.875rem;
        color: var(--text-secondary);
        font-weight: 500;
        padding: 0 1rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .filters-sidebar {
            position: fixed;
            left: -100%;
            transition: left 0.3s ease;
            z-index: 1000;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
        }

        .filters-sidebar.open {
            left: 0;
        }

        .main-content {
            margin-left: 0;
        }

        .perfiles-grid {
            grid-template-columns: 1fr;
        }

        .results-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .pagination-container {
            gap: 1rem;
        }

        .pagination-btn {
            padding: 0.5rem 0.875rem;
            font-size: 0.8rem;
        }

        .page-info {
            font-size: 0.8rem;
            padding: 0 0.5rem;
        }
    }

    /* Estilos responsivos */
    @media (max-width: 768px) {
        .close-filters-btn {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .filters-sidebar {
            position: fixed;
            right: auto;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%) scale(0.95);
            width: calc(100vw - 2rem);
            max-width: 400px;
            max-height: 80vh;
            border-radius: 12px;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 1001; /* Mayor que el overlay */
        }

        .filters-sidebar.show {
            transform: translate(-50%, -50%) scale(1);
            opacity: 1;
            visibility: visible;
        }

        /* Overlay para cerrar en móvil */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .sidebar-overlay.show {
            display: block;
            opacity: 1;
        }

        .page-title {
            font-size: 2rem;
        }

        .results-wrapper {
            padding: 0 1rem;
        }

        .results-header {
            flex-direction: row;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }

        .toggle-filters-btn {
            font-size: 0.8rem;
            padding: 0.4rem 0.8rem;
        }

        .perfiles-grid {
            gap: 1.25rem;
        }

        .card-header {
            flex-wrap: wrap;
            gap: 1rem;
        }

        .card-actions {
            position: static;
            width: 100%;
            margin-top: 0.75rem;
        }

        .btn-ver-curriculum {
            width: 100%;
            text-align: center;
            justify-content: center;
            display: flex;
        }
    }

    @media (max-width: 480px) {
        .main-content {
            padding: 1rem 0.5rem;
        }

        .page-title-container {
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            padding: 0 1rem;
        }

        .page-title {
            font-size: 1.75rem;
        }

        .results-wrapper {
            padding: 0 0.5rem;
            margin-bottom: 0.5rem;
        }

        .results-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
            padding: 0 0.5rem;
        }

        .header-right {
            align-self: flex-start;
            width: 100%;
        }

        .toggle-filters-btn {
            width: 100%;
            justify-content: center;
        }

