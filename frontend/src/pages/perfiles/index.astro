---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BarraBusqueda from "../../components/busqueda/BarraBusqueda.astro";
---

<BaseLayout title="Perfiles de Egresados">
    <main class="perfiles-main">
        <!-- Layout con sidebar -->
        <div class="perfiles-layout">
            <!-- Contenido principal -->
            <div class="main-content">
                <!-- Header de resultados -->
                <div class="results-header">
                    <div class="header-left">
                        <h1>Perfiles</h1>
                        <div class="results-info">
                            <span id="results-count">Cargando...</span>
                        </div>
                    </div>
                    <div class="header-right">
                        <button
                            id="toggle-filters-btn"
                            class="toggle-filters-btn">
                            Filtros
                        </button>

                        <!-- Dropdown de filtros -->
                        <div class="filters-sidebar">
                            <div class="sidebar-header">
                                <h2>Filtros</h2>
                                <button
                                    id="clear-all-filters"
                                    class="clear-all-btn">
                                    Limpiar todo
                                </button>
                            </div>

                            <!-- Filtro de Carrera -->
                            <div class="filter-section">
                                <label class="filter-label">Carrera</label>
                                <div
                                    class="checkbox-group"
                                    id="carrera-filter-group">
                                    <label class="checkbox-item">
                                        <input
                                            type="checkbox"
                                            value=""
                                            name="carrera"
                                            id="todas-carreras"
                                            checked
                                        />
                                        <span class="checkmark"></span>
                                        Todas
                                    </label>
                                    <!-- Las carreras se llenan dinámicamente aquí -->
                                </div>
                            </div>

                            <!-- Filtro de Situación Laboral -->
                            <div class="filter-section">
                                <label
                                    class="filter-label"
                                    for="situacion-filter"
                                    >Situación laboral actual</label
                                >
                                <div class="checkbox-group">
                                    <label class="checkbox-item">
                                        <input
                                            type="checkbox"
                                            value="Empleado"
                                            name="situacion"
                                        />
                                        <span class="checkmark"></span>
                                        Empleado
                                    </label>
                                    <label class="checkbox-item">
                                        <input
                                            type="checkbox"
                                            value="Desempleado"
                                            name="situacion"
                                        />
                                        <span class="checkmark"></span>
                                        Desempleado
                                    </label>
                                    <label class="checkbox-item">
                                        <input
                                            type="checkbox"
                                            value="Estudiando"
                                            name="situacion"
                                        />
                                        <span class="checkmark"></span>
                                        Estudiando
                                    </label>
                                    <label class="checkbox-item">
                                        <input
                                            type="checkbox"
                                            value="Emprendedor"
                                            name="situacion"
                                        />
                                        <span class="checkmark"></span>
                                        Emprendedor
                                    </label>
                                    <label class="checkbox-item">
                                        <input
                                            type="checkbox"
                                            value="Freelancer"
                                            name="situacion"
                                        />
                                        <span class="checkmark"></span>
                                        Freelancer
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Estados de carga y error -->
                <div
                    id="loading-indicator"
                    class="loading-container"
                    style="display: none;">
                    <div class="loading-spinner"></div>
                    <p>Cargando perfiles...</p>
                </div>

                <div
                    id="error-message"
                    class="error-container"
                    style="display: none;">
                    <div class="error-content">
                        <h3>Error al cargar perfiles</h3>
                        <p id="error-text">
                            Ha ocurrido un error al cargar los perfiles.
                        </p>
                        <button id="retry-button" class="retry-button"
                            >Reintentar</button
                        >
                    </div>
                </div>

                <!-- Grid de perfiles -->
                <div id="perfiles-grid" class="perfiles-grid">
                    <!-- Los perfiles se cargan dinámicamente aquí -->
                </div>

                <!-- Sin resultados -->
                <div id="no-results" class="no-results" style="display: none;">
                    <div class="no-results-content">
                        <svg
                            width="64"
                            height="64"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="m21 21-4.35-4.35"></path>
                        </svg>
                        <h3>No se encontraron perfiles</h3>
                        <p>No hay perfiles que coincidan con tu búsqueda.</p>
                    </div>
                </div>
            </div>

            <!-- Overlay para cerrar filtros en móvil -->
            <div id="sidebar-overlay" class="sidebar-overlay"></div>
        </div>
    </main>
</BaseLayout>

<style is:global>
    /* Variables */
    :root {
        --sidebar-width: 280px;
        --primary-color: #3b82f6;
        --secondary-color: #6366f1;
        --border-color: #e5e7eb;
        --text-primary: #1f2937;
        --text-secondary: #6b7280;
        --bg-gray: #f8fafc;
        --bg-light: #ffffff;
        --radius: 8px;
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1),
            0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    /* Layout principal */
    .perfiles-main {
        min-height: 100vh;
        background: white;
    }

    .perfiles-layout {
        display: flex;
        min-height: 100vh;
    }

    /* Sidebar de filtros - Dropdown desde el botón */
    .filters-sidebar {
        width: 300px;
        background: var(--bg-light);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        padding: 1.25rem;
        overflow-y: auto;
        position: absolute;
        max-height: 70vh;
        right: 0;
        top: calc(100% + 0.5rem);
        transform: translateY(-10px);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        z-index: 100;
        box-shadow: var(--shadow-lg);
    }

    .filters-sidebar.show {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
        background: #fff;
    }

    /* Overlay para pantallas móviles - Simplificado para dropdown */
    .sidebar-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: transparent;
        z-index: 99;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .sidebar-overlay.show {
        opacity: 1;
        visibility: visible;
    }

    .sidebar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border-color);
    }

    .sidebar-header h2 {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .clear-all-btn {
        color: var(--primary-color);
        background: none;
        border: none;
        font-size: 0.8rem;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        transition: all 0.2s;
        font-weight: 500;
    }

    .clear-all-btn:hover {
        background-color: rgba(59, 130, 246, 0.1);
        color: var(--secondary-color);
    }

    /* Secciones de filtros */
    .filter-section {
        margin-bottom: 1.25rem;
    }

    .filter-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .filter-select,
    .filter-input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        font-size: 0.875rem;
        background: var(--bg-light);
        color: var(--text-primary);
        transition: all 0.2s;
    }

    .filter-select:focus,
    .filter-input:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .filter-input::placeholder {
        color: var(--text-secondary);
        font-size: 0.8rem;
    }

    /* Checkboxes personalizados */
    .checkbox-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        cursor: pointer;
        font-size: 0.8rem;
        color: var(--text-primary);
        padding: 0.2rem 0;
    }

    .checkbox-item input[type="checkbox"] {
        display: none;
    }

    .checkmark {
        width: 14px;
        height: 14px;
        border: 1.5px solid var(--border-color);
        border-radius: 3px;
        margin-right: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        background: var(--bg-light);
    }

    .checkbox-item input[type="checkbox"]:checked + .checkmark {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .checkbox-item input[type="checkbox"]:checked + .checkmark::after {
        content: "✓";
        color: white;
        font-size: 9px;
        font-weight: bold;
    }

    /* Contenido principal */
    .main-content {
        flex: 1;
        padding: 1.5rem 2rem;
        background: var(--bg-gray);
        min-height: 100vh;
    }

    .main-content.with-sidebar {
        /* Ya no necesitamos margen porque el dropdown se superpone */
    }

    .results-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        position: relative;
    }

    .header-left {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .header-right {
        position: relative;
    }

    /* Botón de filtros */
    .toggle-filters-btn {
        padding: 0.5rem 1rem;
        background: white;
        color: var(--text-primary);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 80px;
        justify-content: center;
    }

    .toggle-filters-btn:hover {
        background: var(--bg-gray);
        border-color: var(--primary-color);
    }

    .toggle-filters-btn.active {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }

    .results-header h1 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .results-info {
        color: var(--text-secondary);
        font-size: 0.875rem;
    }

    /* Grid de perfiles - Layout vertical de ancho completo */
    .perfiles-grid {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 0.5rem 0;
        max-width: 100%;
    }

    /* Tarjetas de perfil - estilo exacto del diseño */
    .perfil-card {
        background: var(--bg-light);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        padding: 1.5rem;
        transition: all 0.2s;
        box-shadow: var(--shadow-sm);
        position: relative;
        width: 100%;
    }

    .perfil-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }

    .card-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
        position: relative;
    }

    .avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #f3f4f6;
        border: 3px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: var(--text-secondary);
        flex-shrink: 0;
        overflow: hidden;
    }

    .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
    }

    .avatar-icon {
        font-size: 2.5rem;
        color: #9ca3af;
    }

    .card-title {
        flex: 1;
        padding-top: 0.5rem;
    }

    .card-title h3 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 0.25rem 0;
        line-height: 1.3;
    }

    .card-subtitle {
        font-size: 1rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.4;
    }

    .card-actions {
        position: absolute;
        top: 0;
        right: 0;
    }

    .btn-ver-curriculum {
        padding: 0.75rem 1.5rem;
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: var(--radius);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s;
        text-transform: none;
    }

    .btn-ver-curriculum:hover {
        background-color: var(--secondary-color);
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
    }

    .card-details {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .detail-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .detail-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
        font-weight: 500;
        min-width: 140px;
        flex-shrink: 0;
    }

    .detail-value {
        font-size: 0.875rem;
        color: var(--text-primary);
        flex: 1;
    }

    /* Eliminar estilos no utilizados */
    .situacion-badge,
    .btn-ver-perfil {
        display: none;
    }

    /* Estados de carga */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        color: var(--text-secondary);
    }

    .loading-spinner {
        width: 2rem;
        height: 2rem;
        border: 2px solid var(--border-color);
        border-top: 2px solid var(--primary-color);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 1rem;
    }

    @keyframes spin {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }

    .error-container {
        display: flex;
        justify-content: center;
        padding: 4rem 2rem;
    }

    .error-content {
        text-align: center;
        max-width: 400px;
    }

    .retry-button {
        padding: 0.5rem 1rem;
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: var(--radius);
        cursor: pointer;
        margin-top: 1rem;
    }

    .no-results {
        display: flex;
        justify-content: center;
        padding: 4rem 2rem;
    }

    .no-results-content {
        text-align: center;
        color: var(--text-secondary);
    }

    .no-results-content svg {
        stroke: var(--text-secondary);
        margin-bottom: 1rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .filters-sidebar {
            position: fixed;
            left: -100%;
            transition: left 0.3s ease;
            z-index: 1000;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
        }

        .filters-sidebar.open {
            left: 0;
        }

        .main-content {
            margin-left: 0;
        }

        .perfiles-grid {
            grid-template-columns: 1fr;
        }

        .results-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
    }

    /* Estilos responsivos */
    @media (max-width: 768px) {
        .filters-sidebar {
            width: calc(100vw - 2rem);
            max-width: 320px;
            right: 1rem;
        }

        .results-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .header-right {
            align-self: flex-end;
        }

        .toggle-filters-btn {
            font-size: 0.8rem;
            padding: 0.4rem 0.8rem;
        }
    }

    @media (max-width: 480px) {
        .main-content {
            padding: 1rem;
        }

        .filters-sidebar {
            padding: 1rem;
            right: 0.5rem;
            width: calc(100vw - 1rem);
        }

        .perfil-card {
            padding: 1rem;
        }
    }
</style>

<script>
    // @ts-nocheck
    import { AdvancedSearchManagerSidebar } from "../../utils/advancedSearchSidebar.js";

    class PerfilesPageSidebar {
        constructor() {
            console.log("PerfilesPageSidebar constructor llamado");
            this.searchManager = null;
            this.init();
        }

        async init() {
            console.log("PerfilesPageSidebar.init() llamado");
            try {
                // Inicializar el gestor de búsqueda adaptado al nuevo layout
                this.searchManager = new AdvancedSearchManagerSidebar({
                    searchInputId: "search-input",
                    resultsContainerId: "perfiles-grid",
                    resultsCountId: "results-count",
                    enableAutoSearch: true,
                    enableUrlParams: true,
                    debounceTime: 500,
                });

                console.log("searchManager creado:", this.searchManager);

                // Vincular eventos específicos del sidebar
                this.bindSidebarEvents();
                this.bindMobileEvents();
            } catch (error) {
                console.error("Error inicializando página de perfiles:", error);
                this.showError("Error al inicializar la página");
            }
        }

        bindSidebarEvents() {
            console.log("bindSidebarEvents llamado");

            // Event listener para el botón de mostrar/ocultar filtros
            const toggleFiltersBtn =
                document.getElementById("toggle-filters-btn");
            console.log("Botón encontrado:", toggleFiltersBtn);

            if (toggleFiltersBtn) {
                toggleFiltersBtn.addEventListener("click", () => {
                    console.log("Botón filtros clickeado");
                    if (
                        this.searchManager &&
                        this.searchManager.toggleFilters
                    ) {
                        this.searchManager.toggleFilters();
                    } else {
                        console.error(
                            "searchManager o toggleFilters no disponible"
                        );
                    }
                });
                console.log("Event listener agregado al botón");
            } else {
                console.error("No se encontró el botón toggle-filters-btn");
            }

            // Limpiar todos los filtros
            const clearAllBtn = document.getElementById("clear-all-filters");
            if (clearAllBtn) {
                clearAllBtn.addEventListener("click", () => {
                    if (this.searchManager) {
                        this.searchManager.clear();
                    }
                    this.clearAllCheckboxes();
                });
            }

            // Checkboxes de situación laboral
            const situacionCheckboxes = document.querySelectorAll(
                'input[name="situacion"]'
            );
            situacionCheckboxes.forEach((checkbox) => {
                checkbox.addEventListener("change", () => {
                    this.handleSituacionChange();
                });
            });

            // Botón de reintentar
            const retryButton = document.getElementById("retry-button");
            if (retryButton) {
                retryButton.addEventListener("click", () => {
                    if (this.searchManager) {
                        this.searchManager.search();
                    }
                });
            }
        }

        bindMobileEvents() {
            // Toggle sidebar en móvil (si se implementa)
            const toggleSidebar = () => {
                const sidebar = document.querySelector(".filters-sidebar");
                if (sidebar) {
                    sidebar.classList.toggle("open");
                }
            };

            // Cerrar sidebar al hacer clic fuera en móvil
            document.addEventListener("click", (e) => {
                const sidebar = document.querySelector(".filters-sidebar");
                const isMobile = window.innerWidth <= 768;

                if (isMobile && sidebar && !sidebar.contains(e.target)) {
                    sidebar.classList.remove("open");
                }
            });
        }

        handleSituacionChange() {
            const checkedBoxes = document.querySelectorAll(
                'input[name="situacion"]:checked'
            );
            const selectedSituaciones = Array.from(checkedBoxes).map(
                (cb) => cb.value
            );

            if (this.searchManager) {
                // Combinar múltiples situaciones laborales
                const situacionFilter = selectedSituaciones.join(",");
                this.searchManager.setFilter(
                    "situacionLaboral",
                    situacionFilter
                );
            }
        }

        clearAllCheckboxes() {
            const checkboxes = document.querySelectorAll(
                'input[name="situacion"]'
            );
            checkboxes.forEach((cb) => (cb.checked = false));
        }

        showError(message) {
            const errorContainer = document.getElementById("error-message");
            const errorText = document.getElementById("error-text");
            const loadingIndicator =
                document.getElementById("loading-indicator");

            if (loadingIndicator) {
                loadingIndicator.style.display = "none";
            }

            if (errorContainer) {
                errorContainer.style.display = "block";
            }

            if (errorText) {
                errorText.textContent = message;
            }
        }
    }

    // Inicializar cuando el DOM esté listo
    document.addEventListener("DOMContentLoaded", () => {
        console.log("DOM cargado, inicializando PerfilesPageSidebar");

        // Test básico del botón
        const testBtn = document.getElementById("toggle-filters-btn");
        console.log("Test - botón encontrado:", testBtn);

        if (testBtn) {
            testBtn.addEventListener("click", () => {
                console.log("TEST: Botón clickeado directamente!");
                const sidebar = document.querySelector(".filters-sidebar");
                console.log("TEST: Sidebar encontrada:", sidebar);
                if (sidebar) {
                    sidebar.classList.toggle("show");
                    console.log("TEST: Clase 'show' toggled");
                }
            });
        }

        const instance = new PerfilesPageSidebar();
        console.log("PerfilesPageSidebar creado:", instance);
    });
</script>
